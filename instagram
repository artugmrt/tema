                      <span>{testResult.message}</span>
                    </div>
                    <span className="text-teal-300 font-bold">⏱ {testResult.latencyMs}ms</span>
                  </div>

                  <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px] pt-1">
                    <div className="p-2 rounded-xl bg-void-900 border border-void-800">
