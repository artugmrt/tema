                  </button>
                  <button
                    type="button"
                    onClick={() => handleRegenerateFingerprint('iOS')}
                    className="px-2 py-1 rounded-lg bg-void-950 border border-void-800 text-[11px] font-mono text-void-300 hover:text-gold-400 hover:border-gold-400/40 cursor-pointer"
                  >
                    📱 iOS
                  </button>
