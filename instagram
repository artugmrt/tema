Markdown: ${counts.md} dosya
SQL: ${counts.sql} dosya
Shell Script: ${counts.sh} dosya
JavaScript: ${counts.js} dosya
────────────────────────────────────────────────────────────────
`;

const fullDump = header + body + footer;

// Write output files
const outTxt = path.join(rootDir, 'INSTAPLANNER_FULL_CODEBASE_DUMP.txt');
fs.writeFileSync(outTxt, fullDump, 'utf-8');

console.log(`✅ [DUMP OLUŞTURULDU]`);
console.log(`   Dosya Yolu: ${outTxt}`);
console.log(`   Toplam Dosya: ${relPaths.length}`);
console.log(`   Toplam Satır: ${totalLines}`);
console.log(`   Boyut: ${(Buffer.byteLength(fullDump, 'utf-8') / 1024 / 1024).toFixed(2)} MB`);

// Export metadata summary for stdout
const summaryObj = {
  totalFiles: relPaths.length,
  totalLines,
  counts,
  relPaths
};
fs.writeFileSync(path.join(rootDir, 'scripts', '.dump_summary.json'), JSON.stringify(summaryObj, null, 2), 'utf-8');

// Clean up existing INSTAPLANNER_DUMP_PART_*.txt files in rootDir
const existingEntries = fs.readdirSync(rootDir);
for (const entry of existingEntries) {
  if (entry.startsWith('INSTAPLANNER_DUMP_PART_') && entry.endsWith('.txt')) {
    try {
      fs.unlinkSync(path.join(rootDir, entry));
    } catch (_) {}
  }
}

// Generate 10 Balanced Codebase Dump Parts using Dynamic Programming
const n = fileContents.length;
const k = 10;
const fileBytes = fileContents.map(f => Buffer.byteLength(f.content, 'utf-8'));
const totalByteCount = fileBytes.reduce((acc, b) => acc + b, 0);
const target = totalByteCount / k;

const prefix = [0];
for (let i = 0; i < n; i++) prefix.push(prefix[i] + fileBytes[i]);

function cost(i, j) {
  const sum = prefix[j] - prefix[i];
  return Math.pow(sum - target, 2);
}

const dp = Array.from({ length: k + 1 }, () => Array(n + 1).fill(Infinity));
const parent = Array.from({ length: k + 1 }, () => Array(n + 1).fill(-1));
dp[0][0] = 0;

for (let p = 1; p <= k; p++) {
  for (let i = p; i <= n; i++) {
    for (let j = p - 1; j < i; j++) {
      if (dp[p - 1][j] !== Infinity) {
        const c = dp[p - 1][j] + cost(j, i);
        if (c < dp[p][i]) {
          dp[p][i] = c;
          parent[p][i] = j;
        }
      }
    }
  }
}

const splitPoints = [n];
let curr = n;
for (let p = k; p >= 1; p--) {
  const prev = parent[p][curr];
  splitPoints.unshift(prev);
  curr = prev;
}

console.log('\n📦 [10 PARÇALIK DÖKÜM OLUŞTURULUYOR...]');

const partitionSummary = [];
for (let p = 1; p <= k; p++) {
  const start = splitPoints[p - 1];
  const end = splitPoints[p];
  const partFiles = fileContents.slice(start, end);
  const partLines = partFiles.reduce((acc, f) => acc + f.lines, 0);

  let partBody = '';
  for (const f of partFiles) {
    partBody += `\n=== DOSYA: ${f.path} ===\n${f.content}\n`;
