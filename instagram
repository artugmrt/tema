for (let i = 0; i < allFilePaths.length; i++) {
  const filePath = allFilePaths[i];
  const rel = relPaths[i];
  const ext = path.extname(filePath).toLowerCase();

  if (ext === '.ts' || ext === '.tsx') counts.ts_tsx++;
  else if (ext === '.css') counts.css++;
  else if (ext === '.json') counts.json++;
  else if (ext === '.md') counts.md++;
  else if (ext === '.sql') counts.sql++;
  else if (ext === '.sh') counts.sh++;
  else if (ext === '.js') counts.js++;

  let content = '';
  try {
    content = fs.readFileSync(filePath, 'utf-8');
  } catch (e) {
    content = `[HATA: Dosya okunamadı - ${e.message}]`;
  }

  const lines = content === '' ? 0 : content.split('\n').length;
  totalLines += lines;

  fileContents.push({
    path: rel,
    lines,
    content: content === '' ? '(BOŞ DOSYA)' : content
  });
}

// Build Header
const header = `════════════════════════════════════════════════════════════════
