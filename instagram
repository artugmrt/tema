import React from 'react';
import { Sparkles, Info } from '@animated-color-icons/lucide-react';
import { useNavigation } from '../../context/NavigationContext';

export const BestTimeSlotHeatmap: React.FC = () => {
  const { openCreatePost } = useNavigation();

  const days = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cts', 'Paz'];
  const hours = [9, 11, 13, 15, 17, 18, 19, 20, 21, 22];

  // Simulated engagement intensity score (0 - 100)
  const getIntensity = (dayIdx: number, hour: number): number => {
    // Peak hours: 18:00 - 21:00 on Fri, Sat, Sun, Wed
    if ((hour === 18 || hour === 19 || hour === 20 || hour === 21) && (dayIdx === 4 || dayIdx === 5 || dayIdx === 6 || dayIdx === 2)) {
      return Math.floor(Math.random() * 8 + 92); // 92-100%
    }
    if (hour >= 18 && hour <= 21) {
      return Math.floor(Math.random() * 10 + 78);
    }
    if (hour >= 12 && hour <= 14) {
      return Math.floor(Math.random() * 15 + 60);
    }
    return Math.floor(Math.random() * 20 + 20);
  };

  return (
    <div className="p-4 rounded-2xl bg-void-900 border border-void-750/80 mb-4">
      <div className="flex items-center justify-between mb-3">
        <div className="flex items-center gap-2">
          <Sparkles className="w-4 h-4 text-teal-400" />
          <h3 className="text-xs font-bold font-unbounded text-white">
