-- 5. SECURE ROW LEVEL SECURITY (RLS) & SECURITY DEFINER FUNCTIONS (PRODUCTION HARDENED)

CREATE OR REPLACE FUNCTION public.get_auth_user_id()
RETURNS VARCHAR AS $$
    SELECT nullif(current_setting('request.jwt.claims', true)::json->>'sub', '')::varchar;
$$ LANGUAGE sql STABLE;

CREATE OR REPLACE FUNCTION public.has_account_access(account_id UUID)
RETURNS BOOLEAN AS $$
    SELECT EXISTS (
        SELECT 1 FROM public.team_members tm
        WHERE tm.account_id = $1 
        AND tm.user_id = public.get_auth_user_id()
        AND tm.is_active = true
    );
$$ LANGUAGE sql STABLE SECURITY DEFINER;

CREATE OR REPLACE FUNCTION public.get_user_role(account_id UUID)
RETURNS VARCHAR AS $$
    SELECT COALESCE(
      (SELECT tm.role FROM public.team_members tm
       WHERE tm.account_id = $1 
       AND tm.user_id = public.get_auth_user_id()
       AND tm.is_active = true
       LIMIT 1),
      'viewer'
    );
$$ LANGUAGE sql STABLE SECURITY DEFINER;

