interface WeeklyCalendarProps {
  posts: Post[];
}

export const WeeklyCalendar: React.FC<WeeklyCalendarProps> = ({ posts }) => {
  const { openCreatePost } = useNavigation();
  const [showHeatmap, setShowHeatmap] = useState(false);

  // Weekly days: 1 - 7 September 2026
  const weekDays = [
    { name: 'Pzt', fullDate: '1 Eyl', date: 1, bestHour: '19:30' },
    { name: 'Sal', fullDate: '2 Eyl', date: 2, bestHour: '18:30' },
    { name: 'Çar', fullDate: '3 Eyl', date: 3, bestHour: '19:15' },
    { name: 'Per', fullDate: '4 Eyl', date: 4, bestHour: '20:00' },
    { name: 'Cum', fullDate: '5 Eyl', date: 5, bestHour: '21:00' },
    { name: 'Cts', fullDate: '6 Eyl', date: 6, bestHour: '14:00' },
    { name: 'Paz', fullDate: '7 Eyl', date: 7, bestHour: '19:45' },
  ];

  return (
    <div className="flex flex-col flex-1 overflow-x-auto space-y-3">
      {/* Top Toggle Bar */}
      <div className="flex items-center justify-between px-1">
        <div className="flex items-center gap-2">
          <span className="text-xs text-void-300 font-mono">
            Haftalık Görünüm (1 - 7 Eylül 2026)
          </span>
        </div>
        <button
          onClick={() => setShowHeatmap(!showHeatmap)}
          className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-mono font-semibold transition-all cursor-pointer ${
            showHeatmap
              ? 'bg-teal-500/20 text-teal-300 border border-teal-500/40 shadow-teal-glow'
              : 'bg-void-900 hover:bg-void-850 text-void-300 border border-void-750'
          }`}
        >
          <Flame className="w-3.5 h-3.5 text-gold-400" />
          <span>{showHeatmap ? 'Isı Haritasını Gizle' : 'AI Etkileşim Isı Haritası'}</span>
        </button>
      </div>

      {/* Embedded Heatmap */}
      {showHeatmap && <BestTimeSlotHeatmap />}

      <div className="grid grid-cols-7 gap-3 min-w-[900px] flex-1">
        {weekDays.map(day => {
          const dayPosts = posts.filter(p => {
            const pDate = new Date(p.scheduledAt);
            return pDate.getDate() === day.date && pDate.getMonth() === 8; // Sep 2026
          });
          const holiday = getHolidayForDate(8, day.date);

          return (
            <div
              key={day.date}
              className="bg-void-900 border border-void-750/80 rounded-2xl p-3 flex flex-col justify-between"
            >
              {/* Day Top Bar */}
              <div>
                <div className="flex items-center justify-between pb-2 border-b border-void-750">
                  <div>
                    <span className="text-xs font-semibold text-void-400 uppercase tracking-wider block font-mono">
                      {day.name}
                    </span>
                    <span className="text-sm font-bold font-unbounded text-white">
                      {day.fullDate}
                    </span>
                    {holiday && (
                      <span className="mt-1 inline-block text-[9px] font-bold px-1.5 py-0.5 rounded bg-rose-500/15 text-rose-300 border border-rose-500/30">
                        {holiday.label}
                      </span>
                    )}
                  </div>
                  <div className="text-right">
                    <span className="text-[10px] text-teal-300 font-mono block">
                      ★ {day.bestHour}
                    </span>
                    <span className="text-[9px] text-void-500">Optimum</span>
                  </div>
                </div>

                {/* Posts for this day */}
                <div className="mt-3 space-y-2.5">
                  {dayPosts.map(post => (
                    <PostCard key={post.id} post={post} />
                  ))}

                  {dayPosts.length === 0 && (
                    <div className="p-4 rounded-xl border border-dashed border-void-750 text-center text-void-500 text-xs">
                      Bu gün için planlanmış yayın yok
                    </div>
                  )}
                </div>
              </div>

              {/* Add Button */}
              <button
                onClick={() => openCreatePost('feed')}
                className="w-full mt-3 py-2 rounded-xl bg-void-850 hover:bg-gold-400/15 border border-void-700/80 hover:border-gold-400/40 text-void-300 hover:text-gold-300 text-xs font-medium flex items-center justify-center gap-1.5 transition-all cursor-pointer"
              >
                <Plus className="w-3.5 h-3.5" />
                İçerik Planla
              </button>
            </div>
          );
        })}
      </div>
    </div>
  );
};


