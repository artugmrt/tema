                      </td>

                      {roles.map((r) => {
                        const isGranted = matrix[r]?.[pKey] ?? false;
                        const isLockedAdmin = r === 'agency_admin' && (pKey === 'TEAM_MANAGE' || pKey === 'SETTINGS_MANAGE_API');

                        return (
                          <td key={r} className="p-3 text-center">
                            <button
                              type="button"
                              disabled={isLockedAdmin}
                              onClick={() => handleToggle(r, pKey)}
                              className={`w-8 h-8 rounded-xl flex items-center justify-center mx-auto transition-all cursor-pointer ${
                                isGranted
