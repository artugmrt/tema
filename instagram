              variant="void"
              size="sm"
              leftIcon={<RotateCcw className="w-3.5 h-3.5 text-void-400" />}
              onClick={handleReset}
            >
              Varsayılan İzinlere Sıfırla
            </Button>
            {hasSaved && (
              <span className="text-xs font-mono text-emerald-400 flex items-center gap-1">
