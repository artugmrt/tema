export const AutoPlannerService = {
  /**
   * Generates a complete 30-day autonomous content calendar for an account
   */
  generate30DayPlan(
    account: Account,
    strategyId: string = 'luxury_architecture',
    postCount: number = 20
  ): Post[] {
    const strategy = INDUSTRY_STRATEGIES[strategyId] || INDUSTRY_STRATEGIES.luxury_architecture;
    const generatedPosts: Post[] = [];
    const now = new Date();

    const intervalDays = Math.max(1, Math.floor(30 / postCount));
    let currentDayOffset = 1;

    for (let i = 0; i < postCount; i++) {
      const targetDate = new Date(now.getTime() + currentDayOffset * 24 * 60 * 60 * 1000);
      currentDayOffset += (i % 2 === 0 ? intervalDays : intervalDays + 1);

      const pillar = strategy.pillars[i % strategy.pillars.length];

      targetDate.setHours(pillar.suggestedHour, pillar.suggestedMinute, 0, 0);

      // Check if there is a Turkish holiday or special day
      const holiday = getHolidayForDate(targetDate.getMonth(), targetDate.getDate());
      let caption = `${pillar.hook}\n\n${pillar.captionTemplate}`;
      let hashtags = [...pillar.hashtags];

      if (holiday) {
        caption = `${holiday.label} Özel Yayını ✨\n\n${caption}`;
        hashtags.push(`#${holiday.name.replace(/[^a-zA-Z0-9]/g, '')}`);
      }

      const post: Post = {
        id: `auto-${Date.now()}-${i}`,
        accountId: account.id,
        type: pillar.type,
        status: 'scheduled' as PostStatus,
        scheduledAt: targetDate.toISOString(),
        caption,
        hashtags,
        mediaUrls: [
          pillar.type === 'reel' 
            ? 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1080'
            : pillar.type === 'carousel'
            ? 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1080'
            : 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1080'
        ],
        location: `${account.displayName} Studio`,
        bestTimeScore: Math.floor(Math.random() * 10 + 88), // 88 - 98
        approvalHistory: [
          {
            id: `ah-auto-${Date.now()}-${i}`,
            userName: 'Otonom AI Planlayıcı',
            userRole: 'agency_admin',
            userAvatar: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=80',
            action: 'created',
            timestamp: new Date().toISOString(),
            note: `30 Günlük Otonom Takvim motoru tarafından '${strategy.name}' stratejisiyle üretildi.`
          }
        ]
      };

      generatedPosts.push(post);
    }

    return generatedPosts;
  },

  /**
   * Detects conflict pairs (scheduled within less than 120 minutes of each other on the same account)
   */
  detectConflicts(posts: Post[]): Array<{
    postA: Post;
    postB: Post;
    diffMinutes: number;
    accountId: string;
  }> {
    const conflicts: Array<{ postA: Post; postB: Post; diffMinutes: number; accountId: string }> = [];

    // Group posts by account
    const byAccount: Record<string, Post[]> = {};
    for (const p of posts) {
      if (!byAccount[p.accountId]) byAccount[p.accountId] = [];
      byAccount[p.accountId].push(p);
    }

    for (const [accId, accPosts] of Object.entries(byAccount)) {
      // Sort by scheduledAt
      const sorted = [...accPosts].sort(
        (a, b) => new Date(a.scheduledAt).getTime() - new Date(b.scheduledAt).getTime()
      );

      for (let i = 0; i < sorted.length - 1; i++) {
        const postA = sorted[i];
        const postB = sorted[i + 1];

        const diffMs = Math.abs(new Date(postB.scheduledAt).getTime() - new Date(postA.scheduledAt).getTime());
        const diffMinutes = Math.round(diffMs / (1000 * 60));

        // Conflict threshold: less than 120 minutes (2 hours)
        if (diffMinutes < 120) {
          conflicts.push({
            postA,
            postB,
            diffMinutes,
            accountId: accId
          });
        }
      }
    }

    return conflicts;
  },

  /**
   * Automatically spreads conflicting posts to at least 4 hours apart
   */
  autoSpreadConflicts(posts: Post[]): Post[] {
    const updated = [...posts];
    const conflicts = this.detectConflicts(updated);

    for (const conflict of conflicts) {
      const idx = updated.findIndex(p => p.id === conflict.postB.id);
      if (idx !== -1) {
        // Shift postB by 4 hours (240 minutes) forward
        const prevTime = new Date(conflict.postA.scheduledAt);
        const newTime = new Date(prevTime.getTime() + 4 * 60 * 60 * 1000);

        updated[idx] = {
          ...updated[idx],
          scheduledAt: newTime.toISOString(),
          bestTimeScore: Math.min(99, (updated[idx].bestTimeScore || 90) + 3)
        };
      }
    }

    return updated;
  }
