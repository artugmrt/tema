/**
 * Calculates a Cubic Bézier curve between start and target points with natural human curvature
 */
export function generateBezierPath(
  start: { x: number; y: number },
  target: { x: number; y: number },
  steps: number = 25
): Array<{ x: number; y: number }> {
  const dx = target.x - start.x;
  const dy = target.y - start.y;
  
  // Random control points to simulate human hand curvature
  const cp1 = {
    x: start.x + dx * 0.25 + (Math.random() - 0.5) * 80,
    y: start.y + dy * 0.1 + (Math.random() - 0.5) * 80,
  };
  const cp2 = {
    x: start.x + dx * 0.75 + (Math.random() - 0.5) * 60,
    y: start.y + dy * 0.9 + (Math.random() - 0.5) * 60,
  };

  const points: Array<{ x: number; y: number }> = [];

  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    const invT = 1 - t;

    // Cubic Bézier formula
    const x =
      invT * invT * invT * start.x +
      3 * invT * invT * t * cp1.x +
      3 * invT * t * t * cp2.x +
      t * t * t * target.x;

    const y =
      invT * invT * invT * start.y +
      3 * invT * invT * t * cp1.y +
      3 * invT * t * t * cp2.y +
      t * t * t * target.y;

    // Add tiny micro-jitter (1-2px)
    const jitterX = (Math.random() - 0.5) * 1.5;
    const jitterY = (Math.random() - 0.5) * 1.5;

    points.push({ x: Math.round(x + jitterX), y: Math.round(y + jitterY) });
  }

  return points;
}

/**
 * Simulates human keystroke injection with focus/blur and realistic delay
 */
export async function simulateHumanInput(
  element: HTMLInputElement | HTMLTextAreaElement,
  text: string,
  minDelayMs: number = 65,
  maxDelayMs: number = 140
): Promise<void> {
  element.focus();
  element.value = '';

  for (let i = 0; i < text.length; i++) {
    const char = text[i];
    
    // Dispatch key events
    element.dispatchEvent(new KeyboardEvent('keydown', { key: char, bubbles: true }));
    
    // Use document.execCommand if available for native browser history stack
    if (document.queryCommandSupported && document.queryCommandSupported('insertText')) {
      document.execCommand('insertText', false, char);
    } else {
      element.value += char;
      element.dispatchEvent(new Event('input', { bubbles: true }));
    }

    element.dispatchEvent(new KeyboardEvent('keyup', { key: char, bubbles: true }));

    // Variable keystroke delay
    const delay = Math.floor(Math.random() * (maxDelayMs - minDelayMs + 1)) + minDelayMs;
    await new Promise(r => setTimeout(r, delay));

    // Occasional micro-pause after punctuation
    if (['.', ',', '!', '?'].includes(char)) {
      await new Promise(r => setTimeout(r, Math.floor(Math.random() * 250 + 200)));
    }
  }

  element.dispatchEvent(new Event('change', { bubbles: true }));
}

