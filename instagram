-- 4. MATERIALIZED VIEWS & PRODUCTION INDEXES (Bölüm 7.2)

CREATE MATERIALIZED VIEW public.account_weekly_stats AS
SELECT 
  account_id,
  date_trunc('week', metric_date) as week_start,
  AVG(followers)::numeric(10,2) as avg_followers,
  AVG(reach)::numeric(10,2) as avg_reach,
  AVG(engagement_rate)::numeric(5,2) as avg_engagement
FROM public.account_analytics
GROUP BY account_id, date_trunc('week', metric_date);

CREATE UNIQUE INDEX idx_account_weekly_stats 
ON public.account_weekly_stats(account_id, week_start);

CREATE OR REPLACE FUNCTION public.refresh_account_stats()
RETURNS void AS $$
BEGIN
  REFRESH MATERIALIZED VIEW CONCURRENTLY public.account_weekly_stats;
END;
$$ LANGUAGE plpgsql;

