import { createClient, SupabaseClient, RealtimeChannel } from '@supabase/supabase-js';
import { ApiKeysService } from './apiKeysService';
import { Account, Post, BrandFolder, QueueItem } from '../types';

let cachedClient: SupabaseClient | null = null;
let currentUrl = '';
let currentKey = '';
let activeChannel: RealtimeChannel | null = null;

export interface RealtimeSubscriptionCallbacks {
  onPostChange?: (eventType: 'INSERT' | 'UPDATE' | 'DELETE', post: any) => void;
  onAccountChange?: (eventType: 'INSERT' | 'UPDATE' | 'DELETE', account: any) => void;
  onStatusChange?: (status: 'SUBSCRIBED' | 'TIMED_OUT' | 'CLOSED' | 'CHANNEL_ERROR') => void;
}

export const SupabaseService = {
  getClient(): SupabaseClient | null {
    const config = ApiKeysService.getConfig();
    if (!config.supabaseUrl || !config.supabaseAnonKey) {
      return null;
    }

    if (cachedClient && currentUrl === config.supabaseUrl && currentKey === config.supabaseAnonKey) {
      return cachedClient;
    }

    try {
      cachedClient = createClient(config.supabaseUrl, config.supabaseAnonKey);
      currentUrl = config.supabaseUrl;
      currentKey = config.supabaseAnonKey;
      return cachedClient;
    } catch (e) {
      console.warn('Supabase client creation error:', e);
      return null;
    }
  },

  /**
   * Initializes real-time WebSocket subscription for posts, accounts, and queue items
   */
  subscribeToRealtime(callbacks: RealtimeSubscriptionCallbacks): (() => void) {
    const client = this.getClient();
    if (!client) {
      callbacks.onStatusChange?.('CLOSED');
      return () => {};
    }

    // Clean up previous channel if exists
    if (activeChannel) {
      try {
        client.removeChannel(activeChannel);
      } catch (e) {
        console.warn('Error removing old channel:', e);
      }
    }

    const channelName = `instaplanner_live_${Date.now()}`;
    const channel = client.channel(channelName);

    // 1. Listen for Posts changes (INSERT, UPDATE, DELETE)
    channel.on(
      'postgres_changes',
      { event: '*', schema: 'public', table: 'posts' },
      (payload) => {
        const eventType = payload.eventType as 'INSERT' | 'UPDATE' | 'DELETE';
        const record = eventType === 'DELETE' ? payload.old : payload.new;
        if (callbacks.onPostChange && record) {
          // Map snake_case to camelCase
          const mappedPost: Partial<Post> = {
            id: record.id,
            accountId: record.account_id,
            type: record.type,
            status: record.status,
            scheduledAt: record.scheduled_at,
            publishedAt: record.published_at,
            caption: record.caption,
            hashtags: record.hashtags || [],
            mediaUrls: record.media_urls || [],
            coverUrl: record.cover_url,
            location: record.location,
            bestTimeScore: record.best_time_score,
          };
          callbacks.onPostChange(eventType, mappedPost);
        }
      }
    );

    // 2. Listen for Accounts changes (INSERT, UPDATE, DELETE)
    channel.on(
      'postgres_changes',
      { event: '*', schema: 'public', table: 'accounts' },
      (payload) => {
        const eventType = payload.eventType as 'INSERT' | 'UPDATE' | 'DELETE';
        const record = eventType === 'DELETE' ? payload.old : payload.new;
        if (callbacks.onAccountChange && record) {
          const mappedAccount: Partial<Account> = {
            id: record.id,
            username: record.username,
            displayName: record.display_name,
            avatar: record.avatar_url,
            category: record.category,
            followerCount: record.follower_count,
            followingCount: record.following_count,
            postCount: record.post_count,
            healthScore: record.health_score,
            riskLevel: record.risk_level,
            status: record.status,
          };
          callbacks.onAccountChange(eventType, mappedAccount);
        }
      }
    );

    // Subscribe
    channel.subscribe((status) => {
      callbacks.onStatusChange?.(status as any);
    });

    activeChannel = channel;

    // Return unsubscribe function
    return () => {
      try {
        client.removeChannel(channel);
        if (activeChannel === channel) {
          activeChannel = null;
        }
      } catch (err) {
        console.warn('Error unsubscribing channel:', err);
      }
    };
  },

  /**
   * Syncs a single post to Supabase database (Upsert)
   */
  async syncPostToCloud(post: Post): Promise<boolean> {
    const client = this.getClient();
    if (!client) return false;

    try {
      const payload: any = {
        id: post.id,
        account_id: post.accountId,
        type: post.type,
        status: post.status,
        scheduled_at: post.scheduledAt,
        published_at: post.publishedAt || null,
        caption: post.caption,
        hashtags: post.hashtags || [],
        media_urls: post.mediaUrls || [],
        cover_url: post.coverUrl || null,
        location: post.location || null,
        best_time_score: post.bestTimeScore || 90,
        updated_at: new Date().toISOString()
      };

      const { error } = await client.from('posts').upsert(payload, { onConflict: 'id' });
      if (error) {
        console.warn('Supabase syncPost error:', error.message);
        return false;
      }
      return true;
    } catch (e) {
      console.warn('Supabase syncPost exception:', e);
      return false;
    }
  },

  /**
   * Deletes a post from Supabase database
   */
  async deletePostFromCloud(postId: string): Promise<boolean> {
    const client = this.getClient();
    if (!client) return false;

    try {
      const { error } = await client.from('posts').delete().eq('id', postId);
      return !error;
    } catch (e) {
      console.warn('Supabase deletePost exception:', e);
      return false;
    }
  },

  /**
   * Syncs an account to Supabase database (Upsert)
   */
  async syncAccountToCloud(account: Account): Promise<boolean> {
    const client = this.getClient();
    if (!client) return false;

    try {
      const payload: any = {
        id: account.id,
        username: account.username,
        display_name: account.displayName,
        avatar_url: account.avatar,
        category: account.category,
        follower_count: account.followerCount,
        following_count: account.followingCount,
        post_count: account.postCount,
        health_score: account.healthScore,
        risk_level: account.riskLevel,
        status: account.status,
        updated_at: new Date().toISOString()
      };

