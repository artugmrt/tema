  'antigravity-skills',
  '.system_generated'
]);

const targetExts = new Set(['.ts', '.tsx', '.css', '.json', '.md', '.sql', '.sh', '.js']);

function getAllFiles(dir) {
  let results = [];
  const entries = fs.readdirSync(dir, { withFileTypes: true });

  for (const entry of entries) {
    if (excludeDirs.has(entry.name)) continue;
    // Skip external references docs if too noisy, but keep docs/
    if (dir.endsWith('docs') && entry.name === 'references') continue;

    const fullPath = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      results = results.concat(getAllFiles(fullPath));
    } else {
      const ext = path.extname(entry.name).toLowerCase();
      // Skip the dump file itself if re-running
      if (entry.name.includes('FULL_CODEBASE_DUMP')) continue;
      if (targetExts.has(ext)) {
        results.push(fullPath);
      }
    }
  }
  return results;
}

const allFilePaths = getAllFiles(rootDir).sort();
const relPaths = allFilePaths.map(p => path.relative(rootDir, p).replace(/\\/g, '/')).sort();

let totalLines = 0;
const counts = {
  ts_tsx: 0,
  css: 0,
  json: 0,
  md: 0,
  sql: 0,
  sh: 0,
  js: 0
};

