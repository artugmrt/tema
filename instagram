  simulateInboundPostIngest(
    account: Account,
    payload: {
      caption: string;
      hashtags: string[];
      mediaUrl?: string;
      scheduledAt?: string;
    }
  ): Post {
    const newPost: Post = {
      id: `ext-ingest-${Date.now()}`,
      accountId: account.id,
      type: 'feed',
      status: 'draft',
      caption: payload.caption,
      hashtags: payload.hashtags,
      mediaUrls: [
        payload.mediaUrl || 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1080&auto=format&fit=crop&q=80'
      ],
      scheduledAt: payload.scheduledAt || new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
      location: 'İstanbul, Türkiye',
      approvalHistory: [
        {
          id: `ah-ext-${Date.now()}`,
          userName: 'Zapier Inbound Webhook',
          userRole: 'content_creator',
          userAvatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=80&auto=format&fit=crop&q=80',
          action: 'created',
          timestamp: new Date().toISOString(),
          note: 'Dış API / Webhook üzerinden otomatik içe aktarıldı.'
        }
      ]
    };

    // Update API Key last used timestamp
    const keys = this.getApiKeys();
    if (keys.length > 0) {
      keys[0].lastUsedAt = new Date().toISOString();
      localStorage.setItem(STORAGE_KEY_API_KEYS, JSON.stringify(keys));
    }

    return newPost;
  }
};


