/**
 * Graphify Codebase Dependency & Architecture Graph Generator
 * InstaPlanner AGENTIC — Autonomous Build Ecosystem
 * 
 * Scans TypeScript / React AST relations, contexts, services, and components,
 * creating a structured architectural knowledge graph for agents.
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.resolve(__dirname, '..');
const srcDir = path.join(rootDir, 'src');
const docsDir = path.join(rootDir, 'docs');

if (!fs.existsSync(docsDir)) {
  fs.mkdirSync(docsDir, { recursive: true });
}

function scanDirectory(dir, fileList = []) {
  const files = fs.readdirSync(dir);
  for (const file of files) {
    const fullPath = path.join(dir, file);
    const stat = fs.statSync(fullPath);
    if (stat.isDirectory()) {
      scanDirectory(fullPath, fileList);
    } else if (/\.(tsx?|jsx?|css|sql)$/.test(file)) {
      fileList.push(fullPath);
    }
  }
  return fileList;
}

console.log('🔍 [Graphify] Scanning codebase AST and dependency tree...');
const allFiles = scanDirectory(srcDir);

const graph = {
  version: '4.0.0',
  generatedAt: new Date().toISOString(),
  stats: {
    totalFiles: allFiles.length,
    componentsCount: 0,
    contextsCount: 0,
    servicesCount: 0,
    contentScriptsCount: 0,
  },
  nodes: [],
  edges: [],
};

const importRegex = /import\s+(?:(?:{[^}]+})|(?:[\w\d_]+)|\*\s+as\s+[\w\d_]+)?\s+from\s+['"]([^'"]+)['"]/g;

for (const filePath of allFiles) {
  const relativePath = path.relative(rootDir, filePath).replace(/\\/g, '/');
  const content = fs.readFileSync(filePath, 'utf-8');
  const fileType = path.extname(filePath);
  const baseName = path.basename(filePath);

  let category = 'other';
  if (relativePath.includes('src/components/')) {
    category = 'component';
    graph.stats.componentsCount++;
  } else if (relativePath.includes('src/context/')) {
    category = 'context';
    graph.stats.contextsCount++;
  } else if (relativePath.includes('src/services/')) {
    category = 'service';
    graph.stats.servicesCount++;
  } else if (relativePath.includes('src/content/')) {
    category = 'content-script';
    graph.stats.contentScriptsCount++;
  }

  const nodeId = relativePath;
  graph.nodes.push({
    id: nodeId,
    name: baseName,
    category,
    lineCount: content.split('\n').length,
    sizeBytes: Buffer.byteLength(content, 'utf-8')
  });

  let match;
  while ((match = importRegex.exec(content)) !== null) {
    const importTarget = match[1];
    if (importTarget.startsWith('.')) {
      const resolvedDir = path.dirname(filePath);
      const targetPath = path.resolve(resolvedDir, importTarget);
      const targetRel = path.relative(rootDir, targetPath).replace(/\\/g, '/');
      graph.edges.push({
        from: nodeId,
        to: targetRel,
        importString: importTarget
      });
    }
  }
}

// Write JSON Graph
const jsonGraphPath = path.join(docsDir, 'codebase_graph.json');
fs.writeFileSync(jsonGraphPath, JSON.stringify(graph, null, 2), 'utf-8');

