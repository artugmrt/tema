import React, { useState, useRef } from 'react';
import { 
  ShieldCheck, 
  Download, 
  Upload, 
  Key, 
  CheckCircle2, 
  AlertTriangle, 
  FileText, 
  Clock, 
  X, 
  RefreshCw, 
  Database, 
  Lock, 
  Unlock,
  Layers,
  Archive,
  History
} from '@animated-color-icons/lucide-react';
import { motion } from 'framer-motion';
import { 
  BackupVaultService, 
  BackupValidationResult, 
  AutoBackupSnapshot 
} from '../../services/backupVaultService';
import { GlassCard } from '../common/GlassCard';
import { Button } from '../common/Button';

interface BackupVaultModalProps {
  isOpen: boolean;
  onClose: () => void;
}

export const BackupVaultModal: React.FC<BackupVaultModalProps> = ({
  isOpen,
  onClose
}) => {
  const [activeTab, setActiveTab] = useState<'export' | 'restore' | 'history'>('export');
  
  // Export State
  const [passphrase, setPassphrase] = useState('');
  const [isEncrypted, setIsEncrypted] = useState(false);
  const [exportNotice, setExportNotice] = useState<string | null>(null);

  // Restore State
  const [uploadedJson, setUploadedJson] = useState<string | null>(null);
  const [restorePassphrase, setRestorePassphrase] = useState('');
  const [validation, setValidation] = useState<BackupValidationResult | null>(null);
  const [restoreNotice, setRestoreNotice] = useState<string | null>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);

  // History State
  const [historyList, setHistoryList] = useState<AutoBackupSnapshot[]>(() => 
    BackupVaultService.getAutoBackupHistory()
  );

  if (!isOpen) return null;

  // Handle Export
  const handleExport = () => {
    try {
      const res = BackupVaultService.downloadBackupFile(isEncrypted ? passphrase : undefined);
      setExportNotice(`Yedek kasası başarıyla indirildi: ${res.filename} (${(res.sizeBytes / 1024).toFixed(1)} KB)`);
      setHistoryList(BackupVaultService.getAutoBackupHistory());
      setTimeout(() => setExportNotice(null), 6000);
    } catch (err: any) {
      alert('Yedekleme hatası: ' + err.message);
    }
  };

  // Handle File Upload
  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const text = event.target?.result as string;
      setUploadedJson(text);
      const val = BackupVaultService.validateBackup(text, restorePassphrase);
      setValidation(val);
    };
    reader.readAsText(file);
  };

  const handleValidateWithPassphrase = () => {
    if (!uploadedJson) return;
    const val = BackupVaultService.validateBackup(uploadedJson, restorePassphrase);
    setValidation(val);
  };

  // Handle Restore
  const handleRestore = () => {
    if (!validation?.payload) return;

    const confirmed = window.confirm(
      'DİKKAT: Bu yedek yüklendiğinde mevcut tüm hesaplar, gönderiler ve ayarlar bu yedekle değiştirilecek. Devam etmek istiyor musunuz?'
    );

    if (!confirmed) return;

    const res = BackupVaultService.restoreFullBackup(validation.payload);
    if (res.success) {
      setRestoreNotice(res.message);
      setTimeout(() => {
        window.location.reload(); // Rehydrate all state cleanly
      }, 1200);
    }
  };

  // Trigger manual snapshot in history tab
  const handleTriggerSnapshot = () => {
    BackupVaultService.triggerAutoBackup();
    setHistoryList(BackupVaultService.getAutoBackupHistory());
  };

  // Restore snapshot from history
  const handleRestoreFromHistory = (snap: AutoBackupSnapshot) => {
    if (window.confirm(`${new Date(snap.timestamp).toLocaleString('tr-TR')} tarihli yedeğe dönmek istiyor musunuz?`)) {
      BackupVaultService.restoreFullBackup(snap.data);
      window.location.reload();
    }
  };

