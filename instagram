Bu Bölümdeki Dosya Sayısı: ${partFiles.length}
Bu Bölümdeki Toplam Satır: ${partLines}

────────────────────────────────────────────────────────────────
BU BÖLÜMDEKİ DOSYA LİSTESİ:
────────────────────────────────────────────────────────────────
${partFiles.map((f, idx) => `${idx + 1}. ${f.path}`).join('\n')}

────────────────────────────────────────────────────────────────
DOSYA İÇERİKLERİ
────────────────────────────────────────────────────────────────
`;

  const partContent = partHeader + partBody;
  const partPath = path.join(rootDir, `INSTAPLANNER_DUMP_PART_${p}.txt`);
  fs.writeFileSync(partPath, partContent, 'utf-8');

  const pSizeKb = (Buffer.byteLength(partContent, 'utf-8') / 1024).toFixed(1);
  partitionSummary.push({
    part: p,
    fileName: `INSTAPLANNER_DUMP_PART_${p}.txt`,
    fileCount: partFiles.length,
    lines: partLines,
    sizeKb: pSizeKb,
    firstFile: partFiles[0].path,
    lastFile: partFiles[partFiles.length - 1].path
  });

  console.log(`   Part ${p}/10: ${partFiles.length} dosya, ${partLines} satır, ${pSizeKb} KB (İlk: ${partFiles[0].path} | Son: ${partFiles[partFiles.length - 1].path})`);
}

