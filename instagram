import React, { useState, useEffect } from 'react';
import { 
  Globe, 
  Sparkles, 
  X, 
  Check, 
  Send, 
  Key, 
  ShieldCheck, 
  Copy, 
  Trash2, 
  Plus, 
  RefreshCw,
  Terminal,
  Activity,
  CheckCircle2,
  AlertTriangle
} from '@animated-color-icons/lucide-react';
import { motion } from 'framer-motion';
import { 
  WebhookHubService, 
  WebhookSubscription, 
  WebhookDeliveryLog, 
  ApiKey,
  WebhookEventType 
} from '../../services/webhookHubService';
import { useApp } from '../../context/AppContext';
import { Button } from '../common/Button';

interface WebhookHubModalProps {
  isOpen: boolean;
  onClose: () => void;
  onInboundIngestSuccess?: () => void;
}

type TabType = 'outbound' | 'inbound' | 'logs';

export const WebhookHubModal: React.FC<WebhookHubModalProps> = ({
  isOpen,
  onClose,
  onInboundIngestSuccess
}) => {
  const { selectedAccount, createPost } = useApp();
  const [activeTab, setActiveTab] = useState<TabType>('outbound');
  
  const [subscriptions, setSubscriptions] = useState<WebhookSubscription[]>([]);
  const [logs, setLogs] = useState<WebhookDeliveryLog[]>([]);
  const [apiKeys, setApiKeys] = useState<ApiKey[]>([]);

  // Ping Test State
  const [testingPingId, setTestingPingId] = useState<string | null>(null);
  const [pingResult, setPingResult] = useState<{ id: string; status: number; durationMs: number } | null>(null);

  // New Subscription Form State
  const [isAddingSub, setIsAddingSub] = useState<boolean>(false);
  const [newSubName, setNewSubName] = useState('');
  const [newSubUrl, setNewSubUrl] = useState('');
  const [newSubEvents, setNewSubEvents] = useState<WebhookEventType[]>(['post.created', 'post.approved']);

  // New API Key State
  const [isAddingKey, setIsAddingKey] = useState<boolean>(false);
  const [newKeyName, setNewKeyName] = useState('');

  // Notification / Ingestion Feedback
  const [ingestSuccessMsg, setIngestSuccessMsg] = useState<string | null>(null);
  const [copiedToken, setCopiedToken] = useState<string | null>(null);

  useEffect(() => {
    if (isOpen) {
      setSubscriptions(WebhookHubService.getSubscriptions());
      setLogs(WebhookHubService.getDeliveryLogs());
      setApiKeys(WebhookHubService.getApiKeys());
    }
  }, [isOpen]);

  if (!isOpen) return null;

  const handleTestPing = async (sub: WebhookSubscription) => {
    setTestingPingId(sub.id);
    setPingResult(null);

    const res = await WebhookHubService.testPingWebhook(sub.targetUrl, sub.secretKey);
    setTestingPingId(null);
    setPingResult({ id: sub.id, status: res.status, durationMs: res.durationMs });

    // Refresh logs and subs
    setLogs(WebhookHubService.getDeliveryLogs());
    setSubscriptions(WebhookHubService.getSubscriptions());
  };

  const handleToggleActive = (id: string) => {
    WebhookHubService.toggleSubscription(id);
    setSubscriptions(WebhookHubService.getSubscriptions());
  };

  const handleDeleteSub = (id: string) => {
    WebhookHubService.deleteSubscription(id);
    setSubscriptions(WebhookHubService.getSubscriptions());
  };

  const handleCreateSub = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newSubName.trim() || !newSubUrl.trim()) return;

    const newSub: WebhookSubscription = {
      id: `wh-${Date.now()}`,
      name: newSubName.trim(),
      targetUrl: newSubUrl.trim(),
      secretKey: `whsec_${Math.random().toString(36).substring(2, 12)}`,
      events: newSubEvents,
      isActive: true,
      createdAt: new Date().toISOString(),
      successCount: 0,
      failureCount: 0
    };

    WebhookHubService.saveSubscription(newSub);
    setSubscriptions(WebhookHubService.getSubscriptions());
    setIsAddingSub(false);
    setNewSubName('');
    setNewSubUrl('');
  };

  const handleGenerateKey = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newKeyName.trim()) return;

    WebhookHubService.generateApiKey(newKeyName.trim());
    setApiKeys(WebhookHubService.getApiKeys());
    setIsAddingKey(false);
    setNewKeyName('');
  };

  const handleRevokeKey = (id: string) => {
    WebhookHubService.revokeApiKey(id);
    setApiKeys(WebhookHubService.getApiKeys());
  };

  const handleCopy = (text: string, id: string) => {
    navigator.clipboard.writeText(text);
    setCopiedToken(id);
    setTimeout(() => setCopiedToken(null), 2000);
  };

  const handleSimulateInboundIngest = () => {
    const samplePayload = {
      caption: 'Zapier / Notion üzerinden senkronize edilen lüks sahil villası lansman duyurusu. Akıllı ev sistemleri & panoramik deniz manzarası.',
      hashtags: ['#ZapierSync', '#NotionDatabase', '#LuxuryVilla', '#ApexLiving'],
      mediaUrl: 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1080&auto=format&fit=crop&q=80',
      scheduledAt: new Date(Date.now() + 48 * 60 * 60 * 1000).toISOString()
    };

    const newPost = WebhookHubService.simulateInboundPostIngest(selectedAccount, samplePayload);
    createPost(newPost);
    setApiKeys(WebhookHubService.getApiKeys());

    setIngestSuccessMsg(`✅ Zapier Inbound Webhook gönderiyi (${newPost.id}) taslaklara ekledi!`);
    setTimeout(() => setIngestSuccessMsg(null), 4000);

    if (onInboundIngestSuccess) {
      onInboundIngestSuccess();
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-void-950/80 backdrop-blur-md font-mono">
      <motion.div
        initial={{ opacity: 0, scale: 0.95 }}
        animate={{ opacity: 1, scale: 1 }}
        exit={{ opacity: 0, scale: 0.95 }}
        className="w-full max-w-3xl bg-void-900 border border-teal-500/40 rounded-3xl shadow-2xl flex flex-col overflow-hidden max-h-[88vh]"
      >
        {/* Header */}
        <div className="px-6 py-4 border-b border-void-750 bg-gradient-to-r from-void-950 via-void-900 to-void-950 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="p-2 rounded-xl bg-teal-500/15 text-teal-400 border border-teal-500/30">
              <Globe className="w-5 h-5 text-teal-400 animate-pulse" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h3 className="text-base font-bold font-unbounded text-white">
                  Webhook & Dış Entegrasyon Merkezi
                </h3>
                <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-teal-500/20 text-teal-300 border border-teal-500/40">
                  HMAC-SHA256 SECURED
