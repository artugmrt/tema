    // 3-15s: Sustained interest (gentle decline)
    // 15-25s: Climax / Solution
    // 25-30s: Outro / CTA (drop before end)
    for (let sec = 0; sec <= durationSeconds; sec++) {
      let retentionPercentage = 100;

      if (sec === 0) {
        retentionPercentage = 100;
      } else if (sec <= 3) {
        // Fast hook drop
