import React, { useEffect, useRef, useState } from 'react';
import { Cpu, ShieldCheck, Zap, AlertTriangle, PlayCircle, PauseCircle, Globe } from '@animated-color-icons/lucide-react';
import { generateBezierPath } from '../../../content/instagramInjector';
import { useApp } from '../../../context/AppContext';

export const BezierLiveWidget: React.FC = () => {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const [activeCurvePoints, setActiveCurvePoints] = useState<Array<{ x: number; y: number }>>([]);
  const [currentJitter, setCurrentJitter] = useState<number>(4.2);

  useEffect(() => {
    const updateCurve = () => {
      const p1 = { x: 20 + Math.random() * 30, y: 110 + Math.random() * 20 };
      const p2 = { x: 240 + Math.random() * 40, y: 25 + Math.random() * 30 };
      const path = generateBezierPath(p1, p2, 35);
      setActiveCurvePoints(path);
      setCurrentJitter(parseFloat((Math.random() * 6 + 2).toFixed(1)));
    };

    updateCurve();
    const interval = setInterval(updateCurve, 2800);
    return () => clearInterval(interval);
  }, []);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas || activeCurvePoints.length === 0) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Draw grid
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
    ctx.lineWidth = 1;
    for (let x = 0; x < canvas.width; x += 25) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, canvas.height);
      ctx.stroke();
    }
    for (let y = 0; y < canvas.height; y += 25) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(canvas.width, y);
      ctx.stroke();
    }

    // Draw Bézier trajectory
    ctx.beginPath();
    ctx.strokeStyle = '#54E0C8';
    ctx.lineWidth = 2.5;
    ctx.shadowColor = '#54E0C8';
    ctx.shadowBlur = 8;

    activeCurvePoints.forEach((pt, index) => {
      if (index === 0) ctx.moveTo(pt.x, pt.y);
      else ctx.lineTo(pt.x, pt.y);
    });
    ctx.stroke();

    // Control points
    if (activeCurvePoints.length > 0) {
      const first = activeCurvePoints[0];
      const last = activeCurvePoints[activeCurvePoints.length - 1];

      ctx.shadowBlur = 0;
      ctx.fillStyle = '#FACB32';
      ctx.beginPath();
      ctx.arc(first.x, first.y, 4.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#54E0C8';
      ctx.beginPath();
      ctx.arc(last.x, last.y, 5, 0, Math.PI * 2);
      ctx.fill();
    }
  }, [activeCurvePoints]);

  return (
    <div className="h-full flex flex-col justify-between p-4 bg-void-900/90 border border-void-750/80 rounded-2xl hover:border-teal-400/40 transition-all overflow-hidden">
      <div className="flex items-center justify-between mb-1.5">
        <div className="flex items-center gap-2">
          <div className="w-7 h-7 rounded-lg bg-teal-500/10 border border-teal-500/30 flex items-center justify-center text-teal-400">
            <Cpu className="w-4 h-4" />
          </div>
          <div>
            <h4 className="text-xs font-bold font-unbounded text-white">Canlı Bézier Simülatörü</h4>
            <span className="text-[10px] text-void-400 font-mono">Biyometrik İnsan Fare Hareketi</span>
          </div>
        </div>
        <span className="text-[10px] font-mono text-teal-300 bg-teal-500/15 px-2 py-0.5 rounded-full border border-teal-500/30">
          Anti-Bot %100
        </span>
      </div>

      <div className="relative rounded-xl overflow-hidden bg-void-950 border border-void-800 my-1 flex-1 flex items-center justify-center">
        <canvas ref={canvasRef} width={300} height={130} className="w-full h-full object-contain" />
        <div className="absolute bottom-2 left-2 flex items-center gap-2 bg-void-900/80 backdrop-blur-sm px-2 py-0.5 rounded-lg border border-void-750 text-[10px] font-mono text-void-300">
          <span>Jitter: ±{currentJitter}px</span>
          <span>•</span>
          <span className="text-gold-400">P1 ➔ P2 Canlı</span>
        </div>
      </div>

      <div className="flex items-center justify-between text-[10px] text-void-400 font-mono pt-1 border-t border-void-800">
        <span>Gecikme: 50-150ms Gaussian</span>
        <span className="text-teal-400 font-semibold">Görünmez DOM Enjeksiyonu</span>
      </div>
    </div>
  );
};

