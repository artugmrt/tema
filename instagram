import { Account, AnalyticsSummary, Post } from '../types';

export interface WebhookLog {
  id: string;
  timestamp: string;
  eventType: 'scheduled_publish' | 'report_export' | 'ai_orchestration' | 'ping_test';
  endpoint: string;
  status: 'success' | 'failed' | 'simulated';
  statusCode: number;
  payload: any;
  response: any;
}

export const N8nService = {
  /**
   * Test live connection to n8n Webhook
   */
  async testConnection(webhookUrl: string, authToken?: string): Promise<{ success: boolean; latencyMs: number; message: string; statusCode: number }> {
    const startTime = Date.now();

    if (!webhookUrl || !webhookUrl.startsWith('http')) {
      return {
        success: false,
        latencyMs: 0,
        message: 'Geçersiz webhook adresi (http/https ile başlamalı).',
        statusCode: 400
      };
    }

    try {
      const headers: Record<string, string> = {
        'Content-Type': 'application/json',
        'X-Agent-Source': 'InstaPlanner-Agentic-v4'
      };
      if (authToken) {
        headers['Authorization'] = `Bearer ${authToken}`;
      }

      const res = await fetch(webhookUrl, {
        method: 'POST',
        headers,
        body: JSON.stringify({
          event: 'PING_TEST',
          timestamp: new Date().toISOString(),
          version: '4.0.2',
          client: 'InstaPlanner Dashboard'
        })
      });

      const latencyMs = Date.now() - startTime;
      const data = await res.json().catch(() => ({ status: res.statusText }));

      return {
        success: res.ok,
        latencyMs,
        message: res.ok ? 'n8n Webhook bağlantısı aktif ve tetiklendi!' : `n8n yanıt hatası: HTTP ${res.status}`,
        statusCode: res.status
      };
    } catch (err: any) {
      const latencyMs = Date.now() - startTime;
      return {
        success: false,
        latencyMs,
        message: `n8n Bağlantı Hatası: ${err.message || 'Sunucuya erişilemedi'}`,
        statusCode: 500
      };
    }
  },

  /**
   * Dispatches a scheduled publishing trigger to n8n
   */
  async triggerScheduledPublish(post: Post, account: Account): Promise<WebhookLog> {
    const config = ApiKeysService.getConfig();
    const payload = {
      event: 'INSTAGRAM_PUBLISH_TRIGGER',
      accountId: account.id,
      accountUsername: account.username,
      postId: post.id,
      postType: post.type,
      caption: post.caption,
      hashtags: post.hashtags,
      mediaUrls: post.mediaUrls,
      scheduledAt: post.scheduledAt,
      humanMimicryDelayMs: 95,
      timestamp: new Date().toISOString()
    };

    let log: WebhookLog;

    try {
      if (config.n8nEnabled && config.n8nWebhookUrl) {
        const headers: Record<string, string> = {
          'Content-Type': 'application/json'
        };
        if (config.n8nAuthToken) {
