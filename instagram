   */
  analyzeComment(text: string, author: string = 'kullanici'): Omit<TriageComment, 'id' | 'timestamp' | 'isResolved' | 'status'> {
    const lower = text.toLowerCase();

    let sentiment: SentimentType = 'neutral';
    let category: PriorityCategory = 'inquiry';
    let leadScore = 50;

    // 1. Crisis Detection
    const crisisKeywords = ['rezalet', 'dolandırıcı', 'şikayet', 'dava', 'kimse yoktu', 'ulaşılamıyor', 'berbat', 'tüketici hakları', 'yalan', 'sahtekar'];
    if (crisisKeywords.some(k => lower.includes(k))) {
      sentiment = 'crisis';
      category = 'crisis';
      leadScore = 10;
    } 
    // 2. High Value Lead Detection
    else if (['fiyat', 'kaç', 'satın', 'rezervasyon', 'randevu', 'dm', 'katalog', 'm2', 'metrekare', 'satılık', 'kiralık'].some(k => lower.includes(k))) {
      sentiment = 'positive';
      category = 'vip_lead';
