/**
 * Graphify Live File Watcher
 * InstaPlanner AGENTIC — Autonomous Build Ecosystem
 * 
 * Watches src/, supabase/, and scripts/ for any file changes, additions,
 * or deletions, debounces events, and immediately re-synchronizes the
 * Graphify architectural knowledge graph to keep it 100% up to date.
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { spawn } from 'child_process';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.resolve(__dirname, '..');

const watchDirs = [
  path.join(rootDir, 'src'),
  path.join(rootDir, 'supabase'),
  path.join(rootDir, 'scripts')
];

let syncTimeout = null;
let isSyncing = false;
let pendingSync = false;

function triggerSync(changedPath) {
  if (syncTimeout) {
    clearTimeout(syncTimeout);
  }

  syncTimeout = setTimeout(() => {
    if (isSyncing) {
      pendingSync = true;
      return;
    }

    isSyncing = true;
    const rel = changedPath ? path.relative(rootDir, changedPath) : 'codebase';
    console.log(`\n⚡ [Graphify Watcher] Değişiklik algılandı (${rel}) -> Senkronize ediliyor...`);

    const child = spawn('node', [path.join(rootDir, 'scripts', 'graphify_sync.js')], {
      stdio: 'inherit',
      cwd: rootDir
    });

    child.on('close', (code) => {
      isSyncing = false;
      if (code === 0) {
        console.log('✨ [Graphify Watcher] Bilgi grafiği başarıyla güncellendi. Arama hazır.');
      } else {
        console.error(`⚠️ [Graphify Watcher] Senkronizasyon ${code} kodu ile sonlandı.`);
      }

      if (pendingSync) {
        pendingSync = false;
        triggerSync('pending-batch');
      }
    });
  }, 400); // 400ms debounce
}

console.log('👀 [Graphify Watcher] Canlı dosya izleyici başlatıldı.');
console.log('   İzlenen dizinler: src/, supabase/, scripts/');
console.log('   (Her dosya değişikliğinde bilgi grafiği otomatik güncellenecek)\n');

// Initial sync on startup
triggerSync('watcher-init');

for (const dir of watchDirs) {
  if (fs.existsSync(dir)) {
    try {
      fs.watch(dir, { recursive: true }, (eventType, filename) => {
        if (filename && (filename.endsWith('.ts') || filename.endsWith('.tsx') || filename.endsWith('.sql') || filename.endsWith('.json') || filename.endsWith('.css'))) {
          // Ignore docs or generated output
          if (!filename.includes('graphify-out') && !filename.includes('codebase_graph')) {
            triggerSync(path.join(dir, filename));
          }
        }
      });
    } catch (e) {
      console.warn(`[Graphify Watcher] fs.watch recursive desteklenmiyor olabilir (${dir}): ${e.message}`);
    }
  }
}

// Keep process running
process.stdin.resume();


