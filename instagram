import { HumanEngineConfig, Post, QueueItem } from '../types';
import { generateBezierPath } from '../content/instagramInjector';

export class HumanMimicryEngine {
  private config: HumanEngineConfig;
  private isProcessing: boolean = false;
  private isEmergencyStopped: boolean = false;

  constructor(config: HumanEngineConfig) {
    this.config = config;
  }

  public updateConfig(newConfig: Partial<HumanEngineConfig>) {
    this.config = { ...this.config, ...newConfig };
    if (newConfig.emergencyKillSwitch !== undefined) {
      this.isEmergencyStopped = newConfig.emergencyKillSwitch;
    }
  }

  /**
   * Generates a random delay between minCharDelayMs and maxCharDelayMs with occasional thinking pause
   */
  public getRandomCharDelay(): number {
    const base = Math.floor(
      Math.random() * (this.config.maxCharDelayMs - this.config.minCharDelayMs + 1) +
        this.config.minCharDelayMs
    );
    // 15-20% chance of a natural thinking pause (300ms - 800ms)
    const isThinkingPause = Math.random() * 100 < this.config.randomPauseChancePct;
    if (isThinkingPause) {
      return base + Math.floor(Math.random() * 500 + 300);
    }
    return base;
  }

  /**
   * Adds natural human jitter (+/- minutes) to a scheduled time
   */
  public calculateJitterTime(scheduledIso: string): { effectiveTime: string; jitterOffsetMinutes: number } {
    const variance = this.config.jitterVarianceMinutes;
    // Generate jitter between -variance and +variance
    const jitterOffsetMinutes = Math.floor(Math.random() * (variance * 2 + 1)) - variance;
    const date = new Date(scheduledIso);
    date.setMinutes(date.getMinutes() + jitterOffsetMinutes);
    return {
      effectiveTime: date.toISOString(),
      jitterOffsetMinutes,
    };
  }

  /**
   * Checks if current time is within safe operational window (avoids night sleep & meal spikes)
   */
  public isCurrentWindowSafe(): { isSafe: boolean; reason?: string } {
    if (this.isEmergencyStopped) {
      return { isSafe: false, reason: 'Acil Durdurma (Emergency Kill Switch) Aktif!' };
    }

    const now = new Date();
    const currentHour = now.getHours();

    if (this.config.enableNightPause) {
      if (currentHour >= this.config.nightStartHour || currentHour < this.config.nightEndHour) {
        return { 
          isSafe: false, 
          reason: `Gece Dinlenme Penceresi Aktif (${this.config.nightStartHour}:00 - 0${this.config.nightEndHour}:00). İnsan davranışı taklidi gereği paylaşım duraklatıldı.` 
        };
      }
    }

    return { isSafe: true };
  }

  /**
   * Simulates typing text character-by-character with callback for live UI visualization
   */
  public async simulateTyping(
    text: string, 
    onProgress: (currentText: string, charIndex: number, delayMs: number) => void,
    shouldCancel?: () => boolean
  ): Promise<void> {
    let current = '';
    for (let i = 0; i < text.length; i++) {
      if (this.isEmergencyStopped || (shouldCancel && shouldCancel())) {
        throw new Error('Yazma simülasyonu acil durdurma veya iptal nedeniyle kesildi.');
      }
      current += text[i];
      const delay = this.getRandomCharDelay();
      onProgress(current, i + 1, delay);
      await new Promise(resolve => setTimeout(resolve, delay));
    }
  }

  /**
   * Executes a simulated human publishing flow with Bézier curvature and DOM injection
   */
  public async executeSafePublishFlow(
    post: Post,
    onStepChange: (stepDesc: string, progressPct: number) => void
  ): Promise<{ success: boolean; error?: string }> {
    if (this.isEmergencyStopped) {
      return { success: false, error: 'Acil Durdurma aktif olduğu için işlem iptal edildi.' };
    }

    try {
      // Step 1: Human Navigation & Focus
      onStepChange('Instagram Web oturumu doğrulanıyor ve güvenli sekme odaklanıyor...', 15);
      await new Promise(r => setTimeout(r, Math.random() * 400 + 600));

      // Step 2: Open Media Composer with 3rd-order Bézier Mouse Trajectory
      const bezierPoints = generateBezierPath({ x: 120, y: 350 }, { x: 480, y: 720 }, 25);
      onStepChange(`Medya yükleme arayüzüne 3. derece Bézier fare kavis rotası hesaplandı (${bezierPoints.length} nokta)...`, 35);
      await new Promise(r => setTimeout(r, Math.random() * 500 + 700));

      // Step 3: Human Keystroke Simulation (50-150ms)
      const textToType = `${post.caption} ${post.hashtags.join(' ')}`.trim();
      onStepChange(`Açıklama doğal insan klavye gecikmesiyle (${this.config.minCharDelayMs}-${this.config.maxCharDelayMs}ms) enjekte ediliyor...`, 65);
      
      if (typeof chrome !== 'undefined' && chrome.tabs?.query) {
        try {
          const [activeTab] = await chrome.tabs.query({ active: true, currentWindow: true });
          if (activeTab?.id) {
            chrome.tabs.sendMessage(activeTab.id, {
              action: 'INJECT_POST',
              payload: { 
                caption: textToType, 
                minDelayMs: this.config.minCharDelayMs, 
                maxDelayMs: this.config.maxCharDelayMs 
              }
            });
          }
        } catch {
          // Dev mode fallback
        }
      }
      await new Promise(r => setTimeout(r, Math.random() * 800 + 1000));

      // Step 4: Final checks & Location Tagging
      if (post.location) {
        onStepChange(`Konum etiketi doğal hareketle ekleniyor: ${post.location}...`, 80);
        await new Promise(r => setTimeout(r, Math.random() * 400 + 500));
      }

      // Step 5: Submission with Human Random Delay
      onStepChange('Paylaş butonuna tıklanıyor ve Instagram sunucu onayı bekleniyor...', 95);
      await new Promise(r => setTimeout(r, Math.random() * 500 + 700));

      onStepChange('Paylaşım başarıyla tamamlandı!', 100);
      return { success: true };
    } catch (err: any) {
      return { success: false, error: err.message || 'Bilinmeyen yayınlama hatası' };
    }
  }
}



