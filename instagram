import React, { useState, useEffect } from 'react';
import { 
  Plus, 
  RotateCcw, 
  SlidersHorizontal, 
  Sparkles, 
  Search, 
  Calendar as CalendarIcon, 
  X, 
  GripVertical, 
  ShieldCheck, 
  Zap, 
  Layers 
} from '@animated-color-icons/lucide-react';
import { Responsive, useContainerWidth } from 'react-grid-layout';
import 'react-grid-layout/css/styles.css';
import 'react-resizable/css/styles.css';

import { useApp } from '../../context/AppContext';
import { useNavigation } from '../../context/NavigationContext';
import { WIDGET_REGISTRY, DEFAULT_ACTIVE_WIDGET_IDS, DEFAULT_LAYOUTS } from './WidgetRegistry';
import { WidgetDrawer } from './WidgetDrawer';

// Widget components
import { FollowersKpiWidget, ReachKpiWidget, EngagementKpiWidget, QueueKpiWidget } from './widgets/KpiWidgets';
import { 
  EngagementTrendChartWidget, 
  FormatPerformanceBarWidget, 
  DailyActivityChartWidget, 
  CompetitorRadarChartWidget,
  ContentFlowSankeyWidget,
  ApprovalFunnelWidget
} from './widgets/ChartWidgets';
import { BezierLiveWidget, EngineStatusWidget } from './widgets/EngineWidgets';
import { AccountPortfolioWidget, PendingApprovalsWidget, QueueListWidget, MiniCalendarWidget } from './widgets/ContentWidgets';
import { AiQuickWidget, HashtagsWidget, NotificationsWidget, SystemHealthWidget } from './widgets/UtilityWidgets';

const STORAGE_LAYOUT_KEY = 'instaplanner_dashboard_layouts_v4';
const STORAGE_ACTIVE_KEY = 'instaplanner_dashboard_active_v4';

export const MainDashboardView: React.FC = () => {
  const { selectedAccount, accounts, setSelectedAccountId } = useApp();
  const { openCreatePost } = useNavigation();
  const { width, containerRef, mounted } = useContainerWidth();

  const [isDrawerOpen, setIsDrawerOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');

  // Active widgets list state
  const [activeWidgetIds, setActiveWidgetIds] = useState<string[]>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_ACTIVE_KEY);
      return saved ? JSON.parse(saved) : DEFAULT_ACTIVE_WIDGET_IDS;
    } catch {
      return DEFAULT_ACTIVE_WIDGET_IDS;
    }
  });

  // Layouts state
  const [layouts, setLayouts] = useState<any>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_LAYOUT_KEY);
      return saved ? JSON.parse(saved) : DEFAULT_LAYOUTS;
    } catch {
      return DEFAULT_LAYOUTS;
    }
  });

  // Save changes to localStorage
  const handleLayoutChange = (allLayouts: any) => {
    setLayouts(allLayouts);
    try {
      localStorage.setItem(STORAGE_LAYOUT_KEY, JSON.stringify(allLayouts));
    } catch (e) {
      console.warn('Could not save dashboard layouts to localStorage', e);
    }
  };

  const handleToggleWidget = (id: string) => {
    let next: string[];
    if (activeWidgetIds.includes(id)) {
      next = activeWidgetIds.filter(wId => wId !== id);
    } else {
      next = [...activeWidgetIds, id];
    }
    setActiveWidgetIds(next);
    try {
      localStorage.setItem(STORAGE_ACTIVE_KEY, JSON.stringify(next));
    } catch (e) {
      console.warn('Could not save active widgets to localStorage', e);
    }
  };

  const handleResetLayout = () => {
    setLayouts(DEFAULT_LAYOUTS);
    setActiveWidgetIds(DEFAULT_ACTIVE_WIDGET_IDS);
    try {
      localStorage.removeItem(STORAGE_LAYOUT_KEY);
      localStorage.removeItem(STORAGE_ACTIVE_KEY);
    } catch (e) {
      console.warn('Could not clear layout storage', e);
    }
  };

  const renderWidgetContent = (id: string) => {
    switch (id) {
      case 'kpi_followers':
        return <FollowersKpiWidget />;
      case 'kpi_reach':
        return <ReachKpiWidget />;
      case 'kpi_engagement':
        return <EngagementKpiWidget />;
      case 'kpi_queue':
        return <QueueKpiWidget />;
      case 'chart_trend':
        return <EngagementTrendChartWidget />;
      case 'chart_formats':
        return <FormatPerformanceBarWidget />;
      case 'chart_daily_activity':
        return <DailyActivityChartWidget />;
      case 'chart_competitor_radar':
        return <CompetitorRadarChartWidget />;
      case 'chart_sankey':
        return <ContentFlowSankeyWidget />;
      case 'chart_funnel':
        return <ApprovalFunnelWidget />;
      case 'engine_bezier':
        return <BezierLiveWidget />;
      case 'engine_status':
        return <EngineStatusWidget />;
      case 'content_portfolio':
        return <AccountPortfolioWidget />;
      case 'content_approvals':
        return <PendingApprovalsWidget />;
      case 'content_queue':
        return <QueueListWidget />;
      case 'utility_mini_calendar':
        return <MiniCalendarWidget />;
      case 'utility_ai_quick':
        return <AiQuickWidget />;
      case 'utility_hashtags':
        return <HashtagsWidget />;
      case 'utility_notifications':
        return <NotificationsWidget />;
      case 'utility_system_health':
        return <SystemHealthWidget />;
      default:
        return null;
    }
  };

  return (
    <div className="flex-1 flex flex-col p-6 space-y-5 overflow-y-auto">
      {/* 1. TOP COMMAND BAR */}
      <div className="p-4 rounded-2xl bg-void-900/95 border border-void-750/90 backdrop-blur-md shadow-xl flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        {/* Left: Brand Identity & Active Profile */}
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-2xl bg-gradient-to-tr from-gold-500/20 to-teal-500/20 border border-gold-400/40 flex items-center justify-center text-gold-400 shadow-gold-glow shrink-0">
            <Layers className="w-5 h-5" />
          </div>
          <div>
            <div className="flex items-center gap-2">
              <h2 className="text-sm font-bold font-unbounded text-white tracking-wide">
                Agentic Komuta Merkezi
              </h2>
              <span className="text-[10px] font-mono px-2 py-0.5 rounded-full bg-gold-400/15 text-gold-300 border border-gold-400/30">
                v4.0.2 Modüler
              </span>
            </div>
            <p className="text-[11px] text-void-400 font-mono">
              Biyometrik İnsan Motoru • Sürükle-Bırak Özelleştirilebilir Izgara
            </p>
          </div>
        </div>

        {/* Center: Search & Account Picker */}
        <div className="flex items-center gap-2.5 flex-1 max-w-xl">
          <div className="relative flex-1">
            <Search className="w-3.5 h-3.5 text-void-500 absolute left-3 top-1/2 -translate-y-1/2" />
            <input
              type="text"
              value={searchQuery}
              onChange={e => setSearchQuery(e.target.value)}
              placeholder="Marka, etiket veya analiz ara..."
              className="w-full bg-void-950/80 border border-void-700/80 rounded-xl pl-9 pr-3 py-1.5 text-xs text-white placeholder-void-500 focus:outline-none focus:border-gold-400 font-mono transition-all"
            />
          </div>

          <select
            value={selectedAccount.id}
            onChange={e => setSelectedAccountId(e.target.value)}
            className="bg-void-950 border border-void-700 rounded-xl px-3 py-1.5 text-xs text-void-200 font-mono focus:outline-none focus:border-gold-400 cursor-pointer"
          >
            {accounts.map(acc => (
              <option key={acc.id} value={acc.id}>
                {acc.displayName} (@{acc.username})
              </option>
            ))}
          </select>
        </div>

        {/* Right: Actions */}
        <div className="flex items-center gap-2 shrink-0">
          <button
            onClick={() => setIsDrawerOpen(true)}
            className="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-mono font-bold bg-void-850 hover:bg-void-800 text-teal-300 border border-teal-500/40 hover:border-teal-400 transition-all cursor-pointer shadow-teal-glow"
          >
            <SlidersHorizontal className="w-3.5 h-3.5 text-teal-400" />
            <span>Widget Yönetimi ({activeWidgetIds.length})</span>
          </button>

          <button
            onClick={handleResetLayout}
            title="Izgara Düzenini Sıfırla"
            className="p-2 rounded-xl text-void-400 hover:text-gold-300 bg-void-850 hover:bg-void-800 border border-void-750 transition-all cursor-pointer"
          >
            <RotateCcw className="w-3.5 h-3.5" />
          </button>

          <button
            onClick={() => openCreatePost('carousel')}
            className="flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-mono font-bold bg-gradient-to-r from-gold-400 to-gold-300 text-void-950 hover:brightness-110 transition-all cursor-pointer shadow-gold-glow"
          >
            <Plus className="w-3.5 h-3.5" />
            <span>İçerik Planla</span>
          </button>
        </div>
      </div>

      {/* 2. CUSTOMIZABLE GRID LAYOUT */}
      <div ref={containerRef} className="w-full flex-1">
        {mounted && (
          <Responsive
            className="layout"
            layouts={layouts}
            width={width}
            breakpoints={{ lg: 1200, md: 996, sm: 768, xs: 480, xxs: 0 }}
            cols={{ lg: 12, md: 10, sm: 6, xs: 4, xxs: 2 }}
            rowHeight={75}
            margin={[14, 14]}
            dragConfig={{ handle: '.widget-drag-handle' }}
            onLayoutChange={(_current, all) => handleLayoutChange(all)}
          >
            {activeWidgetIds.map(id => {
              const def = WIDGET_REGISTRY[id];
              if (!def) return null;

              return (
                <div key={id} className="relative group rounded-2xl overflow-hidden shadow-lg">
                  {/* Hover Drag Bar */}
                  <div className="widget-drag-handle absolute top-2 right-2 z-20 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity bg-void-950/80 backdrop-blur-sm border border-void-700/80 rounded-lg px-1.5 py-0.5 cursor-grab active:cursor-grabbing">
                    <GripVertical className="w-3 h-3 text-void-400" />
                    <button
                      type="button"
                      onClick={(e) => {
                        e.stopPropagation();
                        handleToggleWidget(id);
                      }}
                      className="text-void-400 hover:text-rose-400 transition-colors ml-0.5 cursor-pointer"
                      title="Widget'ı Kaldır"
                    >
                      <X className="w-3 h-3" />
                    </button>
                  </div>

                  {/* Widget Body */}
                  <div className="h-full w-full">
                    {renderWidgetContent(id)}
                  </div>
                </div>
              );
            })}
          </Responsive>
        )}
      </div>

      {/* 3. WIDGET MANAGEMENT DRAWER */}
      <WidgetDrawer
        isOpen={isDrawerOpen}
        onClose={() => setIsDrawerOpen(false)}
        activeWidgetIds={activeWidgetIds}
        onToggleWidget={handleToggleWidget}
        onResetLayout={handleResetLayout}
      />
    </div>
  );
};


