interface RbacMatrixModalProps {
  isOpen: boolean;
  onClose: () => void;
}

export const RbacMatrixModal: React.FC<RbacMatrixModalProps> = ({
  isOpen,
  onClose
}) => {
  const [matrix, setMatrix] = useState<RolePermissionMatrix>(() => 
    RbacService.getPermissionMatrix()
  );

  const [hasSaved, setHasSaved] = useState(false);

  if (!isOpen) return null;

  const roles: UserRole[] = [
    'agency_admin',
    'supervisor',
    'content_creator',
    'copywriter',
    'client_approver',
    'guest_viewer'
  ];

  const permissionKeys: PermissionKey[] = [
    'POST_CREATE',
    'POST_EDIT',
    'POST_DELETE',
    'POST_APPROVE',
    'POST_PUBLISH_NOW',
    'SETTINGS_MANAGE_API',
    'PROXY_MANAGE',
    'KILL_SWITCH_TRIGGER',
    'REPORT_EXPORT',
    'MAGIC_LINK_GENERATE',
    'INBOX_REPLY',
    'TEAM_MANAGE'
  ];

  const handleToggle = (role: UserRole, perm: PermissionKey) => {
    // Prevent locking out agency admin from root permissions
    if (role === 'agency_admin' && (perm === 'TEAM_MANAGE' || perm === 'SETTINGS_MANAGE_API')) {
      return;
    }

    setMatrix(prev => ({
      ...prev,
      [role]: {
        ...prev[role],
        [perm]: !prev[role][perm]
      }
    }));
  };

  const handleReset = () => {
    if (window.confirm('Tüm izinler sistem varsayılan ayarlarına döndürülecek. Onaylıyor musunuz?')) {
      const def = RbacService.resetToDefaultPermissions();
      setMatrix(def);
      setHasSaved(true);
      setTimeout(() => setHasSaved(false), 2500);
    }
  };

  const handleSave = () => {
    RbacService.savePermissionMatrix(matrix);
    setHasSaved(true);
    setTimeout(() => {
      setHasSaved(false);
      onClose();
    }, 800);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-void-950/80 backdrop-blur-md">
      <motion.div
        initial={{ opacity: 0, scale: 0.95 }}
        animate={{ opacity: 1, scale: 1 }}
        exit={{ opacity: 0, scale: 0.95 }}
        className="w-full max-w-6xl max-h-[92vh] bg-void-900 border border-gold-500/30 rounded-3xl shadow-2xl flex flex-col overflow-hidden"
      >
        {/* Header */}
        <div className="px-6 py-4 border-b border-void-750 flex items-center justify-between bg-gradient-to-r from-void-900 via-void-950 to-void-900">
          <div className="flex items-center gap-3">
            <div className="p-2 rounded-xl bg-gold-400/10 text-gold-400 border border-gold-400/20">
              <Shield className="w-5 h-5" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h3 className="text-base font-bold font-unbounded text-white">
                  Ekip Rolleri & Granüler İzin Matrisi (RBAC Matrix)
                </h3>
                <span className="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-gold-500/20 text-gold-300 border border-gold-500/30">
                  ENTERPRISE SECURITY
                </span>
              </div>
              <p className="text-xs text-void-400 mt-0.5">
                Hangi rolün post oluşturabileceğini, onaylayabileceğini veya doğrudan yayınlayabileceğini belirleyin.
              </p>
            </div>
          </div>

          <button
            onClick={onClose}
            className="p-2 rounded-xl bg-void-850 hover:bg-void-800 text-void-400 hover:text-white transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Content Table Body */}
        <div className="flex-1 overflow-y-auto p-6 space-y-4">
          {/* Roles Legend Badges */}
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 text-xs font-mono">
            {roles.map(r => (
              <div key={r} className={`p-2 rounded-xl border ${ROLE_LABELS[r].badgeColor} flex flex-col justify-between`}>
                <span className="font-bold text-[11px] block">{ROLE_LABELS[r].title}</span>
                <span className="text-[9px] opacity-80 line-clamp-1 mt-0.5">{ROLE_LABELS[r].description}</span>
              </div>
            ))}
          </div>

          {/* Matrix Table */}
          <div className="overflow-x-auto rounded-2xl border border-void-800 bg-void-950">
            <table className="w-full text-xs font-mono text-left">
              <thead>
                <tr className="border-b border-void-800 text-void-400 bg-void-900/60">
                  <th className="p-3.5 font-bold min-w-[240px]">İZİN / YETKİ ADI</th>
                  <th className="p-3.5 text-center min-w-[110px]">👑 YÖNETİCİ</th>
                  <th className="p-3.5 text-center min-w-[110px]">🛡️ SÜPERVİZÖR</th>
                  <th className="p-3.5 text-center min-w-[110px]">✍️ ÜRETİCİ</th>
                  <th className="p-3.5 text-center min-w-[110px]">📝 YAZAR</th>
                  <th className="p-3.5 text-center min-w-[110px]">🏢 MÜŞTERİ</th>
                  <th className="p-3.5 text-center min-w-[110px]">👀 MİSAFİR</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-void-850">
                {permissionKeys.map((pKey) => {
                  const permMeta = PERMISSION_LABELS[pKey];
                  return (
                    <tr key={pKey} className="hover:bg-void-900/40 transition-colors">
                      <td className="p-3.5">
                        <div className="flex flex-col">
                          <span className="text-white font-bold text-[12px]">{permMeta.title}</span>
