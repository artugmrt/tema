import { StorageService } from './storageService';
import { 
  Account, 
  BrandFolder, 
  Post, 
  QueueItem, 
  HumanEngineConfig, 
  ChangelogEntry, 
  ConstitutionRuleItem,
  RolePermissionMatrix 
} from '../types';
import { 
  INITIAL_ACCOUNTS, 
  INITIAL_BRAND_FOLDERS, 
  INITIAL_POSTS, 
  INITIAL_QUEUE_ITEMS, 
  INITIAL_HUMAN_ENGINE_CONFIG,
  INITIAL_CHANGELOG,
  INITIAL_CONSTITUTION_RULES
} from './defaultData';
import { RbacService, DEFAULT_ROLE_PERMISSIONS } from './rbacService';

export interface BackupVaultData {
  accounts: Account[];
  brandFolders: BrandFolder[];
  posts: Post[];
  queue: QueueItem[];
  engineConfig: HumanEngineConfig;
  rbacMatrix: RolePermissionMatrix;
  changelog: ChangelogEntry[];
  constitutionRules: ConstitutionRuleItem[];
}

export interface BackupVaultPayload {
  version: string;
  systemSignature: string;
  exportedAt: string;
  checksum: string;
  isEncrypted: boolean;
  data?: BackupVaultData;
  encryptedPayload?: string;
}

export interface BackupValidationResult {
  isValid: boolean;
  checksumPassed: boolean;
  isEncrypted: boolean;
  requiresPassphrase: boolean;
  itemCounts: {
    accounts: number;
    posts: number;
    queue: number;
    folders: number;
  };
  exportedAt: string;
  version: string;
  errors: string[];
  payload?: BackupVaultPayload;
}

export interface AutoBackupSnapshot {
  id: string;
  timestamp: string;
  sizeBytes: number;
  accountCount: number;
  postCount: number;
  data: BackupVaultPayload;
}

const STORAGE_KEY_AUTO_BACKUPS = 'backup_vault_history_v4';
const STORAGE_KEY_LAST_BACKUP = 'backup_vault_last_run_v4';

// Simple deterministic hash function for payload integrity
function calculateChecksum(str: string): string {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    const char = str.charCodeAt(i);
    hash = ((hash << 5) - hash) + char;
    hash |= 0; // Convert to 32bit integer
  }
  return 'chk_' + Math.abs(hash).toString(16).padStart(8, '0');
}

// Reversible encryption envelope for browser JSON vault
function encryptPayload(jsonText: string, passphrase: string): string {
  let output = '';
  for (let i = 0; i < jsonText.length; i++) {
    const charCode = jsonText.charCodeAt(i);
    const keyChar = passphrase.charCodeAt(i % passphrase.length);
    output += String.fromCharCode(charCode ^ keyChar);
  }
  return btoa(encodeURIComponent(output));
}

function decryptPayload(encryptedBase64: string, passphrase: string): string {
  const decoded = decodeURIComponent(atob(encryptedBase64));
  let output = '';
  for (let i = 0; i < decoded.length; i++) {
    const charCode = decoded.charCodeAt(i);
    const keyChar = passphrase.charCodeAt(i % passphrase.length);
    output += String.fromCharCode(charCode ^ keyChar);
  }
  return output;
}

export const BackupVaultService = {
  /**
   * Assembles the current in-memory / storage state into a complete data object
   */
  getCurrentSystemData(): BackupVaultData {
    return {
      accounts: StorageService.get<Account[]>('accounts_v4', INITIAL_ACCOUNTS),
      brandFolders: StorageService.get<BrandFolder[]>('folders_v4', INITIAL_BRAND_FOLDERS),
      posts: StorageService.get<Post[]>('posts_v4', INITIAL_POSTS),
      queue: StorageService.get<QueueItem[]>('queue_v4', INITIAL_QUEUE_ITEMS),
      engineConfig: StorageService.get<HumanEngineConfig>('engine_config', INITIAL_HUMAN_ENGINE_CONFIG),
      rbacMatrix: RbacService.getPermissionMatrix(),
      changelog: StorageService.get<ChangelogEntry[]>('changelog_v4', INITIAL_CHANGELOG),
      constitutionRules: StorageService.get<ConstitutionRuleItem[]>('constitution_rules_v4', INITIAL_CONSTITUTION_RULES)
    };
  },

  /**
   * Creates a backup envelope, optionally encrypted with a user passphrase
   */
  createBackupPayload(passphrase?: string): BackupVaultPayload {
    const rawData = this.getCurrentSystemData();
    const dataString = JSON.stringify(rawData);
    const checksum = calculateChecksum(dataString);
    const exportedAt = new Date().toISOString();

    if (passphrase && passphrase.trim().length > 0) {
      const encrypted = encryptPayload(dataString, passphrase.trim());
      return {
        version: '4.0.2',
        systemSignature: 'INSTAPLANNER_AGENTIC_ENTERPRISE_VAULT',
        exportedAt,
        checksum,
        isEncrypted: true,
        encryptedPayload: encrypted
      };
    }

    return {
      version: '4.0.2',
      systemSignature: 'INSTAPLANNER_AGENTIC_ENTERPRISE_VAULT',
      exportedAt,
      checksum,
      isEncrypted: false,
      data: rawData
    };
  },

  /**
   * Generates and downloads the backup file directly in the browser
   */
  downloadBackupFile(passphrase?: string): { filename: string; sizeBytes: number } {
    const payload = this.createBackupPayload(passphrase);
    const jsonStr = JSON.stringify(payload, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json;charset=utf-8' });
    
    const nowStr = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
    const filename = `instaplanner_backup_vault_${nowStr}${payload.isEncrypted ? '.enc' : ''}.json`;

    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    // Record last backup timestamp
    StorageService.set(STORAGE_KEY_LAST_BACKUP, new Date().toISOString());

    return {
      filename,
      sizeBytes: blob.size
    };
  },

  /**
   * Validates a backup string and decodes payload if passphrase is provided
   */
  validateBackup(fileContent: string, passphrase?: string): BackupValidationResult {
    const result: BackupValidationResult = {
      isValid: false,
      checksumPassed: false,
      isEncrypted: false,
      requiresPassphrase: false,
      itemCounts: { accounts: 0, posts: 0, queue: 0, folders: 0 },
      exportedAt: '',
      version: '',
      errors: []
    };

    try {
      const parsed: BackupVaultPayload = JSON.parse(fileContent);

      if (parsed.systemSignature !== 'INSTAPLANNER_AGENTIC_ENTERPRISE_VAULT') {
        result.errors.push('Geçersiz dosya imzası: Bu dosya geçerli bir InstaPlanner yedek kasası değil.');
        return result;
      }

      result.version = parsed.version || 'Bilinmiyor';
      result.exportedAt = parsed.exportedAt || 'Bilinmiyor';
      result.isEncrypted = Boolean(parsed.isEncrypted);

      if (parsed.isEncrypted) {
        if (!passphrase || passphrase.trim().length === 0) {
          result.requiresPassphrase = true;
          result.errors.push('Bu yedek dosyası şifreli. Açmak için lütfen yedeği oluştururken girdiğiniz parolayı girin.');
          return result;
        }

        try {
          const decryptedJson = decryptPayload(parsed.encryptedPayload || '', passphrase.trim());
          const decryptedData: BackupVaultData = JSON.parse(decryptedJson);
          parsed.data = decryptedData;
        } catch {
          result.errors.push('Hatalı parola: Şifreli yedek içeriği çözülemedi.');
          return result;
        }
      }

      if (!parsed.data) {
        result.errors.push('Yedek dosyasında veri bloğu bulunamadı.');
        return result;
      }

      // Checksum validation
      const recalculatedChecksum = calculateChecksum(JSON.stringify(parsed.data));
      result.checksumPassed = recalculatedChecksum === parsed.checksum;

      if (!result.checksumPassed) {
        result.errors.push('Bütünlük Uyarısı: Dosya sağlama toplamı (checksum) eşleşmiyor, dosya tahrif edilmiş olabilir.');
      }

      // Item counts
      result.itemCounts = {
        accounts: parsed.data.accounts?.length || 0,
        posts: parsed.data.posts?.length || 0,
        queue: parsed.data.queue?.length || 0,
        folders: parsed.data.brandFolders?.length || 0
      };

      result.isValid = result.errors.length === 0 || (result.errors.length === 1 && !result.checksumPassed);
      result.payload = parsed;
      return result;
    } catch (e: any) {
      result.errors.push('JSON Ayrıştırma Hatası: Dosya bozuk veya geçersiz karakterler içeriyor.');
      return result;
    }
  },

  /**
   * Atomically restores all system state from a validated backup payload
   */
  restoreFullBackup(payload: BackupVaultPayload): { success: boolean; message: string } {
    if (!payload.data) {
      return { success: false, message: 'Geri yüklenecek veri bulunamadı.' };
    }

    const d = payload.data;

    if (Array.isArray(d.accounts)) StorageService.set('accounts_v4', d.accounts);
    if (Array.isArray(d.brandFolders)) StorageService.set('folders_v4', d.brandFolders);
    if (Array.isArray(d.posts)) StorageService.set('posts_v4', d.posts);
    if (Array.isArray(d.queue)) StorageService.set('queue_v4', d.queue);
    if (d.engineConfig) StorageService.set('engine_config', d.engineConfig);
    if (d.rbacMatrix) RbacService.savePermissionMatrix(d.rbacMatrix);
    if (Array.isArray(d.changelog)) StorageService.set('changelog_v4', d.changelog);
    if (Array.isArray(d.constitutionRules)) StorageService.set('constitution_rules_v4', d.constitutionRules);

    // Save restore log
    const restoreEntry: ChangelogEntry = {
      version: payload.version || '4.0.2',
      date: new Date().toISOString().slice(0, 10),
      isCurrent: true,
      added: [],
      changed: [`Felaket kurtarma yedeği başarıyla geri yüklendi (${payload.exportedAt} tarihli yedek).`],
      fixed: [],
      operationDetails: {
        type: 'güncelleme',
        affectedFiles: ['localStorage'],
        testStatus: 'test edildi',
        constitutionCompliance: 'uyumlu'
      }
    };
    const currentLogs = StorageService.get<ChangelogEntry[]>('changelog_v4', []);
    StorageService.set('changelog_v4', [restoreEntry, ...currentLogs]);

    return {
      success: true,
      message: `Tüm sistem durumu başarıyla geri yüklendi (${d.accounts.length} hesap, ${d.posts.length} gönderi).`
    };
  },

  /**
   * Creates an internal automatic backup snapshot
   */
  triggerAutoBackup(): AutoBackupSnapshot {
    const payload = this.createBackupPayload();
    const jsonStr = JSON.stringify(payload);
    const snapshot: AutoBackupSnapshot = {
      id: 'snap-' + Date.now(),
      timestamp: new Date().toISOString(),
      sizeBytes: jsonStr.length,
      accountCount: payload.data?.accounts.length || 0,
      postCount: payload.data?.posts.length || 0,
      data: payload
    };

    const history = StorageService.get<AutoBackupSnapshot[]>(STORAGE_KEY_AUTO_BACKUPS, []);
    // Keep last 5 snapshots
    const updated = [snapshot, ...history].slice(0, 5);
    StorageService.set(STORAGE_KEY_AUTO_BACKUPS, updated);
    StorageService.set(STORAGE_KEY_LAST_BACKUP, snapshot.timestamp);

    return snapshot;
  },

  /**
   * Retrieves automatic snapshots history
   */
  getAutoBackupHistory(): AutoBackupSnapshot[] {
    const history = StorageService.get<AutoBackupSnapshot[]>(STORAGE_KEY_AUTO_BACKUPS, []);
    if (history.length === 0) {
      // Create initial snapshot if empty
      return [this.triggerAutoBackup()];
    }
    return history;
  },

  /**
   * Returns last backup time formatted
   */
  getLastBackupTime(): string {
    const ts = StorageService.get<string | null>(STORAGE_KEY_LAST_BACKUP, null);
    if (!ts) return 'Henüz yedek alınmadı';
    try {
      const date = new Date(ts);
      return date.toLocaleDateString('tr-TR') + ' ' + date.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    } catch {
      return 'Bugün';
    }
  }
};


