   * Opens the executive vector report in a print-ready window
   */
  openPrintReport(account: Account, analytics: AnalyticsSummary, posts: Post[]): void {
    const html = this.generateExecutivePdfReport(account, analytics, posts);
    const printWindow = window.open('', '_blank');
    if (printWindow) {
      printWindow.document.write(html);
      printWindow.document.close();
      printWindow.focus();
      setTimeout(() => {
        printWindow.print();
      }, 600);
    }
  },

  /**
   * Exports raw analytics and posts dataset to CSV format for Excel/Google Sheets
   */
  exportToCsv(account: Account, posts: Post[]): void {
    const accountPosts = posts.filter(p => p.accountId === account.id);

    const headers = [
      'Post ID',
      'Hesap',
      'Format',
      'Durum',
      'Planlanan Tarih',
      'Yayınlanma Tarihi',
      'Kanca ve Metin',
      'Hashtagler',
      'Slot Skoru',
      'Beğeni',
      'Yorum',
      'Kaydetme',
      'Paylaşım',
      'Erişim',
      'Etkileşim Oranı'
    ];

    const rows = accountPosts.map(p => [
      p.id,
      account.username,
      p.type,
      p.status,
      p.scheduledAt,
      p.publishedAt || '',
      `"${(p.caption || '').replace(/"/g, '""')}"`,
      `"${(p.hashtags || []).join(' ')}"`,
      p.bestTimeScore || 90,
      p.analytics?.likes || 0,
      p.analytics?.comments || 0,
      p.analytics?.saves || 0,
      p.analytics?.shares || 0,
      p.analytics?.reach || 0,
      `%${p.analytics?.engagementRate || 0}`
    ]);

    const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${account.username}_performans_raporu_${new Date().toISOString().split('T')[0]}.csv`;
    link.click();
    URL.revokeObjectURL(url);
  },

  /**
   * Exports complete audit bundle in JSON format
   */
  exportToJson(account: Account, analytics: AnalyticsSummary, posts: Post[]): void {
    const payload = {
      exportDate: new Date().toISOString(),
      generator: 'InstaPlanner AGENTIC v4.0.2',
      account,
      analytics,
      posts: posts.filter(p => p.accountId === account.id)
    };

    const jsonString = `data:text/json;charset=utf-8,${encodeURIComponent(JSON.stringify(payload, null, 2))}`;
    const link = document.createElement('a');
    link.href = jsonString;
    link.download = `${account.username}_audit_bundle_${new Date().toISOString().split('T')[0]}.json`;
    link.click();
  }
