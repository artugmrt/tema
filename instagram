    const completionRate = Number(((avgWatchTimeSeconds / durationSeconds) * 100).toFixed(1));
    const isLoopingViral = avgWatchTimeSeconds > durationSeconds;
    const totalWatchTimeHours = Number(((totalPlays * avgWatchTimeSeconds) / 3600).toFixed(1));

