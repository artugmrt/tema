import { FileSpreadsheet, Download, Check, AlertCircle } from '@animated-color-icons/lucide-react';
import { PostType } from '../../types';

export const BulkUploadModal: React.FC = () => {
  const { isBulkUploadOpen, setIsBulkUploadOpen } = useNavigation();
  const { createPost, selectedAccountId } = useApp();

  const [csvText, setCsvText] = useState<string>(
    `Tarih (YYYY-MM-DD),Saat (HH:MM),Tür (feed/reel/story/carousel),Açıklama,Hashtagler
2026-09-05,19:30,feed,Eylül ayı özel mimari koleksiyon lansmanımız başlıyor.,#ApexLuxury #Architecture
2026-09-06,20:00,reel,Yalı dairesi gün batımı turu reels videosu.,#Bosphorus #LuxuryHomes
2026-09-07,18:45,carousel,Kat planları ve detaylı iç mekan fotoğrafları.,#FloorPlan #Design`
  );

  const [importResult, setImportResult] = useState<string | null>(null);

  const handleImport = () => {
    try {
      const lines = csvText.trim().split('\n');
      if (lines.length <= 1) {
        setImportResult('Hata: CSV içeriğinde geçerli satır bulunamadı.');
        return;
      }

      let count = 0;
      // Skip header line
      for (let i = 1; i < lines.length; i++) {
        const parts = lines[i].split(',');
        if (parts.length >= 4) {
          const dateStr = parts[0]?.trim();
          const timeStr = parts[1]?.trim() || '19:00';
          const type = (parts[2]?.trim().toLowerCase() as PostType) || 'feed';
          const caption = parts[3]?.trim() || '';
          const hashtags = parts[4] ? parts[4].trim().split(' ') : [];

          const scheduledIso = `${dateStr}T${timeStr}:00.000Z`;

          createPost({
            accountId: selectedAccountId,
            type,
            status: 'draft',
            caption,
            hashtags,
            scheduledAt: scheduledIso,
            notes: 'Toplu CSV yükleme ile eklendi.'
          });
          count++;
        }
      }

      setImportResult(`Başarılı! ${count} adet içerik taslak olarak takvime eklendi.`);
      setTimeout(() => {
        setIsBulkUploadOpen(false);
        setImportResult(null);
      }, 1400);
    } catch (e: any) {
      setImportResult(`Hata oluştu: ${e.message}`);
    }
  };

  return (
    <Modal
      isOpen={isBulkUploadOpen}
      onClose={() => setIsBulkUploadOpen(false)}
      title={
        <div className="flex items-center gap-2 text-white">
          <FileSpreadsheet className="w-5 h-5 text-gold-400" />
          <span>Toplu İçerik Yükleme (CSV / Excel)</span>
        </div>
      }
      subtitle="Çoklu gönderilerinizi CSV formatında yapıştırarak saniyeler içinde takvime ekleyin."
      maxWidth="2xl"
    >
      <div className="space-y-4">
        <div>
          <label className="block text-xs font-semibold text-void-300 mb-1.5 font-mono">
            CSV Verisi (Tarih, Saat, Tür, Açıklama, Hashtagler):
          </label>
          <textarea
            value={csvText}
            onChange={e => setCsvText(e.target.value)}
            rows={8}
            className="w-full bg-void-950 border border-void-700 rounded-xl p-3 text-xs text-void-200 font-mono focus:outline-none focus:border-gold-400"
          />
        </div>

        {importResult && (
          <div className="p-3 rounded-xl bg-teal-950/40 border border-teal-500/40 text-teal-300 text-xs font-mono flex items-center gap-2">
            <Check className="w-4 h-4 text-teal-400" />
            {importResult}
          </div>
        )}

        <div className="flex items-center justify-between pt-3 border-t border-void-750">
          <button
            onClick={() => {
              const sample = `Tarih (YYYY-MM-DD),Saat (HH:MM),Tür (feed/reel/story/carousel),Açıklama,Hashtagler\n2026-09-08,19:00,feed,Örnek Gönderi,#Sample #Test`;
              const blob = new Blob([sample], { type: 'text/csv' });
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url;
              a.download = 'instagram_sablon.csv';
              a.click();
            }}
            className="text-xs text-gold-400 hover:text-gold-300 flex items-center gap-1.5 font-medium cursor-pointer"
          >
            <Download className="w-3.5 h-3.5" />
            Örnek CSV Şablonunu İndir
          </button>

          <div className="flex items-center gap-2">
            <Button variant="void" size="sm" onClick={() => setIsBulkUploadOpen(false)}>
              İptal
            </Button>
            <Button variant="gold" size="sm" onClick={handleImport}>
              İçeri Aktar & Takvime Ekle
            </Button>
          </div>
        </div>
      </div>
    </Modal>
  );
};


