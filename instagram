  },

  saveConfig(config: Partial<ApiConfig>): ApiConfig {
    const current = this.getConfig();
    const updated = { ...current, ...config };
    StorageService.set('api_credentials', updated);
    return updated;
  },

  hasAiKey(): boolean {
    const cfg = this.getConfig();
    return Boolean(cfg.aiApiKey && cfg.aiApiKey.trim().length > 5);
  },

  hasSupabase(): boolean {
    const cfg = this.getConfig();
    return Boolean(cfg.supabaseUrl && cfg.supabaseAnonKey && cfg.supabaseAnonKey.trim().length > 10);
  }
};


