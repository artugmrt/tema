/**
 * Performance Monitoring & Alert Rules Engine
 * Reference: Perfect Build.md — Section 8
 */

export interface PerformanceMetric {
  event: 'page_load' | 'api_call' | 'animation_fps' | 'queue_exec';
  name: string;
  durationMs?: number;
  fps?: number;
  timestamp: string;
}

const metricsLog: PerformanceMetric[] = [];

export const performanceMonitor = {
  trackPageLoad: (pageName: string, startTime: number): number => {
    const duration = Math.round(performance.now() - startTime);
    const metric: PerformanceMetric = {
      event: 'page_load',
      name: pageName,
      durationMs: duration,
      timestamp: new Date().toISOString()
    };
    metricsLog.push(metric);
    if (duration > 1500) {
      console.warn(`⚠️ [PerformanceMonitor] Slow page load detected: ${pageName} (${duration}ms)`);
    }
    return duration;
  },

  trackApiCall: (endpoint: string, durationMs: number): void => {
    const metric: PerformanceMetric = {
      event: 'api_call',
      name: endpoint,
      durationMs,
      timestamp: new Date().toISOString()
    };
    metricsLog.push(metric);
    if (durationMs > 2000) {
      console.warn(`⚠️ [PerformanceMonitor] High API latency on ${endpoint}: ${durationMs}ms`);
    }
  },

  trackAnimation: (animationName: string, fps: number): void => {
    const metric: PerformanceMetric = {
      event: 'animation_fps',
      name: animationName,
      fps,
      timestamp: new Date().toISOString()
    };
    metricsLog.push(metric);
    if (fps < 30) {
      console.warn(`⚠️ [PerformanceMonitor] Low FPS detected: ${animationName} at ${fps}fps`);
    }
  },

  getMetrics: (): PerformanceMetric[] => {
    return [...metricsLog];
  }
};

export interface AlertResult {
  triggered: boolean;
  ruleKey: string;
  action: 'notify_admin' | 'pause_account' | 'reduce_speed' | 'notify_creator';
  priority: 'low' | 'medium' | 'high' | 'critical';
  message: string;
}

export const alertRules = {
  accountHealth: (healthScore: number): AlertResult => ({
    triggered: healthScore < 50,
    ruleKey: 'account_health',
    action: 'notify_admin',
    priority: 'critical',
    message: `Hesap sağlık skoru kritik seviyede: %${healthScore}. Otomasyon duraklatılabilir.`
  }),

  publishFailure: (retryCount: number): AlertResult => ({
    triggered: retryCount >= 3,
    ruleKey: 'publish_failure',
    action: 'pause_account',
    priority: 'high',
    message: `Gönderi yayınlama 3 kez başarısız oldu. Hesap koruma moduna alındı.`
  }),

  rateLimitHit: (limitUsagePct: number): AlertResult => ({
    triggered: limitUsagePct >= 0.9,
    ruleKey: 'rate_limit_hit',
    action: 'reduce_speed',
    priority: 'medium',
    message: `Instagram saatlik işlem limiti %90'a ulaştı. İşlem hızları düşürülüyor.`
  }),

  engagementDrop: (currentRate: number, previousRate: number): AlertResult => {
    const drop = (previousRate - currentRate) / (previousRate || 1);
    return {
      triggered: drop > 0.3,
      ruleKey: 'engagement_drop',
      action: 'notify_creator',
      priority: 'medium',
      message: `Etkileşim oranında %${Math.round(drop * 100)} düşüş tespit edildi.`
    };
  }
};


