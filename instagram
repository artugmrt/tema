  /**
   * Scans all accounts to ensure no two accounts share the same proxy IP
   */
  detectIpCollisions(accounts: Account[]): IpCollisionReport {
    const ipMap: Record<string, string[]> = {};

    for (const acc of accounts) {
      if (acc.proxyConfig?.ip && acc.proxyConfig.ip !== '127.0.0.1') {
        const ip = acc.proxyConfig.ip;
        if (!ipMap[ip]) {
          ipMap[ip] = [];
        }
        ipMap[ip].push(acc.displayName);
      }
    }

    for (const [ip, names] of Object.entries(ipMap)) {
      if (names.length > 1) {
        return {
          hasCollision: true,
          collidingIp: ip,
          affectedAccounts: names,
          warningMessage: `⚠️ KRİTİK IP ÇAKIŞMASI: ${names.join(' ve ')} hesapları aynı çıkış IP'sini (${ip}) paylaşıyor! Instagram hesap zincirleme cezası (Account Linking Ban) riski.`
        };
      }
    }

    return {
      hasCollision: false,
      affectedAccounts: []
    };
  },

