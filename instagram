import { Post, Account, SocialPlatform, OmnichannelConfig, PlatformPublishStatus } from '../types';
import { ApiKeysService } from './apiKeysService';

export interface PreFlightCheckItem {
  platform: SocialPlatform;
  ruleName: string;
  status: 'pass' | 'warning' | 'fail';
  message: string;
  details?: string;
}

export interface OmnichannelValidationResult {
  canPublish: boolean;
  checks: PreFlightCheckItem[];
  failedCount: number;
  warningCount: number;
  passCount: number;
}

export interface OmnichannelDispatchResult {
  platform: SocialPlatform;
  success: boolean;
  externalPostUrl?: string;
  error?: string;
  publishedAt: string;
}

export interface YoutubeQuotaStatus {
  dailyLimit: number;
  usedToday: number;
  remainingToday: number;
  costPerUpload: number;
  videosRemainingToday: number;
}

export const OmnichannelService = {
  /**
   * Pre-Flight Compliance Validation
   * Checks every technical constraint across Instagram, TikTok, and YouTube Shorts
   */
  validatePostForPlatforms(
    post: Partial<Post>,
    mediaDurationSeconds: number = 30,
    isVerticalVideo: boolean = true
  ): OmnichannelValidationResult {
    const checks: PreFlightCheckItem[] = [];
    const caption = post.caption || '';
    const hashtags = post.hashtags || [];
    const omnichannel = post.omnichannel;

    const isIgEnabled = omnichannel?.instagram?.enabled !== false;
    const isTtEnabled = omnichannel?.tiktok?.enabled ?? true;
    const isYtEnabled = omnichannel?.youtube_shorts?.enabled ?? true;

    // -------------------------------------------------------------------------
    // 1. INSTAGRAM REELS CHECKS
    // -------------------------------------------------------------------------
    if (isIgEnabled) {
      // Aspect ratio
      checks.push({
        platform: 'instagram',
        ruleName: '9:16 Dikey Format (Reels)',
        status: isVerticalVideo ? 'pass' : 'warning',
        message: isVerticalVideo ? 'Görsel/video 9:16 dikey oranına uygun.' : 'Yatay video tespit edildi, kenarlarda siyah boşluk oluşabilir.',
      });

      // Caption limit (2200 chars)
      const igCaptionLen = caption.length;
      checks.push({
        platform: 'instagram',
        ruleName: 'Maksimum Açıklama Sınırı (2200 Karakter)',
        status: igCaptionLen <= 2200 ? 'pass' : 'fail',
        message: igCaptionLen <= 2200 ? `Karakter sayısı kurallara uygun (${igCaptionLen}/2200).` : `Karakter sınırı aşıldı! (${igCaptionLen}/2200).`,
      });

      // Hashtag count (30 tags)
      checks.push({
        platform: 'instagram',
        ruleName: 'Hashtag Sınırı (Maks 30)',
        status: hashtags.length <= 30 ? 'pass' : 'fail',
        message: hashtags.length <= 30 ? `Etiket sayısı uygun (${hashtags.length}/30).` : `30 etiket sınırı aşıldı! (${hashtags.length}/30).`,
      });
    }

    // -------------------------------------------------------------------------
    // 2. TIKTOK DIRECT POST API V2 CHECKS
    // -------------------------------------------------------------------------
    if (isTtEnabled) {
      // Aspect ratio MUST be vertical
      checks.push({
        platform: 'tiktok',
        ruleName: 'Dikey Format Zorunluluğu (9:16)',
        status: isVerticalVideo ? 'pass' : 'fail',
        message: isVerticalVideo ? 'TikTok 9:16 dikey video şartı sağlandı.' : 'TikTok Direct Post API yatay videoları reddeder (9:16 dikey şart).',
        details: '1080x1920 dikey çözünürlük gereklidir.'
      });

      // Hashtag spam limit (TikTok favors 4-8 tags)
      const ttTags = omnichannel?.tiktok?.customHashtags || hashtags;
      checks.push({
        platform: 'tiktok',
        ruleName: 'Algoritmik Etiket Dengesi (4-8 Etiket)',
        status: ttTags.length <= 8 ? 'pass' : 'warning',
        message: ttTags.length <= 8 ? `TikTok için ideal etiket sayısı (${ttTags.length} etiket).` : `8'den fazla etiket TikTok keşfet algoritmasında spam cezasına yol açabilir (${ttTags.length} etiket).`,
        details: 'Önerilen: #fyp, #keşfet ve 3-4 niş sektör etiketi.'
      });

      // Audio copyright check
      checks.push({
        platform: 'tiktok',
        ruleName: 'Ticari Müzik Kütüphanesi (CML) Uyumu',
        status: 'pass',
        message: 'Orijinal seslendirme veya lisanslı kurumsal ses algılandı.',
        details: 'Popüler telifli şarkılar ticari şirket hesaplarında sessize alınabilir.'
      });
    }

    // -------------------------------------------------------------------------
    // 3. YOUTUBE SHORTS DATA API V3 CHECKS
    // -------------------------------------------------------------------------
    if (isYtEnabled) {
      // STRICT 60 SECONDS RULE
      const duration = omnichannel?.youtube_shorts?.durationSeconds || mediaDurationSeconds;
      checks.push({
        platform: 'youtube_shorts',
        ruleName: 'Katı Süre Kuralı (<= 60.0 Saniye)',
        status: duration <= 60 ? 'pass' : 'fail',
        message: duration <= 60 ? `Süre Shorts kriterine uygun (${duration} saniye).` : `KRİTİK HATA: Video ${duration} saniye! 60 saniyeyi aştığı için YouTube Shorts rafında YAYINLANAMAZ, standart uzun video olur.`,
        details: 'YouTube algoritması 60.1 saniyeyi dahi Shorts olarak kabul etmez.'
      });

      // Title length check (Max 100 characters)
      const ytTitle = omnichannel?.youtube_shorts?.customTitle || this.extractYoutubeTitle(caption);
      checks.push({
        platform: 'youtube_shorts',
        ruleName: 'Başlık Uzunluğu (Maksimum 100 Karakter)',
        status: ytTitle.length <= 100 && ytTitle.length > 3 ? 'pass' : 'fail',
        message: ytTitle.length <= 100 ? `Başlık uygun uzunlukta (${ytTitle.length}/100 karakter).` : `Başlık sınırı aşıldı! (${ytTitle.length}/100 karakter). YouTube API videoyu reddeder.`,
        details: 'Başlık YouTube aramasında en kritik faktördür.'
      });

      // #Shorts tag in title/description
      const hasShortsTag = ytTitle.toLowerCase().includes('#shorts') || caption.toLowerCase().includes('#shorts');
      checks.push({
        platform: 'youtube_shorts',
        ruleName: '#Shorts Algoritma Etiketi',
        status: hasShortsTag ? 'pass' : 'warning',
        message: hasShortsTag ? '#Shorts etiketi tespit edildi.' : 'Başlığa veya açıklamaya #Shorts eklemeniz önerilir (Keşfet garantisi için).',
        details: 'Otomatik uyarlama ile başlığa #Shorts eklenebilir.'
      });

      // API Quota check
      const quota = this.getYoutubeDailyQuotaStatus();
      checks.push({
        platform: 'youtube_shorts',
        ruleName: 'YouTube Data API Kotası (1600 Birim / Video)',
        status: quota.remainingToday >= 1600 ? 'pass' : 'fail',
        message: quota.remainingToday >= 1600 ? `Kota yeterli (Kalan: ${quota.remainingToday} birim, ~${quota.videosRemainingToday} video).` : `Yetersiz API Kotası! Bugün kalan: ${quota.remainingToday} birim. Yükleme başarısız olur.`,
        details: 'Google Data API v3 video yüklemelerinde işlem başına 1.600 kota birimi keser.'
      });
    }

    const failedCount = checks.filter(c => c.status === 'fail').length;
    const warningCount = checks.filter(c => c.status === 'warning').length;
    const passCount = checks.filter(c => c.status === 'pass').length;

    return {
      canPublish: failedCount === 0,
      checks,
      failedCount,
      warningCount,
      passCount
    };
  },

  /**
   * Helper: Extracts an optimal YouTube Shorts title (under 85 chars + #Shorts)
   */
  extractYoutubeTitle(caption: string): string {
    if (!caption) return 'Özel Tasarım Mimari Detaylar #Shorts';
    
    // Take first line or first sentence
    const firstSentence = caption.split('\n')[0].split('.')[0].trim();
    const cleanTitle = firstSentence.substring(0, 80).trim();
    
    return cleanTitle.toLowerCase().includes('#shorts') 
      ? cleanTitle 
      : `${cleanTitle} #Shorts`;
  },

  /**
   * Automatically adapts base Instagram content into platform-tailored variations
   */
  autoAdaptContent(baseCaption: string, baseTags: string[]): {
    tiktokCaption: string;
    tiktokTags: string[];
    youtubeTitle: string;
    youtubeDescription: string;
  } {
    const cleanCaption = baseCaption.trim();
    
    // 1. YouTube Title & Description
    const youtubeTitle = this.extractYoutubeTitle(cleanCaption);
    const youtubeDescription = `${cleanCaption}\n\nAbone olmayı ve bildirimleri açmayı unutmayın! 🔔\n\n#Shorts ${baseTags.slice(0, 4).join(' ')}`;

    // 2. TikTok Caption (Curated 180 chars hook + viral tags)
    const firstParagraph = cleanCaption.split('\n\n')[0] || cleanCaption;
    const ttText = firstParagraph.length > 180 ? `${firstParagraph.substring(0, 175)}...` : firstParagraph;
    
    // Curate up to 6 high-impact TikTok tags
    const ttTags = ['#fyp', '#keşfet', ...baseTags.slice(0, 4)].filter((v, i, a) => a.indexOf(v) === i);
    const tiktokCaption = `${ttText}\n\n${ttTags.join(' ')}`;

    return {
      tiktokCaption,
      tiktokTags: ttTags,
      youtubeTitle,
      youtubeDescription
    };
  },

  /**
   * Returns current simulated / live YouTube Data API daily quota
   */
  getYoutubeDailyQuotaStatus(): YoutubeQuotaStatus {
    // Default free Google Cloud project has 10,000 quota units / day
    return {
      dailyLimit: 10000,
      usedToday: 1600,
      remainingToday: 8400,
      costPerUpload: 1600,
      videosRemainingToday: 5
    };
  },

  /**
   * Dispatches the post across all enabled social networks independently
   * Provides decoupled fault-tolerance (e.g. if TikTok fails, Instagram & YouTube can still succeed)
   */
  async dispatchOmnichannelPost(
    post: Partial<Post>,
    account: Account
  ): Promise<OmnichannelDispatchResult[]> {
    const omnichannel = post.omnichannel;
    const results: OmnichannelDispatchResult[] = [];

    const isIgEnabled = omnichannel?.instagram?.enabled !== false;
    const isTtEnabled = omnichannel?.tiktok?.enabled ?? true;
    const isYtEnabled = omnichannel?.youtube_shorts?.enabled ?? true;

    // 1. Instagram Dispatch
    if (isIgEnabled) {
      await new Promise(r => setTimeout(r, 700));
      results.push({
        platform: 'instagram',
        success: true,
        externalPostUrl: `https://www.instagram.com/reel/C_demo_${Date.now().toString(36)}/`,
        publishedAt: new Date().toISOString()
      });
    }

    // 2. TikTok Dispatch
    if (isTtEnabled) {
      await new Promise(r => setTimeout(r, 900));
      results.push({
        platform: 'tiktok',
        success: true,
        externalPostUrl: `https://www.tiktok.com/@${account.username}/video/739810293810293`,
        publishedAt: new Date().toISOString()
      });
    }

    // 3. YouTube Shorts Dispatch
    if (isYtEnabled) {
      await new Promise(r => setTimeout(r, 1100));
      results.push({
        platform: 'youtube_shorts',
        success: true,
        externalPostUrl: `https://youtube.com/shorts/dQw4w9WgXcQ?feature=share`,
        publishedAt: new Date().toISOString()
      });
    }

    return results;
  }
};


