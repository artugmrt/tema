import { Post, Account, PostType } from '../types';

export type ViolationType = 
  | 'TIME_COLLISION' 
  | 'DAILY_LIMIT' 
  | 'SAFE_WINDOW' 
  | 'REELS_FATIGUE';

export interface ScheduleViolation {
  type: ViolationType;
  title: string;
  description: string;
  severity: 'block' | 'warn';
  conflictingPostTitle?: string;
}

export interface ConflictEvaluation {
  hasViolation: boolean;
  severity: 'block' | 'warn' | 'safe';
  violations: ScheduleViolation[];
  suggestedTimeIso: string;
  suggestedTimeFormatted: string;
}

export const ScheduleConflictGuardService = {
  /**
   * Evaluates whether moving a post to targetDateIso causes collisions or rule breaches
   */
  evaluateSchedule(
    postId: string,
    targetDateIso: string,
    allPosts: Post[],
    account: Account
  ): ConflictEvaluation {
    const violations: ScheduleViolation[] = [];
    const targetTime = new Date(targetDateIso).getTime();
    const targetDate = new Date(targetDateIso);

    const postToMove = allPosts.find(p => p.id === postId);
    const postType = postToMove?.type || 'feed';

    // Other posts belonging to this account (excluding the moving post itself)
    const otherPosts = allPosts.filter(p => p.id !== postId && p.accountId === account.id);

    // 1. Check exact time collision (within 45 minutes)
    const COLLISION_WINDOW_MS = 45 * 60 * 1000;
    const collidingPost = otherPosts.find(p => {
      const pTime = new Date(p.scheduledAt || p.publishedAt || 0).getTime();
      return Math.abs(pTime - targetTime) <= COLLISION_WINDOW_MS;
    });

    if (collidingPost) {
      const pDate = new Date(collidingPost.scheduledAt || collidingPost.publishedAt || 0);
      const timeStr = pDate.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
      violations.push({
        type: 'TIME_COLLISION',
        title: 'Zaman Çakışması (Algoritma Kanibalizasyonu)',
        description: `Bu saat diliminde (${timeStr}) zaten başka bir gönderi planlanmış. 45 dakikadan az arayla paylaşılan gönderiler birbirinin erişimini (%40'a kadar) düşürür.`,
        severity: 'block',
        conflictingPostTitle: collidingPost.caption.slice(0, 45) + '...'
      });
    }

    // 2. Check Daily Post Limit (Safe Threshold: 3 posts/day per account)
    const sameDayPosts = otherPosts.filter(p => {
      const pDate = new Date(p.scheduledAt || p.publishedAt || 0);
      return (
        pDate.getFullYear() === targetDate.getFullYear() &&
        pDate.getMonth() === targetDate.getMonth() &&
        pDate.getDate() === targetDate.getDate()
      );
    });

    if (sameDayPosts.length >= 3) {
      violations.push({
        type: 'DAILY_LIMIT',
        title: 'Günlük Güvenli Aksiyon Eşiği Aşıldı',
        description: `Bu gün için planlanan gönderi sayısı ${sameDayPosts.length + 1} adede ulaşıyor. Günde 3'ten fazla gönderi bot/spam koruma filtrelerine takılabilir.`,
        severity: 'warn'
      });
    }

    // 3. Safe Time Window Violation (e.g. 09:00 - 23:00)
    const targetHour = targetDate.getHours();
    if (targetHour < 8 || targetHour >= 23) {
      violations.push({
        type: 'SAFE_WINDOW',
        title: 'İnsan Çalışma Saatleri Dışı (Gece Yayını)',
        description: `Hedeflenen saat (${targetHour.toString().padStart(2, '0')}:${targetDate.getMinutes().toString().padStart(2, '0')}) hesabın doğal insan yayın penceresi (09:00 - 23:00) dışındadır.`,
        severity: 'warn'
      });
    }

    // 4. Reels Fatigue (Minimum 3 hours between consecutive Reels)
    if (postType === 'reel') {
      const REELS_GAP_MS = 3 * 60 * 60 * 1000;
      const nearbyReel = sameDayPosts.find(p => {
        if (p.type !== 'reel') return false;
        const pTime = new Date(p.scheduledAt || p.publishedAt || 0).getTime();
        return Math.abs(pTime - targetTime) < REELS_GAP_MS;
      });

      if (nearbyReel) {
        violations.push({
          type: 'REELS_FATIGUE',
          title: 'Ardışık Reels Yorgunluğu (Reels Fatigue)',
          description: 'Aynı gün içinde 3 saatten kısa aralıkla iki Reels paylaşmak algoritmanın videoyu Keşfet test havuzuna almasını zorlaştırır.',
          severity: 'warn',
          conflictingPostTitle: nearbyReel.caption.slice(0, 45) + '...'
        });
      }
    }

    // Calculate smart alternative time slot
    const safeSlot = this.findNextSafeSlot(targetDate, otherPosts, account.id, postType);

    const hasBlock = violations.some(v => v.severity === 'block');
    const hasWarn = violations.length > 0;

    return {
      hasViolation: violations.length > 0,
      severity: hasBlock ? 'block' : hasWarn ? 'warn' : 'safe',
      violations,
      suggestedTimeIso: safeSlot.iso,
      suggestedTimeFormatted: safeSlot.formatted
    };
  },

  /**
   * Scans target day hours (10:00 to 21:00) for the optimum non-colliding slot
   */
  findNextSafeSlot(
    targetDate: Date,
    existingPosts: Post[],
    accountId: string,
    postType: PostType
  ): { iso: string; formatted: string } {
    // Ideal hours based on Instagram engagement peaks: 18:30, 20:45, 12:15, 15:30, 10:00
    const candidateHours = [
      { h: 18, m: 30 },
      { h: 20, m: 45 },
      { h: 12, m: 15 },
      { h: 15, m: 30 },
      { h: 10, m: 0 },
      { h: 21, m: 30 }
    ];

    const COLLISION_WINDOW_MS = 45 * 60 * 1000;

    for (const cand of candidateHours) {
      const candidateDate = new Date(
        targetDate.getFullYear(),
        targetDate.getMonth(),
        targetDate.getDate(),
        cand.h,
        cand.m,
        0
      );
      const candMs = candidateDate.getTime();

      const hasCollision = existingPosts.some(p => {
        const pMs = new Date(p.scheduledAt || p.publishedAt || 0).getTime();
        return Math.abs(pMs - candMs) <= COLLISION_WINDOW_MS;
      });

      if (!hasCollision) {
        const timeStr = `${cand.h.toString().padStart(2, '0')}:${cand.m.toString().padStart(2, '0')}`;
        const dateStr = candidateDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' });
        return {
          iso: candidateDate.toISOString(),
          formatted: `${dateStr} • Saat ${timeStr} (Optimum Zirve)`
        };
      }
    }

    // Fallback: 2 hours after target
    const fallback = new Date(targetDate.getTime() + 2 * 60 * 60 * 1000);
    return {
      iso: fallback.toISOString(),
      formatted: `${fallback.toLocaleDateString('tr-TR')} • Saat ${fallback.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}`
    };
  }
};


