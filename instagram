  /**
   * Tests live connection to Supabase database
   */
  async testConnection(url: string, anonKey: string): Promise<{ success: boolean; latencyMs: number; message: string; tableCount?: number }> {
    const startTime = Date.now();

    if (!url || !anonKey || anonKey.trim().length < 10) {
      return {
        success: false,
        latencyMs: 0,
        message: 'Lütfen geçerli bir Supabase Project URL ve Anon Key girin.'
      };
    }

    try {
      const client = createClient(url, anonKey);
      const { error } = await client.from('accounts').select('id').limit(1);

      const latencyMs = Date.now() - startTime;

      if (error && error.code !== 'PGRST116' && !error.message.includes('relation "public.accounts" does not exist')) {
        return {
          success: false,
          latencyMs,
          message: `Supabase Hatası: ${error.message} (Kod: ${error.code})`
        };
