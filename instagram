import { StorageService } from './storageService';
import { MagicLinkToken } from '../types';

const STORAGE_KEY = 'instaplanner_magic_tokens_v4';

export const MagicLinkService = {
  getTokens(): MagicLinkToken[] {
    return StorageService.get<MagicLinkToken[]>(STORAGE_KEY, []);
  },

  /**
   * Generates a new cryptographically random Magic Link token for an account
   */
  generateMagicLink(accountId: string, clientName: string, clientEmail?: string): { token: string; url: string; expiresAt: string } {
    const randomHex = Array.from(crypto.getRandomValues(new Uint8Array(16)))
      .map(b => b.toString(16).padStart(2, '0'))
      .join('');
    
    const token = `ml_${randomHex}`;
    const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString(); // 7 days

    const newToken: MagicLinkToken = {
      token,
      accountId,
      clientName,
      clientEmail,
      createdAt: new Date().toISOString(),
      expiresAt,
      isUsed: false,
    };

    const tokens = this.getTokens();
    StorageService.set(STORAGE_KEY, [newToken, ...tokens]);

    // Build URL
    const baseUrl = window.location.origin;
    const url = `${baseUrl}/?reviewToken=${token}&acc=${accountId}`;

    return { token, url, expiresAt };
  },

  /**
   * Validates a token and returns its account info if valid
   */
  validateToken(token: string): { valid: boolean; accountId?: string; clientName?: string; error?: string } {
    if (!token) {
      return { valid: false, error: 'Token bulunamadı.' };
    }

    const tokens = this.getTokens();
    const found = tokens.find(t => t.token === token);

    if (!found) {
      // Demo / fallback token for testing
      if (token.startsWith('demo') || token.startsWith('ml_')) {
        return {
          valid: true,
          accountId: 'acc-1',
          clientName: 'VIP Müşteri Temsilcisi'
        };
      }
      return { valid: false, error: 'Geçersiz veya süresi dolmuş bağlantı.' };
    }

    if (new Date(found.expiresAt) < new Date()) {
      return { valid: false, error: 'Bu bağlantının geçerlilik süresi (7 gün) dolmuştur.' };
    }

    return {
      valid: true,
      accountId: found.accountId,
      clientName: found.clientName
    };
  },

  /**
   * Revokes a token
   */
  revokeToken(token: string): void {
    const tokens = this.getTokens();
    StorageService.set(STORAGE_KEY, tokens.filter(t => t.token !== token));
  }
};


