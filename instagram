import { ApiKeysService } from './apiKeysService';
import { Post, Account } from '../types';

export type NotificationEventType = 
  | 'POST_SUBMITTED_FOR_REVIEW'
  | 'POST_APPROVED'
  | 'POST_PUBLISHED'
  | 'KILL_SWITCH_ENGAGED'
  | 'RISK_ALERT'
  | 'CRISIS_COMMENT_ALERT'
  | 'VIP_LEAD_ALERT';

export interface NotificationPayload {
  type: NotificationEventType;
  post?: Partial<Post>;
  account?: Partial<Account>;
  customMessage?: string;
  commentAuthor?: string;
  commentText?: string;
}

export const NotificationDispatcherService = {
  /**
   * Dispatches a notification across all enabled channels (Telegram, Slack, Browser Push)
   */
  async dispatchNotification(payload: NotificationPayload): Promise<{
    telegramSent: boolean;
    slackSent: boolean;
    browserSent: boolean;
  }> {
    const config = ApiKeysService.getConfig() as any;

    const results = {
      telegramSent: false,
      slackSent: false,
      browserSent: false
    };

    const textMessage = this.formatTextMessage(payload);

    // 1. Telegram Dispatch
    if (config.telegramEnabled && config.telegramBotToken && config.telegramChatId) {
      try {
        const tgOk = await this.sendTelegramMessage(
          config.telegramBotToken, 
          config.telegramChatId, 
          this.formatTelegramHtml(payload)
        );
        results.telegramSent = tgOk;
      } catch (e) {
        console.warn('Telegram bildirim hatası:', e);
      }
    }

    // 2. Slack Dispatch
    if (config.slackEnabled && config.slackWebhookUrl) {
      try {
        const slackOk = await this.sendSlackWebhook(
          config.slackWebhookUrl,
          this.formatSlackBlocks(payload)
        );
        results.slackSent = slackOk;
      } catch (e) {
        console.warn('Slack bildirim hatası:', e);
      }
    }

    // 3. Browser Native Push
    if (config.browserPushEnabled !== false && typeof window !== 'undefined' && 'Notification' in window) {
      if (Notification.permission === 'granted') {
        new Notification('InstaPlanner AGENTIC Bildirimi', {
          body: textMessage,
          icon: '/icons/icon48.svg'
        });
        results.browserSent = true;
      }
    }

    return results;
  },

  /**
   * Formats plain text summary
   */
  formatTextMessage(payload: NotificationPayload): string {
    const accName = payload.account?.displayName || 'İlgili Marka';
    switch (payload.type) {
      case 'POST_SUBMITTED_FOR_REVIEW':
        return `⏳ [Onay Bekliyor] ${accName} hesabının yeni gönderisi onayınıza sunuldu.`;
      case 'POST_APPROVED':
        return `✅ [Onaylandı] ${accName} gönderisi onaylandı ve yayın kuyruğuna alındı.`;
      case 'POST_PUBLISHED':
        return `🚀 [Yayınlandı] ${accName} gönderisi Instagram'da başarıyla paylaşıldı!`;
      case 'KILL_SWITCH_ENGAGED':
        return `🚨 [ACİL DURUM] İnsan motoru Kill Switch devreye alındı! Tüm yayınlar donduruldu.`;
      case 'RISK_ALERT':
        return `⚠️ [Güvenlik Uyarısı] ${accName} hesap sağlık skoru düştü.`;
      case 'CRISIS_COMMENT_ALERT':
        return `🚨 [KRİZ ALARMI] @${payload.commentAuthor || 'kullanıcı'}: "${payload.commentText || ''}"`;
      case 'VIP_LEAD_ALERT':
        return `🔥 [VIP MÜŞTERİ] @${payload.commentAuthor || 'kullanıcı'}: "${payload.commentText || ''}"`;
      default:
        return payload.customMessage || 'InstaPlanner sistem bildirimi.';
    }
  },

  /**
   * Formats rich HTML message for Telegram
   */
  formatTelegramHtml(payload: NotificationPayload): string {
    const acc = payload.account;
    const post = payload.post;
    const dateStr = post?.scheduledAt ? new Date(post.scheduledAt).toLocaleString('tr-TR') : 'Belirtilmedi';

    switch (payload.type) {
      case 'POST_SUBMITTED_FOR_REVIEW':
        return `<b>⏳ YENİ İÇERİK ONAY BEKLİYOR</b>\n\n` +
               `<b>Marka:</b> ${acc?.displayName || 'Marka'} (@${acc?.username || 'hesap'})\n` +
               `<b>Format:</b> ${(post?.type || 'feed').toUpperCase()}\n` +
               `<b>Planlanan Tarih:</b> ${dateStr}\n` +
               `<b>Slot Skoru:</b> %${post?.bestTimeScore || 90}\n\n` +
               `<b>Kanca:</b> <i>"${post?.caption ? post.caption.substring(0, 150) : ''}..."</i>\n\n` +
               `👉 <a href="${window.location.origin}/?reviewToken=demo_token">Magic Link ile İncele & Onayla</a>`;

      case 'POST_APPROVED':
        return `<b>✅ GÖNDERİ ONAYLANDI</b>\n\n` +
               `<b>Marka:</b> ${acc?.displayName}\n` +
               `<b>Durum:</b> Yayına Hazır / Kuyrukta\n` +
               `<b>Hedef Saat:</b> ${dateStr}\n\n` +
