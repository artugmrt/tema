                          <span>{w}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}

            </div>
          )}

          {/* TAB 2: HARDWARE FINGERPRINT SPOOFER */}
          {activeTab === 'fingerprint' && (
            <div className="space-y-5 animate-fade-in">
              <div className="flex items-center justify-between">
