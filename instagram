  return (
    <motion.button
      type={type}
      whileHover={!disabled ? { scale: 1.03 } : undefined}
      whileTap={!disabled ? { scale: 0.97 } : undefined}
      transition={{ type: 'spring', stiffness: 400, damping: 17 }}
      className={`px-4 py-2 rounded-xl transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed ${variantStyles[variant]} ${className}`}
      onClick={onClick}
      disabled={disabled}
    >
      {children}
    </motion.button>
  );
};

// 3. Loading Spinner
export const LoadingSpinner: React.FC<{ size?: number; color?: 'gold' | 'teal' }> = ({ 
  size = 24, 
  color = 'gold' 
}) => {
  const borderTopColor = color === 'gold' ? '#E8B765' : '#54E0C8';
  return (
    <motion.div
      animate={{ rotate: 360 }}
      transition={{ duration: 0.9, repeat: Infinity, ease: 'linear' }}
      style={{
        width: `${size}px`,
        height: `${size}px`,
        border: '2px solid rgba(255, 255, 255, 0.15)',
        borderTop: `2px solid ${borderTopColor}`,
        borderRadius: '50%',
        display: 'inline-block'
      }}
    />
  );
};

// 4. Progress Bar Animation
export const AnimatedProgress: React.FC<{ value: number; className?: string }> = ({ value, className = '' }) => {
  return (
    <div className={`w-full bg-[#141824] rounded-full h-2 overflow-hidden border border-[#23293D] ${className}`}>
      <motion.div
        initial={{ width: 0 }}
        animate={{ width: `${Math.min(Math.max(value, 0), 100)}%` }}
        transition={{ duration: 0.8, ease: 'easeOut' }}
        className="h-full bg-gradient-to-r from-[#E8B765] to-[#54E0C8] rounded-full"
      />
    </div>
  );
};

// 5. Animated Number Counter
export const AnimatedCounter: React.FC<{ value: number; prefix?: string; suffix?: string }> = ({ 
  value, 
  prefix = '', 
  suffix = '' 
}) => {
  const [displayValue, setDisplayValue] = useState(0);
  
  useEffect(() => {
    const duration = 800;
    const steps = 40;
    const increment = (value - displayValue) / steps;
    let currentStep = 0;
    
    const interval = setInterval(() => {
      currentStep++;
      setDisplayValue(prev => prev + increment);
      
      if (currentStep >= steps) {
        setDisplayValue(value);
        clearInterval(interval);
      }
    }, duration / steps);
    
    return () => clearInterval(interval);
  }, [value]);
  
  return (
    <span className="font-mono">
      {prefix}{Math.round(displayValue).toLocaleString()}{suffix}
    </span>
  );
};

// 6. Skeleton Loader
export const SkeletonLoader: React.FC<{ className?: string }> = ({ className = 'h-16 w-full' }) => {
  return (
    <div className={`skeleton rounded-xl ${className}`} />
  );
};

// 7. Page Transition
export const PageTransition: React.FC<{ 
  children: React.ReactNode; 
  pageKey?: string; 
  className?: string;
}> = ({ children, pageKey = 'page', className = '' }) => {
  return (
    <AnimatePresence mode="wait">
      <motion.div
        key={pageKey}
        initial={{ opacity: 0, y: 15 }}
        animate={{ opacity: 1, y: 0 }}
        exit={{ opacity: 0, y: -15 }}
        transition={{ duration: 0.25, ease: 'easeInOut' }}
        className={`flex-1 w-full flex flex-col overflow-hidden min-h-0 relative ${className}`}
      >
        {children}
      </motion.div>
    </AnimatePresence>
  );
};

// 8. Toast Notification Animation
export const ToastNotification: React.FC<{ 
  message: string; 
  type?: 'success' | 'warning' | 'error' | 'info';
  onClose?: () => void;
}> = ({ message, type = 'success', onClose }) => {
  const typeColors = {
    success: 'border-[#10B981] bg-[#10B981]/15 text-[#34D399]',
    warning: 'border-[#F59E0B] bg-[#F59E0B]/15 text-[#FBBF24]',
    error: 'border-[#F43F5E] bg-[#F43F5E]/15 text-[#FB7185]',
    info: 'border-[#54E0C8] bg-[#54E0C8]/15 text-[#7EE8D6]',
  };

  return (
    <motion.div
      initial={{ opacity: 0, x: 50, scale: 0.9 }}
      animate={{ opacity: 1, x: 0, scale: 1 }}
      exit={{ opacity: 0, x: 50, scale: 0.9 }}
      transition={{ type: 'spring', stiffness: 350, damping: 25 }}
      className={`fixed bottom-6 right-6 z-50 px-4 py-3 rounded-xl border backdrop-blur-xl shadow-2xl flex items-center gap-3 ${typeColors[type]}`}
      onClick={onClose}
    >
      <span className="text-sm font-medium">{message}</span>
    </motion.div>
  );
};


