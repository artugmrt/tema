import React, { useState } from 'react';
import { Modal } from '../common/Modal';
import { Button } from '../common/Button';
import { useNavigation } from '../../context/NavigationContext';
import { useApp } from '../../context/AppContext';
import { Users2, ShieldCheck, Sparkles, RefreshCw, CheckCircle2 } from '@animated-color-icons/lucide-react';
import { INITIAL_TONE_PRESETS } from '../../services/defaultData';
import { InstagramExtService, InstagramProfileData } from '../../services/instagramExtService';

export const AddAccountModal: React.FC = () => {
  const { isAddAccountOpen, setIsAddAccountOpen } = useNavigation();
  const { addAccount, brandFolders } = useApp();

  const [username, setUsername] = useState('');
  const [displayName, setDisplayName] = useState('');
  const [avatar, setAvatar] = useState('https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150');
  const [category, setCategory] = useState('Lüks Gayrimenkul');
  const [brandFolderId, setBrandFolderId] = useState(brandFolders[0]?.id || 'folder-default');
  const [brandTonePresetId, setBrandTonePresetId] = useState('tone-luxury');
  const [startTime, setStartTime] = useState('09:00');
  const [endTime, setEndTime] = useState('22:30');

  const [isFetchingProfile, setIsFetchingProfile] = useState(false);
  const [fetchedData, setFetchedData] = useState<InstagramProfileData | null>(null);
  const [fetchStatusMessage, setFetchStatusMessage] = useState<string | null>(null);

  const handleFetchFromInstagram = async () => {
    const clean = username.replace('@', '').trim();
    if (!clean) return;

    setIsFetchingProfile(true);
    setFetchStatusMessage('Instagram API üzerinden profil verileri alınıyor...');

    const result = await InstagramExtService.fetchProfileInfo(clean);
    setIsFetchingProfile(false);

    if (result.success && result.data) {
      setFetchedData(result.data);
      if (result.data.displayName) setDisplayName(result.data.displayName);
      if (result.data.avatarUrl) setAvatar(result.data.avatarUrl);
      if (result.data.category && result.data.category !== 'Genel') setCategory(result.data.category);
      setFetchStatusMessage(`✅ Gerçek profil doğrulandı: ${result.data.followerCount.toLocaleString('tr-TR')} Takipçi, ${result.data.postCount} Gönderi`);
    } else {
      setFetchStatusMessage(`⚠️ ${result.error || 'Profil çekilemedi (Web kısıtı). Manuel değerlerle devam edebilirsiniz.'}`);
    }
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    const cleanUsername = username.replace('@', '').trim();
    if (!cleanUsername || !displayName.trim()) return;

    let profile = fetchedData;
    if (!profile) {
      setIsFetchingProfile(true);
      const res = await InstagramExtService.fetchProfileInfo(cleanUsername);
      setIsFetchingProfile(false);
      if (res.success && res.data) {
        profile = res.data;
      }
    }

    addAccount({
      username: cleanUsername,
      displayName: profile?.displayName || displayName.trim(),
      avatar: profile?.avatarUrl || avatar,
      category: profile?.category || category,
      brandFolderId,
      followerCount: profile?.followerCount ?? Math.floor(Math.random() * 20000 + 5000),
      followingCount: profile?.followingCount ?? 240,
      postCount: profile?.postCount ?? 42,
      riskLevel: 'safe',
      status: 'active',
      lastActionTime: 'Yeni bağlandı',
      dailyActionCount: 0,
      maxDailyActions: 6,
      safeTimeWindow: {
        start: startTime,
        end: endTime,
      },
      brandTonePresetId,
      isVerified: profile?.isVerified ?? false,
      teamMembers: [
        {
          userId: 'u-1',
          name: 'Murat Y.',
          avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=80',
          role: 'agency_admin',
          email: 'murat@ajans.io'
        }
      ]
    });

    setIsAddAccountOpen(false);
  };

  return (
    <Modal
      isOpen={isAddAccountOpen}
      onClose={() => setIsAddAccountOpen(false)}
      title={
        <div className="flex items-center gap-2 text-white">
          <Users2 className="w-5 h-5 text-gold-400" />
          <span>Yeni Instagram Hesabı Bağla</span>
        </div>
      }
      subtitle="Gerçek tarayıcı oturumuyla sıfır-risk güvenli hesap entegrasyonu."
      maxWidth="lg"
    >
      <form onSubmit={handleSubmit} className="space-y-4 text-xs">
        <div>
          <label className="block font-semibold text-void-300 mb-1 font-mono">
            Kullanıcı Adı (@):
          </label>
          <div className="flex gap-2">
            <input
              type="text"
              required
              placeholder="ornek.hesap"
              value={username}
              onChange={e => setUsername(e.target.value)}
              className="flex-1 bg-void-950 border border-void-700 rounded-xl px-3 py-2 text-void-200 focus:outline-none focus:border-gold-400 font-mono"
            />
            <Button
              type="button"
              variant="teal"
              size="sm"
              isLoading={isFetchingProfile}
              onClick={handleFetchFromInstagram}
              disabled={!username.trim()}
              className="shrink-0 text-[11px]"
            >
              <RefreshCw className="w-3.5 h-3.5 mr-1" />
              Verileri Çek
            </Button>
          </div>
          {fetchStatusMessage && (
            <p className="text-[11px] font-mono mt-1.5 text-void-300">
              {fetchStatusMessage}
            </p>
          )}
        </div>

        <div>
          <label className="block font-semibold text-void-300 mb-1 font-mono">
            Görünen İsim / Marka Başlığı:
          </label>
          <input
            type="text"
            required
            placeholder="Örn: Apex Prime Villa Portföyü"
            value={displayName}
            onChange={e => setDisplayName(e.target.value)}
            className="w-full bg-void-950 border border-void-700 rounded-xl px-3 py-2 text-void-200 focus:outline-none focus:border-gold-400"
          />
        </div>

        <div>
          <label className="block font-semibold text-void-300 mb-1 font-mono">
            Profil Fotoğrafı (URL):
          </label>
          <input
            type="text"
            value={avatar}
            onChange={e => setAvatar(e.target.value)}
            className="w-full bg-void-950 border border-void-700 rounded-xl px-3 py-2 text-void-200 focus:outline-none focus:border-gold-400 font-mono text-[11px]"
          />
        </div>

        <div className="grid grid-cols-2 gap-3">
          <div>
            <label className="block font-semibold text-void-300 mb-1 font-mono">Marka Klasörü:</label>
            <select
              value={brandFolderId}
              onChange={e => setBrandFolderId(e.target.value)}
              className="w-full bg-void-950 border border-void-700 rounded-xl px-2.5 py-2 text-void-200 focus:outline-none focus:border-gold-400"
            >
              {brandFolders.map(f => (
                <option key={f.id} value={f.id}>{f.name}</option>
              ))}
            </select>
          </div>

          <div>
            <label className="block font-semibold text-void-300 mb-1 font-mono">Marka AI Tonu:</label>
            <select
              value={brandTonePresetId}
              onChange={e => setBrandTonePresetId(e.target.value)}
              className="w-full bg-void-950 border border-void-700 rounded-xl px-2.5 py-2 text-void-200 focus:outline-none focus:border-gold-400"
            >
              {INITIAL_TONE_PRESETS.map(t => (
                <option key={t.id} value={t.id}>{t.emoji} {t.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div className="grid grid-cols-2 gap-3">
          <div>
            <label className="block font-semibold text-void-300 mb-1 font-mono">Güvenli Başlangıç:</label>
            <input
              type="time"
              value={startTime}
              onChange={e => setStartTime(e.target.value)}
              className="w-full bg-void-950 border border-void-700 rounded-xl px-2.5 py-2 text-void-200 font-mono focus:outline-none focus:border-gold-400"
            />
          </div>
          <div>
            <label className="block font-semibold text-void-300 mb-1 font-mono">Güvenli Bitiş:</label>
            <input
              type="time"
              value={endTime}
              onChange={e => setEndTime(e.target.value)}
              className="w-full bg-void-950 border border-void-700 rounded-xl px-2.5 py-2 text-void-200 font-mono focus:outline-none focus:border-gold-400"
            />
          </div>
        </div>

        <div className="p-3 rounded-xl bg-teal-950/40 border border-teal-500/30 flex items-center gap-2 text-teal-300 text-[11px] font-mono">
          <ShieldCheck className="w-4 h-4 shrink-0 text-teal-400" />
          <span>Hesap bağlantısında parmak izi gizlenmez, gerçek oturum korunur.</span>
        </div>

        <div className="flex justify-end gap-2 pt-3 border-t border-void-750">
          <Button variant="void" size="sm" type="button" onClick={() => setIsAddAccountOpen(false)}>
            İptal
          </Button>
          <Button variant="gold" size="sm" type="submit">
            Hesabı Ekle & Başlat
          </Button>
        </div>
      </form>
    </Modal>
  );
};


