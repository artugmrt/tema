    1: '19:30', 2: '18:30', 3: '19:15', 4: '20:00', 5: '21:00', 6: '14:00', 7: '19:45',
    8: '18:45', 9: '20:30', 10: '19:00', 11: '20:15', 12: '21:30', 13: '15:30', 14: '19:30',
    15: '18:30', 16: '20:00', 17: '19:15', 18: '21:00', 19: '16:00', 20: '19:00', 21: '18:45',
    22: '20:15', 23: '19:30', 24: '21:15', 25: '20:45', 26: '17:00', 27: '19:45', 28: '18:30',
    29: '20:00', 30: '19:15'
  };

  const getDaysInMonth = (year: number, month: number) => {
    const date = new Date(year, month, 1);
    const days: Array<{ date: Date; isCurrentMonth: boolean }> = [];
    
    let firstDayIndex = date.getDay();
    firstDayIndex = firstDayIndex === 0 ? 6 : firstDayIndex - 1;

    const prevMonthLastDay = new Date(year, month, 0).getDate();
    for (let i = firstDayIndex - 1; i >= 0; i--) {
      days.push({
        date: new Date(year, month - 1, prevMonthLastDay - i),
        isCurrentMonth: false,
      });
    }

    const lastDayCurrentMonth = new Date(year, month + 1, 0).getDate();
    for (let i = 1; i <= lastDayCurrentMonth; i++) {
      days.push({
        date: new Date(year, month, i),
        isCurrentMonth: true,
      });
    }

    const remaining = 35 - days.length > 0 ? 35 - days.length : 42 - days.length;
    for (let i = 1; i <= remaining; i++) {
      days.push({
        date: new Date(year, month + 1, i),
        isCurrentMonth: false,
      });
    }

    return days;
  };

  const calendarDays = getDaysInMonth(currentDate.getFullYear(), currentDate.getMonth());

  const prevMonth = () => {
    setCurrentDate(new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1));
  };

  const nextMonth = () => {
    setCurrentDate(new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 1));
  };

  const handleDropOnDay = (e: React.DragEvent, targetDate: Date) => {
    e.preventDefault();
    setDragOverDayIndex(null);
    const postId = e.dataTransfer.getData('text/plain');
    if (!postId) return;

    const targetPost = posts.find(p => p.id === postId);
    const prevDate = targetPost ? new Date(targetPost.scheduledAt) : new Date();
    
    // Construct new ISO preserving hour & min
    const newScheduled = new Date(
      targetDate.getFullYear(),
      targetDate.getMonth(),
      targetDate.getDate(),
      prevDate.getHours() || 19,
      prevDate.getMinutes() || 30
    ).toISOString();

    // Check for collisions and violations with ScheduleConflictGuardService
    const evalResult = ScheduleConflictGuardService.evaluateSchedule(
      postId,
      newScheduled,
      posts,
      selectedAccount
    );

    if (evalResult.hasViolation) {
      const pDate = new Date(newScheduled);
      setConflictState({
        isOpen: true,
        postId,
        targetIso: newScheduled,
        evaluation: evalResult,
        postTitle: targetPost?.caption || 'İçerik Gönderisi',
        targetTimeFormatted: `${pDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' })} • Saat ${pDate.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}`
      });
      return;
    }

    movePostToDate(postId, newScheduled);
  };

  const handleApplyConflictSuggestion = (safeIso: string) => {
    if (conflictState.postId) {
      movePostToDate(conflictState.postId, safeIso);
    }
    setConflictState(prev => ({ ...prev, isOpen: false }));
  };

  const handleForceSchedule = () => {
    if (conflictState.postId && conflictState.targetIso) {
      movePostToDate(conflictState.postId, conflictState.targetIso);
    }
    setConflictState(prev => ({ ...prev, isOpen: false }));
  };

  return (
    <div className="flex flex-col flex-1">
      {/* Calendar Header Controls */}
      <div className="flex items-center justify-between mb-4">
        <div className="flex items-center gap-3">
          <h2 className="text-lg font-bold font-unbounded text-white">
            {currentDate.toLocaleDateString('tr-TR', { month: 'long', year: 'numeric' }).toUpperCase()}
          </h2>
          <div className="flex items-center gap-1 bg-void-900 border border-void-750 rounded-xl p-1">
            <button
              onClick={prevMonth}
              className="p-1 rounded-lg hover:bg-void-800 text-void-400 hover:text-white transition-colors cursor-pointer"
            >
              <ChevronLeft className="w-4 h-4" />
            </button>
            <button
              onClick={() => setCurrentDate(new Date(2026, 8, 1))}
              className="px-2 py-0.5 text-xs text-void-300 hover:text-white rounded hover:bg-void-800 transition-colors cursor-pointer font-medium"
            >
              Bugün
            </button>
            <button
              onClick={nextMonth}
              className="p-1 rounded-lg hover:bg-void-800 text-void-400 hover:text-white transition-colors cursor-pointer"
            >
              <ChevronRight className="w-4 h-4" />
            </button>
          </div>
        </div>

        <div className="flex items-center gap-2 text-xs font-mono text-void-400">
          <span className="flex items-center gap-1 text-teal-300">
            <Sparkles className="w-3.5 h-3.5 text-teal-400" />
            Sürükle-Bırak & AI Optimum Saatler Aktif
          </span>
        </div>
      </div>

      {/* Days of Week Header */}
      <div className="grid grid-cols-7 gap-2 mb-2">
        {daysOfWeek.map((day, idx) => (
          <div key={idx} className="text-center text-xs font-semibold text-void-400 py-1.5 uppercase tracking-wider font-mono">
            {day}
          </div>
        ))}
      </div>

      {/* Grid of Calendar Days */}
      <div className="grid grid-cols-7 gap-2 flex-1 auto-rows-fr">
        {calendarDays.map((dayObj, idx) => {
          const dayNum = dayObj.date.getDate();
          const isToday = dayObj.isCurrentMonth && dayNum === 1; // 1 Eylül 2026
          const bestTime = dayObj.isCurrentMonth ? bestTimesByDay[dayNum] : undefined;
          const isDragTarget = dragOverDayIndex === idx;

          // Posts for this day
          const dayPosts = posts.filter(p => {
            const pDate = new Date(p.scheduledAt);
            return (
              pDate.getFullYear() === dayObj.date.getFullYear() &&
              pDate.getMonth() === dayObj.date.getMonth() &&
              pDate.getDate() === dayObj.date.getDate()
            );
          });

          return (
            <div
              key={idx}
              onDragOver={(e) => {
                e.preventDefault();
                setDragOverDayIndex(idx);
              }}
              onDragLeave={() => setDragOverDayIndex(null)}
              onDrop={(e) => handleDropOnDay(e, dayObj.date)}
              className={`min-h-[130px] rounded-2xl p-2.5 flex flex-col justify-between border transition-all duration-200 group relative ${
                isDragTarget
                  ? 'bg-gold-400/20 border-gold-400 shadow-gold-glow scale-[1.02]'
                  : dayObj.isCurrentMonth
                  ? 'bg-void-900/90 border-void-750/80 hover:border-void-600'
                  : 'bg-void-950/40 border-void-800/40 opacity-40'
              } ${isToday ? 'ring-1 ring-gold-400/50 bg-void-850/80' : ''}`}
            >
              {/* Day Header */}
              <div className="flex items-center justify-between mb-1.5">
                <span
                  className={`text-xs font-bold font-mono ${
                    isToday ? 'text-gold-400 font-unbounded' : dayObj.isCurrentMonth ? 'text-white' : 'text-void-500'
                  }`}
                >
                  {dayNum}
                </span>

                <div className="flex items-center gap-1">
                  {dayObj.isCurrentMonth && getHolidayForDate(dayObj.date.getMonth(), dayNum) && (
                    <span 
                      className="text-[8px] font-bold px-1.5 py-0.2 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 truncate max-w-[70px]"
                      title={getHolidayForDate(dayObj.date.getMonth(), dayNum)?.name}
                    >
                      {getHolidayForDate(dayObj.date.getMonth(), dayNum)?.label}
                    </span>
                  )}
                  {bestTime && (
                    <span
                      className="text-[9px] font-mono px-1.5 py-0.2 rounded bg-teal-500/10 text-teal-300 border border-teal-500/20"
                      title={`AI Etkileşim Analizi: Bu gün için en iyi paylaşım saati ${bestTime}`}
                    >
                      ★ {bestTime}
                    </span>
                  )}
                </div>
              </div>

              {/* Scheduled Posts Container */}
              <div className="space-y-1 flex-1 overflow-y-auto max-h-[85px]">
                {dayPosts.map(post => (
                  <PostCard key={post.id} post={post} compact />
                ))}
              </div>

              {/* Quick Add Button on Hover */}
              {dayObj.isCurrentMonth && (
                <button
                  onClick={() => openCreatePost('feed')}
                  className="opacity-0 group-hover:opacity-100 transition-opacity w-full mt-1 py-1 rounded-lg bg-void-800 hover:bg-gold-400/20 text-void-300 hover:text-gold-300 text-[10px] font-medium flex items-center justify-center gap-1 border border-void-700/60 cursor-pointer"
                >
                  <Plus className="w-3 h-3" />
                  İçerik Ekle
                </button>
              )}
            </div>
          );
        })}
      </div>

      {/* Schedule Conflict Guard Modal */}
      <ScheduleConflictModal
        isOpen={conflictState.isOpen}
        onClose={() => setConflictState(prev => ({ ...prev, isOpen: false }))}
        evaluation={conflictState.evaluation}
        postTitle={conflictState.postTitle}
        targetTimeFormatted={conflictState.targetTimeFormatted}
        onApplySuggestion={handleApplyConflictSuggestion}
        onForceSchedule={handleForceSchedule}
      />
    </div>
  );
};


