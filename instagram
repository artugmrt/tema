import { Post, PostType, PostStatus } from '../types';

export interface FacetFilterCriteria {
  searchQuery: string;
  type: string; // 'all' | PostType
  status: string; // 'all' | PostStatus
  tag: string; // 'all' | specific hashtag or campaign tag
  sortBy: 'date_desc' | 'date_asc' | 'likes_desc' | 'engagement_desc';
}

export interface FacetCounts {
  total: number;
  byType: Record<string, number>;
  byStatus: Record<string, number>;
  topTags: { tag: string; count: number }[];
}

export const DEFAULT_FACET_FILTERS: FacetFilterCriteria = {
  searchQuery: '',
  type: 'all',
  status: 'all',
  tag: 'all',
  sortBy: 'date_desc'
};

export const TaxonomySearchService = {
  /**
   * Computes dynamic facet counts across all provided posts
   */
  calculateFacetCounts(posts: Post[]): FacetCounts {
    const byType: Record<string, number> = {
      all: posts.length,
      feed: 0,
      reel: 0,
      story: 0,
      carousel: 0
    };

    const byStatus: Record<string, number> = {
      all: posts.length,
      draft: 0,
      in_review: 0,
      approved: 0,
      scheduled: 0,
      publishing: 0,
      published: 0,
      failed: 0,
      rejected: 0
    };

    const tagFreq: Record<string, number> = {};

    posts.forEach(p => {
      // Type count
      if (byType[p.type] !== undefined) {
        byType[p.type]++;
      }

      // Status count
      if (byStatus[p.status] !== undefined) {
        byStatus[p.status]++;
      }

      // Extract hashtags
      p.hashtags.forEach(tag => {
        const clean = tag.startsWith('#') ? tag : '#' + tag;
        tagFreq[clean] = (tagFreq[clean] || 0) + 1;
      });

      // Also parse words from caption that start with #
      const captionTags = p.caption.match(/#[a-zA-Z0-9_\u00C0-\u017F]+/g) || [];
      captionTags.forEach(tag => {
        tagFreq[tag] = (tagFreq[tag] || 0) + 1;
      });
    });

    const topTags = Object.entries(tagFreq)
      .map(([tag, count]) => ({ tag, count }))
      .sort((a, b) => b.count - a.count)
      .slice(0, 12);

    return {
      total: posts.length,
      byType,
      byStatus,
      topTags
    };
  },

  /**
   * Filters and sorts posts using the faceted criteria
   */
  filterAndSortPosts(posts: Post[], criteria: FacetFilterCriteria): Post[] {
    let result = [...posts];

    // 1. Search Query Filter
    if (criteria.searchQuery.trim() !== '') {
      const q = criteria.searchQuery.toLowerCase().trim();
      result = result.filter(p => {
        const matchCaption = p.caption.toLowerCase().includes(q);
        const matchLocation = p.location ? p.location.toLowerCase().includes(q) : false;
        const matchTags = p.hashtags.some(t => t.toLowerCase().includes(q));
        return matchCaption || matchLocation || matchTags;
      });
    }

    // 2. Type Filter
    if (criteria.type !== 'all') {
      result = result.filter(p => p.type === criteria.type);
    }

    // 3. Status Filter
    if (criteria.status !== 'all') {
      result = result.filter(p => p.status === criteria.status);
    }

    // 4. Tag / Campaign Taxonomy Filter
    if (criteria.tag !== 'all') {
      const targetTag = criteria.tag.toLowerCase();
      result = result.filter(p => {
        const inHashtags = p.hashtags.some(t => {
          const formatted = t.startsWith('#') ? t.toLowerCase() : '#' + t.toLowerCase();
          return formatted === targetTag || t.toLowerCase() === targetTag.replace('#', '');
        });
        const inCaption = p.caption.toLowerCase().includes(targetTag);
        return inHashtags || inCaption;
      });
    }

    // 5. Sorting
    result.sort((a, b) => {
      if (criteria.sortBy === 'date_asc') {
        const timeA = new Date(a.scheduledAt || a.publishedAt || 0).getTime();
        const timeB = new Date(b.scheduledAt || b.publishedAt || 0).getTime();
        return timeA - timeB;
      }

      if (criteria.sortBy === 'likes_desc') {
        const likesA = a.analytics?.likes || 0;
        const likesB = b.analytics?.likes || 0;
        return likesB - likesA;
      }

      if (criteria.sortBy === 'engagement_desc') {
        const engA = a.analytics?.engagementRate || 0;
        const engB = b.analytics?.engagementRate || 0;
        return engB - engA;
      }

      // Default: date_desc (Newest first)
      const timeA = new Date(a.scheduledAt || a.publishedAt || 0).getTime();
      const timeB = new Date(b.scheduledAt || b.publishedAt || 0).getTime();
      return timeB - timeA;
    });

    return result;
  }
};


