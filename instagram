// Local & Extension Storage Sync Service

export const StorageService = {
  get<T>(key: string, defaultValue: T): T {
    try {
      const item = localStorage.getItem(`ig_panel_${key}`);
      if (item) {
        return JSON.parse(item);
      }
    } catch (e) {
      console.warn(`Storage get error for key ${key}:`, e);
    }
    return defaultValue;
  },

  set<T>(key: string, value: T): void {
    try {
      localStorage.setItem(`ig_panel_${key}`, JSON.stringify(value));
      // If Chrome Extension runtime is available, also mirror into chrome.storage
      if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
        chrome.storage.local.set({ [`ig_panel_${key}`]: value });
      }
    } catch (e) {
      console.warn(`Storage set error for key ${key}:`, e);
    }
  },

  remove(key: string): void {
    try {
      localStorage.removeItem(`ig_panel_${key}`);
      if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
        chrome.storage.local.remove(`ig_panel_${key}`);
      }
    } catch (e) {
      console.warn(`Storage remove error for key ${key}:`, e);
    }
  }
};


