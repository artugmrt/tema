  // Run live test
  const handleRunTest = async () => {
    setIsTesting(true);
    setTestResult(null);
    try {
      const res = await ProxyIsolationService.testProxyHealth(proxy);
      setTestResult(res);
      setProxy(prev => ({
        ...prev,
        latencyMs: res.latencyMs,
        reputationScore: res.reputationScore,
        ip: res.ip,
        healthStatus: res.success ? 'active' : 'failed',
        lastCheckedAt: new Date().toISOString()
      }));
    } catch (e) {
      console.error(e);
    } finally {
      setIsTesting(false);
    }
  };

  // Regenerate consistent fingerprint
  const handleRegenerateFingerprint = (osHint: 'macOS' | 'Windows' | 'iOS') => {
    const newFp = ProxyIsolationService.generateConsistentFingerprint(osHint);
    setFingerprint(newFp);
