        retentionPercentage = 80.5 - (progress * 14.5); // 15s: ~66.0%
      } else if (sec <= 25) {
        // Value phase
        const progress = (sec - 15) / 10;
        retentionPercentage = 66.0 - (progress * 12.0); // 25s: ~54.0%
      } else {
        // Outro drop
        const progress = (sec - 25) / (durationSeconds - 25);
        retentionPercentage = 54.0 - (progress * 14.0); // 30s: ~40.0%
      }

      const activeViewers = Math.round((retentionPercentage / 100) * totalViewers);
      const prevPercentage = sec === 0 ? 100 : points[sec - 1].retentionPercentage;
      const dropOffRateAtSecond = Math.max(0, Number((prevPercentage - retentionPercentage).toFixed(2)));

      points.push({
        second: sec,
        retentionPercentage: Number(retentionPercentage.toFixed(1)),
        activeViewers,
        isHookPoint: sec === 3,
        isCtaPoint: sec === 25,
        dropOffRateAtSecond
