{
  "openapi": "3.0.0",
  "info": {
    "title": "InstaPlanner AGENTIC API",
    "version": "4.0.0",
    "description": "Multi-Tenant Instagram Management, AI Studio, and Queue Engine REST API"
  },
  "paths": {
    "/api/accounts": {
      "get": {
        "summary": "List managed Instagram accounts",
        "parameters": [
          {
            "name": "brand_folder_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of accounts with health score and limits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Account" }
                }
              }
            }
          }
        }
      }
    },
    "/api/posts": {
      "get": {
        "summary": "List posts by date range or account",
        "parameters": [
          { "name": "account_id", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Filtered posts collection" }
        }
      },
      "post": {
        "summary": "Create scheduled or draft post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PostCreateInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Post successfully queued" }
        }
      }
    },
    "/api/ai/generate-caption": {
      "post": {
        "summary": "Generate AI Caption using Tone Preset & Multimodal Vision",
        "responses": {
          "200": { "description": "Generated hooks, caption, and hashtags" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "username": { "type": "string" },
          "display_name": { "type": "string" },
          "health_score": { "type": "integer" },
          "risk_level": { "type": "string", "enum": ["safe", "moderate", "high", "critical"] }
        }
      },
      "PostCreateInput": {
        "type": "object",
        "required": ["account_id", "type", "scheduled_at"],
        "properties": {
          "account_id": { "type": "string", "format": "uuid" },
          "type": { "type": "string", "enum": ["feed", "reel", "story", "carousel"] },
          "scheduled_at": { "type": "string", "format": "date-time" },
          "caption": { "type": "string" },
          "hashtags": { "type": "array", "items": { "type": "string" } },
          "media_urls": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}


