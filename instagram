import { motion, AnimatePresence } from 'framer-motion';
import { WIDGET_REGISTRY, WidgetDefinition } from './WidgetRegistry';

interface WidgetDrawerProps {
  isOpen: boolean;
  onClose: () => void;
  activeWidgetIds: string[];
  onToggleWidget: (id: string) => void;
  onResetLayout: () => void;
}

export const WidgetDrawer: React.FC<WidgetDrawerProps> = ({
  isOpen,
  onClose,
  activeWidgetIds,
  onToggleWidget,
  onResetLayout,
}) => {
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedCategory, setSelectedCategory] = useState<string>('all');
  const allWidgets = Object.values(WIDGET_REGISTRY);

  const categories = [
    { id: 'all', label: `Tümü (${allWidgets.length})` },
    { id: 'kpi', label: 'KPI Sayaçları' },
    { id: 'charts', label: 'Grafikler' },
    { id: 'engine', label: 'İnsan Motoru' },
    { id: 'content', label: 'İçerik & Kuyruk' },
    { id: 'utility', label: 'Yardımcılar' },
  ];

  const filteredWidgets = allWidgets.filter(w => {
    const matchesCat = selectedCategory === 'all' || w.category === selectedCategory;
    const matchesSearch = w.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
                          w.description.toLowerCase().includes(searchQuery.toLowerCase());
    return matchesCat && matchesSearch;
  });

  return (
    <AnimatePresence>
      {isOpen && (
        <div className="fixed inset-0 z-50 overflow-hidden flex justify-end">
          {/* Backdrop */}
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            onClick={onClose}
            className="fixed inset-0 bg-void-950/80 backdrop-blur-sm cursor-pointer"
          />

          {/* Drawer Panel */}
          <motion.div
            initial={{ x: '100%' }}
            animate={{ x: 0 }}
            exit={{ x: '100%' }}
            transition={{ type: 'spring', damping: 25, stiffness: 220 }}
            className="relative w-full max-w-md bg-void-900 border-l border-void-750 shadow-2xl flex flex-col h-full z-10"
          >
            {/* Header */}
            <div className="p-5 border-b border-void-750 flex items-center justify-between">
              <div className="flex items-center gap-2.5">
                <div className="w-8 h-8 rounded-xl bg-gold-400/15 border border-gold-400/40 flex items-center justify-center text-gold-400">
                  <SlidersHorizontal className="w-4 h-4" />
                </div>
                <div>
                  <h3 className="text-sm font-bold font-unbounded text-white">
                    Widget Yönetim Paneli
                  </h3>
                  <span className="text-[11px] text-void-400 font-mono">
                    {activeWidgetIds.length} / {allWidgets.length} Aktif Widget
                  </span>
                </div>
              </div>
              <button
                onClick={onClose}
                className="w-8 h-8 rounded-lg bg-void-800 hover:bg-void-700 text-void-300 hover:text-white flex items-center justify-center transition-all cursor-pointer"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Search & Categories */}
            <div className="p-4 border-b border-void-800 space-y-3">
              <div className="relative">
                <Search className="w-4 h-4 text-void-500 absolute left-3 top-1/2 -translate-y-1/2" />
                <input
                  type="text"
                  value={searchQuery}
                  onChange={e => setSearchQuery(e.target.value)}
                  placeholder="Widget ara..."
                  className="w-full bg-void-950 border border-void-700 rounded-xl pl-9 pr-3 py-2 text-xs text-white placeholder-void-500 focus:outline-none focus:border-gold-400 font-mono transition-all"
                />
              </div>

              <div className="flex items-center gap-1.5 overflow-x-auto pb-1">
                {categories.map(cat => (
                  <button
                    key={cat.id}
                    onClick={() => setSelectedCategory(cat.id)}
                    className={`px-2.5 py-1 rounded-lg text-[10px] font-mono whitespace-nowrap transition-all cursor-pointer ${
                      selectedCategory === cat.id
                        ? 'bg-gold-400/20 text-gold-300 border border-gold-400/40 font-bold'
                        : 'bg-void-950 text-void-400 border border-void-800 hover:text-white'
                    }`}
                  >
                    {cat.label}
                  </button>
                ))}
              </div>
            </div>

            {/* Widget List */}
            <div className="flex-1 overflow-y-auto p-4 space-y-2.5">
              {filteredWidgets.map(widget => {
                const isActive = activeWidgetIds.includes(widget.id);
                return (
                  <div
                    key={widget.id}
                    className={`p-3.5 rounded-xl border transition-all flex items-center justify-between gap-3 ${
                      isActive
                        ? 'bg-void-850/80 border-gold-400/30'
                        : 'bg-void-950/60 border-void-800 opacity-70 hover:opacity-100'
                    }`}
                  >
                    <div className="min-w-0 flex-1">
                      <div className="flex items-center gap-2 mb-1">
                        <span className="text-xs font-bold text-white font-unbounded">
                          {widget.title}
                        </span>
                        <span className="text-[9px] font-mono px-1.5 py-0.5 rounded bg-void-800 text-void-400">
                          {widget.defaultLayout.w}x{widget.defaultLayout.h}
                        </span>
                      </div>
                      <p className="text-[11px] text-void-400 leading-tight">
                        {widget.description}
                      </p>
                    </div>

                    <button
                      onClick={() => onToggleWidget(widget.id)}
                      className={`px-3 py-1.5 rounded-xl text-xs font-mono font-bold transition-all cursor-pointer shrink-0 ${
                        isActive
                          ? 'bg-teal-500/20 text-teal-300 border border-teal-500/40 hover:bg-rose-500/20 hover:text-rose-300 hover:border-rose-500/40'
                          : 'bg-void-800 text-void-300 border border-void-700 hover:bg-gold-400/20 hover:text-gold-300 hover:border-gold-400/40'
                      }`}
                    >
                      {isActive ? 'Kaldır' : 'Ekle +'}
                    </button>
                  </div>
                );
              })}
            </div>

            {/* Footer */}
            <div className="p-4 border-t border-void-750 bg-void-950/60 flex items-center justify-between">
              <button
                onClick={onResetLayout}
                className="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-mono text-void-400 hover:text-gold-300 bg-void-900 border border-void-800 hover:border-gold-400/40 transition-all cursor-pointer"
              >
                <RotateCcw className="w-3.5 h-3.5" />
                <span>Düzeni Sıfırla</span>
              </button>

              <button
                onClick={onClose}
                className="px-4 py-2 rounded-xl bg-gold-400 text-void-950 font-bold text-xs font-mono hover:bg-gold-300 transition-all cursor-pointer shadow-gold-glow"
              >
                Tamamlandı
              </button>
            </div>
          </motion.div>
        </div>
      )}
    </AnimatePresence>
  );
};


