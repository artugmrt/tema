    "sqlSchema": "-- ====================================================================\n-- INSTAPLANNER AGENTIC v4.0.0 \"PERFECT BUILD\" — FULL DATABASE DUMP\n-- Reference: Perfect Build.md & ANAYASAMIZ.MD\n-- Export Date: 2026-09-01\n-- Author: Murat\n-- Description: Complete 13-table schema, granular RLS policies, \n--              automated triggers, materialized views, and full seed data.\n-- ====================================================================\n\nBEGIN;\n\n-- 1. EXTENSIONS\nCREATE EXTENSION IF NOT EXISTS \"uuid-ossp\";\n\n-- 2. DROP PREVIOUS OBJECTS (Clean Slate Migration)\nDROP MATERIALIZED VIEW IF EXISTS public.account_weekly_stats CASCADE;\nDROP TABLE IF EXISTS public.post_stickers CASCADE;\nDROP TABLE IF EXISTS public.saved_replies CASCADE;\nDROP TABLE IF EXISTS public.content_templates CASCADE;\nDROP TABLE IF EXISTS public.activity_logs CASCADE;\nDROP TABLE IF EXISTS public.notifications CASCADE;\nDROP TABLE IF EXISTS public.account_analytics CASCADE;\nDROP TABLE IF EXISTS public.system_configs CASCADE;\nDROP TABLE IF EXISTS public.tone_presets CASCADE;\nDROP TABLE IF EXISTS public.team_members CASCADE;\nDROP TABLE IF EXISTS public.changelog CASCADE;\nDROP TABLE IF EXISTS public.queue_items CASCADE;\nDROP TABLE IF EXISTS public.approval_history CASCADE;\nDROP TABLE IF EXISTS public.posts CASCADE;\nDROP TABLE IF EXISTS public.accounts CASCADE;\nDROP TABLE IF EXISTS public.brand_folders CASCADE;\n\n-- 3. CORE & ENHANCED TABLES (13 TABLES)\n\n-- 3.1 Brand Folders (Marka & Müşteri Klasörleri)\nCREATE TABLE public.brand_folders (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    name VARCHAR(255) NOT NULL,\n    client_name VARCHAR(255) NOT NULL,\n    description TEXT,\n    color VARCHAR(32) DEFAULT '#E8B765',\n    icon VARCHAR(64) DEFAULT 'Building2',\n    tone_preset_id VARCHAR(64) DEFAULT 'tone-luxury',\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,\n    updated_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.2 Tone Presets (AI Marka Sesi ve Ton Profilleri)\nCREATE TABLE public.tone_presets (\n    id VARCHAR(64) PRIMARY KEY,\n    name VARCHAR(255) NOT NULL,\n    badge VARCHAR(128),\n    description TEXT,\n    emoji VARCHAR(16),\n    prompt_template TEXT,\n    sample_phrases TEXT[] DEFAULT '{}',\n    ai_config JSONB DEFAULT '{\"temperature\": 0.7, \"max_tokens\": 300, \"style_tags\": []}',\n    is_active BOOLEAN DEFAULT true,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,\n    updated_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.3 Accounts (Instagram Hesapları & Sağlık Skoru)\nCREATE TABLE public.accounts (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    brand_folder_id UUID REFERENCES public.brand_folders(id) ON DELETE SET NULL,\n    username VARCHAR(255) UNIQUE NOT NULL,\n    display_name VARCHAR(255) NOT NULL,\n    avatar_url TEXT,\n    category VARCHAR(128) DEFAULT 'Genel',\n    follower_count INTEGER DEFAULT 0,\n    following_count INTEGER DEFAULT 0,\n    post_count INTEGER DEFAULT 0,\n    health_score INTEGER DEFAULT 98 CHECK (health_score >= 0 AND health_score <= 100),\n    risk_level VARCHAR(32) DEFAULT 'safe' CHECK (risk_level IN ('safe', 'moderate', 'high', 'critical')),\n    status VARCHAR(32) DEFAULT 'active' CHECK (status IN ('active', 'cooldown', 'throttled', 'paused', 'needs_reauth')),\n    safe_window_start VARCHAR(8) DEFAULT '09:00',\n    safe_window_end VARCHAR(8) DEFAULT '22:30',\n    warmup_day_count INTEGER DEFAULT 14,\n    is_verified BOOLEAN DEFAULT false,\n    brand_tone_preset_id VARCHAR(64) REFERENCES public.tone_presets(id) ON DELETE SET NULL,\n    connected_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.4 Team Members (Ekip Üyeleri & Rol İzin Matrisi)\nCREATE TABLE public.team_members (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    account_id UUID REFERENCES public.accounts(id) ON DELETE CASCADE,\n    brand_folder_id UUID REFERENCES public.brand_folders(id) ON DELETE CASCADE,\n    user_id VARCHAR(255) NOT NULL,\n    name VARCHAR(255) NOT NULL,\n    email VARCHAR(255) NOT NULL,\n    avatar_url TEXT,\n    role VARCHAR(64) NOT NULL CHECK (role IN ('agency_admin', 'content_creator', 'client_approver', 'analyst', 'viewer')),\n    permissions JSONB DEFAULT '{\n        \"can_create_posts\": true,\n        \"can_edit_posts\": true,\n        \"can_delete_posts\": false,\n        \"can_approve_posts\": false,\n        \"can_manage_accounts\": false,\n        \"can_view_analytics\": true,\n        \"can_export_reports\": false\n    }',\n    is_active BOOLEAN DEFAULT true,\n    last_login_at TIMESTAMPTZ,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,\n    updated_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,\n    UNIQUE(account_id, user_id)\n);\n\n-- 3.5 Posts (İçerikler & Gönderi Yaşam Döngüsü)\nCREATE TABLE public.posts (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    account_id UUID REFERENCES public.accounts(id) ON DELETE CASCADE NOT NULL,\n    type VARCHAR(32) NOT NULL CHECK (type IN ('feed', 'reel', 'story', 'carousel')),\n    status VARCHAR(32) NOT NULL DEFAULT 'draft' CHECK (status IN ('draft', 'in_review', 'approved', 'scheduled', 'publishing', 'published', 'failed')),\n    scheduled_at TIMESTAMPTZ NOT NULL,\n    published_at TIMESTAMPTZ,\n    caption TEXT,\n    hashtags TEXT[] DEFAULT '{}',\n    media_urls TEXT[] DEFAULT '{}',\n    cover_url TEXT,\n    audio_title VARCHAR(255),\n    location VARCHAR(255),\n    best_time_score INTEGER DEFAULT 90,\n    is_ai_enhanced BOOLEAN DEFAULT false,\n    notes TEXT,\n    analytics JSONB DEFAULT '{}'::jsonb,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,\n    updated_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.6 Post Stickers (Story/Reels Çıkartmaları)\nCREATE TABLE public.post_stickers (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    post_id UUID REFERENCES public.posts(id) ON DELETE CASCADE NOT NULL,\n    sticker_type VARCHAR(32) NOT NULL CHECK (sticker_type IN ('link', 'poll', 'mention', 'hashtag', 'location', 'question', 'countdown')),\n    sticker_data JSONB NOT NULL,\n    position_x DECIMAL(5,2) DEFAULT 50.00,\n    position_y DECIMAL(5,2) DEFAULT 50.00,\n    scale DECIMAL(3,2) DEFAULT 1.00,\n    rotation INTEGER DEFAULT 0,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.7 Approval History (5 Aşamalı Onay ve Denetim İzi)\nCREATE TABLE public.approval_history (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    post_id UUID REFERENCES public.posts(id) ON DELETE CASCADE NOT NULL,\n    user_name VARCHAR(255) NOT NULL,\n    user_role VARCHAR(64) NOT NULL,\n    user_avatar TEXT,\n    action VARCHAR(64) NOT NULL CHECK (action IN ('created', 'submitted_review', 'approved', 'rejected', 'commented', 'scheduled')),\n    note TEXT,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.8 Queue Items (İnsan Benzeri Davranış & Yayın Kuyruğu)\nCREATE TABLE public.queue_items (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    post_id UUID REFERENCES public.posts(id) ON DELETE CASCADE NOT NULL,\n    account_id UUID REFERENCES public.accounts(id) ON DELETE CASCADE NOT NULL,\n    scheduled_time TIMESTAMPTZ NOT NULL,\n    effective_execution_time TIMESTAMPTZ NOT NULL,\n    jitter_offset_minutes INTEGER DEFAULT 0,\n    status VARCHAR(32) DEFAULT 'waiting' CHECK (status IN ('waiting', 'in_progress', 'completed', 'paused', 'failed')),\n    simulated_typing_speed_ms INTEGER DEFAULT 95,\n    progress_pct INTEGER DEFAULT 0,\n    step_description TEXT,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.9 Account Analytics (Tarihsel İstatistikler)\nCREATE TABLE public.account_analytics (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    account_id UUID REFERENCES public.accounts(id) ON DELETE CASCADE NOT NULL,\n    metric_date DATE NOT NULL,\n    followers INTEGER DEFAULT 0,\n    follower_change INTEGER DEFAULT 0,\n    reach INTEGER DEFAULT 0,\n    impressions INTEGER DEFAULT 0,\n    profile_views INTEGER DEFAULT 0,\n    website_clicks INTEGER DEFAULT 0,\n    engagement_rate DECIMAL(5,2) DEFAULT 0,\n    avg_likes INTEGER DEFAULT 0,\n    avg_comments INTEGER DEFAULT 0,\n    avg_saves INTEGER DEFAULT 0,\n    avg_shares INTEGER DEFAULT 0,\n    top_post_ids UUID[] DEFAULT '{}',\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,\n    UNIQUE(account_id, metric_date)\n);\n\n-- 3.10 System Configs (Sistem Parametreleri)\nCREATE TABLE public.system_configs (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    config_key VARCHAR(255) UNIQUE NOT NULL,\n    config_value JSONB NOT NULL,\n    description TEXT,\n    is_editable BOOLEAN DEFAULT true,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,\n    updated_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.11 Changelog (Anayasa Gereği Veritabanı Değişiklik İzi)\nCREATE TABLE public.changelog (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    version VARCHAR(32) NOT NULL,\n    change_date TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,\n    change_type VARCHAR(32) NOT NULL CHECK (change_type IN ('added', 'changed', 'fixed', 'removed', 'security', 'performance', 'ui_ux')),\n    title VARCHAR(255) NOT NULL,\n    description TEXT NOT NULL,\n    technical_details JSONB DEFAULT '{}',\n    affected_files TEXT[] DEFAULT '{}',\n    is_public BOOLEAN DEFAULT false,\n    author VARCHAR(255) DEFAULT 'Murat',\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.12 Notifications (Bildirim Merkezi & Alarmlar)\nCREATE TABLE public.notifications (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    user_id VARCHAR(255) NOT NULL,\n    account_id UUID REFERENCES public.accounts(id) ON DELETE CASCADE,\n    type VARCHAR(64) NOT NULL CHECK (type IN ('approval_needed', 'publish_failed', 'low_engagement', 'risk_warning', 'mention', 'comment_priority', 'system_alert')),\n    title VARCHAR(255) NOT NULL,\n    message TEXT,\n    priority VARCHAR(16) DEFAULT 'normal' CHECK (priority IN ('low', 'normal', 'high', 'critical')),\n    is_read BOOLEAN DEFAULT false,\n    action_url TEXT,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.13 Activity Logs (Aktivite ve Denetim Günlüğü)\nCREATE TABLE public.activity_logs (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    account_id UUID REFERENCES public.accounts(id) ON DELETE CASCADE,\n    user_id VARCHAR(255),\n    action_type VARCHAR(64) NOT NULL,\n    action_description TEXT,\n    metadata JSONB DEFAULT '{}',\n    ip_address INET,\n    user_agent TEXT,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.14 Saved Replies (Hızlı Yanıtlar)\nCREATE TABLE public.saved_replies (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    account_id UUID REFERENCES public.accounts(id) ON DELETE CASCADE,\n    name VARCHAR(255) NOT NULL,\n    content TEXT NOT NULL,\n    category VARCHAR(128),\n    usage_count INTEGER DEFAULT 0,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 3.15 Content Templates (İçerik Şablonları)\nCREATE TABLE public.content_templates (\n    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    brand_folder_id UUID REFERENCES public.brand_folders(id) ON DELETE CASCADE,\n    name VARCHAR(255) NOT NULL,\n    type VARCHAR(32) NOT NULL CHECK (type IN ('feed', 'reel', 'story', 'carousel')),\n    structure JSONB NOT NULL,\n    caption_template TEXT,\n    is_active BOOLEAN DEFAULT true,\n    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL\n);\n\n-- 4. MATERIALIZED VIEWS & PRODUCTION INDEXES (Bölüm 7.2)\n\nCREATE MATERIALIZED VIEW public.account_weekly_stats AS\nSELECT \n  account_id,\n  date_trunc('week', metric_date) as week_start,\n  AVG(followers)::numeric(10,2) as avg_followers,\n  AVG(reach)::numeric(10,2) as avg_reach,\n  AVG(engagement_rate)::numeric(5,2) as avg_engagement\nFROM public.account_analytics\nGROUP BY account_id, date_trunc('week', metric_date);\n\nCREATE UNIQUE INDEX idx_account_weekly_stats \nON public.account_weekly_stats(account_id, week_start);\n\nCREATE OR REPLACE FUNCTION public.refresh_account_stats()\nRETURNS void AS $$\nBEGIN\n  REFRESH MATERIALIZED VIEW CONCURRENTLY public.account_weekly_stats;\nEND;\n$$ LANGUAGE plpgsql;\n\n-- 4.1 Production Performance & Query Indexes (Bölüm 7.3)\nCREATE INDEX idx_posts_account_scheduled ON public.posts(account_id, scheduled_at DESC);\nCREATE INDEX idx_posts_status ON public.posts(status);\nCREATE INDEX idx_queue_items_status_time ON public.queue_items(status, effective_execution_time);\nCREATE INDEX idx_team_members_user ON public.team_members(user_id) WHERE is_active = true;\nCREATE INDEX idx_notifications_user_read ON public.notifications(user_id, is_read) WHERE is_read = false;\nCREATE INDEX idx_activity_logs_account ON public.activity_logs(account_id, created_at DESC);\nCREATE INDEX idx_approval_history_post ON public.approval_history(post_id, created_at DESC);\nCREATE INDEX idx_account_analytics_date ON public.account_analytics(account_id, metric_date DESC);\n\n-- 5. SECURE ROW LEVEL SECURITY (RLS) & SECURITY DEFINER FUNCTIONS (PRODUCTION HARDENED)\n\nCREATE OR REPLACE FUNCTION public.get_auth_user_id()\nRETURNS VARCHAR AS $$\n    SELECT nullif(current_setting('request.jwt.claims', true)::json->>'sub', '')::varchar;\n$$ LANGUAGE sql STABLE;\n\nCREATE OR REPLACE FUNCTION public.has_account_access(account_id UUID)\nRETURNS BOOLEAN AS $$\n    SELECT EXISTS (\n        SELECT 1 FROM public.team_members tm\n        WHERE tm.account_id = $1 \n        AND tm.user_id = public.get_auth_user_id()\n        AND tm.is_active = true\n    );\n$$ LANGUAGE sql STABLE SECURITY DEFINER;\n\nCREATE OR REPLACE FUNCTION public.get_user_role(account_id UUID)\nRETURNS VARCHAR AS $$\n    SELECT COALESCE(\n      (SELECT tm.role FROM public.team_members tm\n       WHERE tm.account_id = $1 \n       AND tm.user_id = public.get_auth_user_id()\n       AND tm.is_active = true\n       LIMIT 1),\n      'viewer'\n    );\n$$ LANGUAGE sql STABLE SECURITY DEFINER;\n\n-- 5.1 RLS Activation (15/15 All Tables Protected)\nALTER TABLE public.brand_folders ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.tone_presets ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.accounts ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.posts ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.team_members ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.approval_history ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.queue_items ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.account_analytics ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.changelog ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.notifications ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.activity_logs ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.post_stickers ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.saved_replies ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.content_templates ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.system_configs ENABLE ROW LEVEL SECURITY;\n\n-- 5.2 Granular Multi-Tenant Access Policies\n\n-- Tone presets: Herkes okuyabilir (genel şablonlar), sadece ajans admini düzenleyebilir\nCREATE POLICY \"tone_presets_select\" ON public.tone_presets FOR SELECT USING (true);\nCREATE POLICY \"tone_presets_modify\" ON public.tone_presets FOR ALL USING (\n    EXISTS (SELECT 1 FROM public.team_members tm WHERE tm.user_id = public.get_auth_user_id() AND tm.role = 'agency_admin' AND tm.is_active = true)\n);\n\n-- Brand folders: Sadece ilgili markaya atanmış ekip üyeleri veya ajans admini\nCREATE POLICY \"brand_folders_select\" ON public.brand_folders FOR SELECT USING (\n    EXISTS (SELECT 1 FROM public.team_members tm WHERE tm.brand_folder_id = id AND tm.user_id = public.get_auth_user_id() AND tm.is_active = true)\n);\nCREATE POLICY \"brand_folders_modify\" ON public.brand_folders FOR ALL USING (\n    EXISTS (SELECT 1 FROM public.team_members tm WHERE tm.brand_folder_id = id AND tm.user_id = public.get_auth_user_id() AND tm.role = 'agency_admin' AND tm.is_active = true)\n);\n\n-- Accounts: Sadece erişim yetkisi olan kullanıcılar\nCREATE POLICY \"accounts_policy\" ON public.accounts FOR ALL USING (public.has_account_access(id));\n\n-- Posts: Hesaba erişimi olan kullanıcılar\nCREATE POLICY \"posts_policy\" ON public.posts FOR ALL USING (public.has_account_access(account_id));\n\n-- Team members: Kendi hesap/brand erişim kapsamı\nCREATE POLICY \"team_members_policy\" ON public.team_members FOR ALL USING (public.has_account_access(account_id));\n\n-- Approval history: Post'un bağlı olduğu hesaba erişim\nCREATE POLICY \"approval_history_policy\" ON public.approval_history FOR ALL USING (\n    EXISTS (SELECT 1 FROM public.posts p WHERE p.id = post_id AND public.has_account_access(p.account_id))\n);\n\n-- Queue items: Hesaba erişim\nCREATE POLICY \"queue_items_policy\" ON public.queue_items FOR ALL USING (public.has_account_access(account_id));\n\n-- Account analytics: Hesaba erişim\nCREATE POLICY \"account_analytics_policy\" ON public.account_analytics FOR ALL USING (public.has_account_access(account_id));\n\n-- Changelog: Herkes okuyabilir (açık denetim kaydı), sadece sistem/admin ekler\nCREATE POLICY \"changelog_policy\" ON public.changelog FOR SELECT USING (true);\nCREATE POLICY \"changelog_insert\" ON public.changelog FOR INSERT WITH CHECK (public.get_auth_user_id() IS NOT NULL);\n\n-- Notifications: Sadece kullanıcının kendi bildirimleri\nCREATE POLICY \"notifications_policy\" ON public.notifications FOR ALL USING (\n    user_id = public.get_auth_user_id()\n);\n\n-- Activity logs: Hesaba erişimi olan kullanıcılar\nCREATE POLICY \"activity_logs_policy\" ON public.activity_logs FOR ALL USING (\n    public.has_account_access(account_id)\n);\n\n-- Post stickers: Post'un hesabına erişim\nCREATE POLICY \"post_stickers_policy\" ON public.post_stickers FOR ALL USING (\n    EXISTS (SELECT 1 FROM public.posts p WHERE p.id = post_id AND public.has_account_access(p.account_id))\n);\n\n-- Saved replies: Hesaba erişim\nCREATE POLICY \"saved_replies_policy\" ON public.saved_replies FOR ALL USING (\n    public.has_account_access(account_id)\n);\n\n-- Content templates: Brand folder erişimi\nCREATE POLICY \"content_templates_policy\" ON public.content_templates FOR ALL USING (\n    EXISTS (SELECT 1 FROM public.team_members tm WHERE tm.brand_folder_id = content_templates.brand_folder_id AND tm.user_id = public.get_auth_user_id() AND tm.is_active = true)\n);\n\n-- System configs: Herkes okuyabilir, sadece yetkili ajans admini güncelleyebilir\nCREATE POLICY \"system_configs_select\" ON public.system_configs FOR SELECT USING (true);\nCREATE POLICY \"system_configs_modify\" ON public.system_configs FOR ALL USING (\n    EXISTS (SELECT 1 FROM public.team_members tm WHERE tm.user_id = public.get_auth_user_id() AND tm.role = 'agency_admin' AND tm.is_active = true)\n);\n\n-- 6. AUTOMATION TRIGGERS\n\n-- 6.0 Auto updated_at Trigger Function\nCREATE OR REPLACE FUNCTION public.update_updated_at_column()\nRETURNS TRIGGER AS $$\nBEGIN\n    NEW.updated_at = timezone('utc'::text, now());\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER update_brand_folders_updated_at BEFORE UPDATE ON public.brand_folders FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();\nCREATE TRIGGER update_tone_presets_updated_at BEFORE UPDATE ON public.tone_presets FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();\nCREATE TRIGGER update_accounts_updated_at BEFORE UPDATE ON public.accounts FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();\nCREATE TRIGGER update_team_members_updated_at BEFORE UPDATE ON public.team_members FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();\nCREATE TRIGGER update_posts_updated_at BEFORE UPDATE ON public.posts FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();\nCREATE TRIGGER update_system_configs_updated_at BEFORE UPDATE ON public.system_configs FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();\nCREATE TRIGGER update_content_templates_updated_at BEFORE UPDATE ON public.content_templates FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();\n\n-- 6.1 Automatic Changelog Logger Trigger (Anayasa Madde 0.2 & 12)\nCREATE OR REPLACE FUNCTION public.log_schema_change()\nRETURNS TRIGGER AS $$\nDECLARE\n    v_change_type VARCHAR(32);\n    v_description TEXT;\nBEGIN\n    IF TG_OP = 'INSERT' THEN\n        v_change_type := 'added';\n        v_description := TG_TABLE_NAME || ' tablosuna yeni kayıt eklendi';\n    ELSIF TG_OP = 'UPDATE' THEN\n        v_change_type := 'changed';\n        v_description := TG_TABLE_NAME || ' tablosunda kayıt güncellendi';\n    ELSIF TG_OP = 'DELETE' THEN\n        v_change_type := 'removed';\n        v_description := TG_TABLE_NAME || ' tablosundan kayıt silindi';\n    END IF;\n\n    INSERT INTO public.changelog (\n        version, change_type, title, description, \n        technical_details, is_public, author\n    ) VALUES (\n        '4.0.1', v_change_type, \n        TG_TABLE_NAME || ' tablosu değişikliği',\n        v_description,\n        jsonb_build_object(\n            'table', TG_TABLE_NAME,\n            'operation', TG_OP,\n            'timestamp', now(),\n            'triggered_by', 'database_trigger'\n        ),\n        false, 'system'\n    );\n    \n    RETURN COALESCE(NEW, OLD);\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER accounts_changelog_trigger\nAFTER INSERT OR UPDATE OR DELETE ON public.accounts\nFOR EACH ROW EXECUTE FUNCTION public.log_schema_change();\n\nCREATE TRIGGER posts_changelog_trigger\nAFTER INSERT OR UPDATE OR DELETE ON public.posts\nFOR EACH ROW EXECUTE FUNCTION public.log_schema_change();\n\nCREATE TRIGGER team_members_changelog_trigger\nAFTER INSERT OR UPDATE OR DELETE ON public.team_members\nFOR EACH ROW EXECUTE FUNCTION public.log_schema_change();\n\nCREATE TRIGGER brand_folders_changelog_trigger\nAFTER INSERT OR UPDATE OR DELETE ON public.brand_folders\nFOR EACH ROW EXECUTE FUNCTION public.log_schema_change();\n\nCREATE TRIGGER queue_items_changelog_trigger\nAFTER INSERT OR UPDATE OR DELETE ON public.queue_items\nFOR EACH ROW EXECUTE FUNCTION public.log_schema_change();\n\n-- 6.2 Queue Jitter Trigger (Bot Algılanma Önleme: 5-15 Dk Rastgele Jitter & 65-140ms Yazma)\nCREATE OR REPLACE FUNCTION public.schedule_queue_item()\nRETURNS TRIGGER AS $$\nDECLARE\n    v_jitter_minutes INTEGER;\n    v_effective_time TIMESTAMPTZ;\nBEGIN\n    v_jitter_minutes := floor(random() * 10 + 5)::integer;\n    v_effective_time := NEW.scheduled_time + (v_jitter_minutes || ' minutes')::interval;\n    \n    NEW.effective_execution_time := v_effective_time;\n    NEW.jitter_offset_minutes := v_jitter_minutes;\n    NEW.simulated_typing_speed_ms := floor(random() * 75 + 65)::integer;\n    \n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER queue_items_schedule_trigger\nBEFORE INSERT ON public.queue_items\nFOR EACH ROW EXECUTE FUNCTION public.schedule_queue_item();\n\n-- 6.3 Account Health Update Trigger\nCREATE OR REPLACE FUNCTION public.update_account_health()\nRETURNS TRIGGER AS $$\nBEGIN\n    UPDATE public.accounts\n    SET health_score = GREATEST(0, health_score - 5)\n    WHERE id = NEW.account_id\n    AND NEW.status IN ('failed', 'paused');\n    \n    UPDATE public.accounts\n    SET health_score = LEAST(100, health_score + 2)\n    WHERE id = NEW.account_id\n    AND NEW.status = 'completed';\n    \n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER queue_items_health_trigger\nAFTER UPDATE OF status ON public.queue_items\nFOR EACH ROW EXECUTE FUNCTION public.update_account_health();\n\n-- 7. FULL SEED DATA DUMP (ALL 13 TABLES)\n\n-- 7.1 Tone Presets\nINSERT INTO public.tone_presets (id, name, badge, description, emoji, prompt_template, sample_phrases) VALUES\n('tone-luxury', 'Lüks & Prestijli', 'High-End', 'Seçkin, rafine ve değer odaklı dil. Ayrıcalıklı yaşam tarzı vurgusu.', '👑', 'Ultra lüks, prestijli, zarif, yüksek alım gücüne hitap eden sofistike bir dil kullan.', '{\"Boğazın en nadide silüetinde kusursuz bir yaşam mimarisi.\",\"Sıradanlığın ötesinde, yalnızca seçkin zevkler için tasarlandı.\"}'),\n('tone-warm', 'Sıcak & Samimi', 'Gastronomi / Yaşam', 'Kucaklayıcı, iştah kabartan ve hikaye anlatan samimi bir ton.', '🍷', 'Samimi, sıcacık, lezzet ve deneyim hissini derin hissettiren iştah açıcı bir üslup.', '{\"Odun ateşinden yeni çıkan taze ekmeğin kokusuyla güne merhaba.\",\"Dostlarla paylaşılan uzun akşam sofralarının büyüsü.\"}'),\n('tone-viral', 'Mizahi & Enerjik', 'Trend / Gen-Z', 'Yüksek tempolu, güncel trendleri ve kancaları kullanan dinamik dil.', '⚡', 'Enerjik, kısa ve vurucu cümleler, merak uyandıran güçlü kancalar ve modern sokak stili.', '{\"Bunu giymeden dışarı çıkarsan dikkat çekmeme şansın yok ⚡\",\"Kaydetmeyi unutma: Sezonun en çok aranan silüeti geldi!\"}'),\n('tone-corporate', 'Kurumsal & Otoriter', 'B2B / Finans', 'Veriye dayalı, güven veren, net ve profesyonel iş dili.', '💼', 'Profesyonel, güven veren, analitik ve kurumsal ciddiyeti yansıtan üslup.', '{\"Gayrimenkul yatırımlarında doğru zamanlama ile maksimum getiri.\",\"Stratejik portföy yönetimi ile geleceğinizi güvenceye alın.\"}'),\n('tone-minimal', 'Minimalist & Sanatsal', 'Mimarlık / Sanat', 'Az kelimeyle derin anlam, estetik ve mimari vizyon.', '📐', 'Minimalist, şiirsel, tasarım felsefesini ve boşluğun gücünü öne çıkaran incelikli ton.', '{\"Işık ve gölgenin saf geometrideki kusursuz dansı.\",\"Daha az ayrıntı, daha çok karakter.\"}')\nON CONFLICT (id) DO NOTHING;\n\n-- 7.2 Brand Folders\nINSERT INTO public.brand_folders (id, name, client_name, description, color, icon, tone_preset_id) VALUES\n('b1000000-0000-0000-000