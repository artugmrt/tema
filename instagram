import React, { useState } from 'react';
import { Post, PostStatus } from '../../types';
import { PostCard } from './PostCard';
import { Plus } from '@animated-color-icons/lucide-react';
import { useNavigation } from '../../context/NavigationContext';
import { useApp } from '../../context/AppContext';
import { Tooltip } from '../common/Tooltip';

interface KanbanViewProps {
  posts: Post[];
}

export const KanbanView: React.FC<KanbanViewProps> = ({ posts }) => {
  const { openCreatePost } = useNavigation();
  const { movePostToStatus } = useApp();
  const [dragOverColId, setDragOverColId] = useState<PostStatus | null>(null);

  const columns: Array<{ id: PostStatus; label: string; color: string; count: number; tooltip: string }> = [
    { id: 'draft', label: '1. Taslaklar', color: 'border-void-600 text-void-300', count: posts.filter(p => p.status === 'draft').length, tooltip: "Fikir aşamasındaki veya henüz tamamlanmamış içerikleriniz. Sürükleyip bırakarak diğer aşamalara taşıyabilirsiniz." },
    { id: 'in_review', label: '2. Onay Bekliyor', color: 'border-amber-500/50 text-amber-300', count: posts.filter(p => p.status === 'in_review').length, tooltip: "Müşteriye veya yöneticiye sunulmuş içerikler. Onaylandığında otomatik olarak 'Onaylandı' sütununa geçer." },
    { id: 'approved', label: '3. Onaylandı', color: 'border-teal-500/50 text-teal-300', count: posts.filter(p => p.status === 'approved').length, tooltip: "Paylaşılmaya hazır içerikler. Planlama yapıldığında yayın kuyruğuna aktarılmaya hazırdır." },
    { id: 'scheduled', label: '4. Planlandı', color: 'border-gold-400/50 text-gold-300', count: posts.filter(p => p.status === 'scheduled').length, tooltip: "Tarihi ve saati belirlenmiş içerikler. Zamanı geldiğinde İnsan Mimicry Motoru (AI) tarafından paylaşılır." },
    { id: 'published', label: '5. Yayınlandı', color: 'border-emerald-500/50 text-emerald-300', count: posts.filter(p => p.status === 'published').length, tooltip: "Instagram'da başarıyla yayınlanmış içerikler. İstatistiklerini Analytics sekmesinden görebilirsiniz." },
  ];

  const handleDrop = (e: React.DragEvent, targetStatus: PostStatus) => {
    e.preventDefault();
    setDragOverColId(null);
    const postId = e.dataTransfer.getData('text/plain');
    if (!postId) return;
    movePostToStatus(postId, targetStatus);
  };

  return (
    <div className="grid grid-cols-5 gap-4 flex-1 overflow-x-auto min-w-[1000px] pb-4">
      {columns.map(col => {
        const colPosts = posts.filter(p => p.status === col.id);
        const isDragOver = dragOverColId === col.id;

        return (
          <div
            key={col.id}
            onDragOver={(e) => {
              e.preventDefault();
              setDragOverColId(col.id);
            }}
            onDragLeave={() => setDragOverColId(null)}
            onDrop={(e) => handleDrop(e, col.id)}
            className={`bg-void-900 border rounded-2xl p-3.5 flex flex-col justify-between transition-all duration-200 ${
              isDragOver
                ? 'border-gold-400 bg-void-850 shadow-gold-glow scale-[1.01]'
                : 'border-void-750/80'
            }`}
          >
            <div>
              {/* Column Header */}
              <div className="flex items-center justify-between pb-3 border-b border-void-750 mb-3">
                <span className={`text-xs font-bold font-unbounded flex items-center gap-1.5 ${col.color}`}>
                  {col.label}
                  <Tooltip content={col.tooltip} />
                </span>
                <span className="px-2 py-0.5 rounded-full bg-void-800 text-void-300 font-mono text-xs font-semibold border border-void-700">
                  {col.count}
                </span>
              </div>

              {/* Cards list */}
              <div className="space-y-3 max-h-[calc(100vh-280px)] overflow-y-auto pr-1">
                {colPosts.map(post => (
                  <PostCard key={post.id} post={post} />
                ))}

                {colPosts.length === 0 && (
                  <div className="p-4 rounded-xl border border-dashed border-void-750 text-center text-void-500 text-xs">
                    Bu aşamada içerik yok (kart sürükleyin)
                  </div>
                )}
              </div>
            </div>

            {/* Quick Add at bottom of Draft column */}
            {col.id === 'draft' && (
              <button
                onClick={() => openCreatePost('feed')}
                className="w-full mt-3 py-2 rounded-xl bg-void-850 hover:bg-gold-400/15 border border-void-700/80 hover:border-gold-400/40 text-void-300 hover:text-gold-300 text-xs font-medium flex items-center justify-center gap-1.5 transition-all cursor-pointer"
              >
                <Plus className="w-3.5 h-3.5" />
                Yeni Taslak Ekle
              </button>
            )}
          </div>
        );
      })}
    </div>
  );
};


