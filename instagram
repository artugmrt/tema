          </span>
          <span className="flex items-center gap-1.5">
            <span className="w-2.5 h-2.5 rounded bg-gold-400 border border-gold-300 shadow-gold-glow"></span> ★ Optimum (Altın Saat)
          </span>
        </div>
      </div>

      {/* Heatmap Grid */}
      <div className="grid grid-cols-8 gap-1.5 text-center">
        <div className="text-[10px] font-mono text-void-500 font-semibold py-1">Saat / Gün</div>
        {days.map((d, i) => (
          <div key={i} className="text-[10px] font-mono text-void-400 font-semibold py-1">
            {d}
          </div>
        ))}

        {hours.map(h => (
          <React.Fragment key={h}>
            <div className="text-[10px] font-mono text-void-500 flex items-center justify-center font-medium">
              {h}:00
            </div>
            {days.map((_, dayIdx) => {
              const score = getIntensity(dayIdx, h);
              const isGold = score >= 90;
              const isTeal = score >= 70 && score < 90;

              return (
                <button
                  key={dayIdx}
                  onClick={() => openCreatePost('feed')}
                  title={`Etkileşim Skoru: %${score} — Tıklayarak bu saate içerik planlayın`}
                  className={`h-7 rounded-lg text-[10px] font-mono font-bold transition-all cursor-pointer flex items-center justify-center ${
                    isGold
                      ? 'bg-gold-400 text-void-950 shadow-gold-glow hover:scale-105'
                      : isTeal
                      ? 'bg-teal-500/30 text-teal-200 border border-teal-500/40 hover:bg-teal-500/50'
                      : 'bg-void-850 hover:bg-void-800 text-void-500 border border-void-800'
                  }`}
                >
                  {isGold ? `★ %${score}` : `%${score}`}
                </button>
              );
            })}
          </React.Fragment>
        ))}
      </div>
    </div>
  );
};


