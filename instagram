import { Account, Post } from '../types';

export const CalendarSyncService = {
  /**
   * Converts ISO date string to iCalendar UTC format (YYYYMMDDTHHmmssZ)
   */
  formatDateToIcs(dateIso: string): string {
    const d = new Date(dateIso);
    return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
  },

  /**
   * Formats end date (+30 minutes) for calendar slot duration
   */
  formatEndDateToIcs(dateIso: string): string {
    const d = new Date(dateIso);
    d.setMinutes(d.getMinutes() + 30);
    return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
  },

  /**
   * Generates standard RFC 5545 iCalendar (.ics) string for an account's schedule
   */
  generateIcsContent(account: Account, posts: Post[]): string {
    const relevantPosts = posts.filter(
      p => p.accountId === account.id && ['scheduled', 'approved', 'in_review', 'published'].includes(p.status)
    );

    const nowIcs = this.formatDateToIcs(new Date().toISOString());

    const events = relevantPosts.map(p => {
      const dtStart = this.formatDateToIcs(p.scheduledAt);
      const dtEnd = this.formatEndDateToIcs(p.scheduledAt);
      const cleanCaption = (p.caption || 'Sosyal Medya Gönderisi')
        .replace(/\n/g, ' \\n ')
        .replace(/,/g, '\\,')
        .slice(0, 100);

      const statusTag = p.status === 'approved' ? '✅ ONAYLANDI' 
                      : p.status === 'scheduled' ? '📅 PLANLANDI' 
                      : p.status === 'published' ? '🚀 YAYINLANDI' 
                      : '⏳ ONAY BEKLİYOR';

      const description = `[${statusTag}]\\n` +
        `Format: ${p.type.toUpperCase()}\\n` +
        `Slot Skoru: %${p.bestTimeScore || 90}\\n` +
        `Etiketler: ${(p.hashtags || []).join(' ')}\\n\\n` +
        `Metin:\\n${cleanCaption}`;

      return [
        'BEGIN:VEVENT',
        `UID:post-${p.id}@instaplanner.io`,
        `DTSTAMP:${nowIcs}`,
        `DTSTART:${dtStart}`,
        `DTEND:${dtEnd}`,
        `SUMMARY:[IG: ${p.type.toUpperCase()}] @${account.username} - ${cleanCaption.slice(0, 45)}`,
        `DESCRIPTION:${description}`,
        `LOCATION:Instagram (@${account.username})`,
        'STATUS:CONFIRMED',
        'TRANSP:OPAQUE',
        'END:VEVENT'
      ].join('\r\n');
    }).join('\r\n');

    return [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//InstaPlanner AGENTIC//Instagram Social Planner//TR',
      'CALSCALE:GREGORIAN',
      'METHOD:PUBLISH',
      `X-WR-CALNAME:InstaPlanner: ${account.displayName} (@${account.username})`,
      'X-WR-TIMEZONE:Europe/Istanbul',
      events,
      'END:VCALENDAR'
    ].join('\r\n');
  },

  /**
   * Triggers download of the .ics file
   */
  downloadIcsFile(account: Account, posts: Post[]): void {
    const icsContent = this.generateIcsContent(account, posts);
    const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${account.username}_instagram_takvim_${new Date().toISOString().split('T')[0]}.ics`;
    link.click();
    URL.revokeObjectURL(url);
  },

  /**
   * Generates a 1-click Google Calendar add event URL for a single post
   */
  getGoogleCalendarUrlForPost(account: Account, post: Post): string {
    const start = this.formatDateToIcs(post.scheduledAt);
    const end = this.formatEndDateToIcs(post.scheduledAt);
    const title = `[IG ${post.type.toUpperCase()}] @${account.username}: ${post.caption.slice(0, 30)}...`;
    const details = `İçerik Metni: ${post.caption}\n\nFormat: ${post.type}\nSlot Başarı Skoru: %${post.bestTimeScore || 90}\nDurum: ${post.status}\nHashtagler: ${(post.hashtags || []).join(' ')}`;
    const location = `Instagram (@${account.username})`;

    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(title)}&dates=${start}/${end}&details=${encodeURIComponent(details)}&location=${encodeURIComponent(location)}`;
  },

  /**
   * Generates a copyable Data URI for live subscription
   */
  getSubscriptionDataUri(account: Account, posts: Post[]): string {
    const ics = this.generateIcsContent(account, posts);
    return `data:text/calendar;charset=utf8,${encodeURIComponent(ics)}`;
  }
};


