        return `<b>🚨 ACİL DURUM: KILL SWITCH AKTİF!</b>\n\n` +
               `Tüm otomatik yayınlar, fare simülasyonları ve API istekleri derhal durduruldu. Sistem donduruldu.`;

      case 'CRISIS_COMMENT_ALERT':
        return `<b>🚨 KRİZ ALARMI: NEGATİF YORUM TESPİT EDİLDİ</b>\n\n` +
               `<b>Marka:</b> ${acc?.displayName || 'Marka'} (@${acc?.username || 'hesap'})\n` +
               `<b>Kullanıcı:</b> @${payload.commentAuthor || 'anonim'}\n` +
               `<b>Yorum:</b> <i>"${payload.commentText || ''}"</i>\n\n` +
               `⚠️ <b>AI Aksiyon Önerisi:</b> Marka itibarını korumak için kullanıcıyı DM'e yönlendirin.`;

      case 'VIP_LEAD_ALERT':
        return `<b>🔥 SICAK SATIŞ ADAYI (VIP LEAD)</b>\n\n` +
               `<b>Marka:</b> ${acc?.displayName || 'Marka'} (@${acc?.username || 'hesap'})\n` +
               `<b>Müşteri Adayı:</b> @${payload.commentAuthor || 'anonim'}\n` +
               `<b>Mesaj:</b> <i>"${payload.commentText || ''}"</i>\n\n` +
               `💼 <b>AI Tavsiyesi:</b> Özel fiyat teklifi veya randevu linkini DM ile iletin.`;

      default:
        return `<b>📢 InstaPlanner Bildirimi:</b>\n${payload.customMessage || ''}`;
    }
  },

  /**
   * Formats Slack Block Kit JSON
   */
  formatSlackBlocks(payload: NotificationPayload): any {
    const text = this.formatTextMessage(payload);
    return {
      text,
      blocks: [
        {
          type: 'header',
          text: {
            type: 'plain_text',
            text: 'InstaPlanner AGENTIC Bildirimi',
            emoji: true
          }
        },
        {
          type: 'section',
          text: {
            type: 'mrkdwn',
            text: `*${text}*\n_Tarih: ${new Date().toLocaleString('tr-TR')}_`
          }
        }
      ]
    };
  },

  /**
   * Tests Telegram connection by sending a ping message
   */
  async testTelegramConnection(botToken: string, chatId: string): Promise<{ success: boolean; latencyMs: number; message: string }> {
    const startTime = Date.now();
    if (!botToken || !chatId) {
      return { success: false, latencyMs: 0, message: 'Lütfen geçerli bir Telegram Bot Token ve Chat ID girin.' };
    }

    try {
      const url = `https://api.telegram.org/bot${botToken}/sendMessage`;
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          chat_id: chatId,
          text: `🤖 <b>InstaPlanner AGENTIC v4.0.2</b>\nTelegram Bot Entegrasyonu Başarıyla Kuruldu!\n\n<i>Zaman: ${new Date().toLocaleString('tr-TR')}</i>`,
          parse_mode: 'HTML'
        })
      });

      const data = await res.json();
      const latencyMs = Date.now() - startTime;

      if (data.ok) {
        return { success: true, latencyMs, message: 'Telegram test mesajı başarıyla iletildi!' };
      } else {
        return { success: false, latencyMs, message: `Telegram Hatası: ${data.description || 'Bilinmeyen hata'}` };
      }
    } catch (err: any) {
      return { success: false, latencyMs: Date.now() - startTime, message: `Bağlantı hatası: ${err.message}` };
    }
  },

  /**
   * Sends telegram message directly
   */
  async sendTelegramMessage(botToken: string, chatId: string, textHtml: string): Promise<boolean> {
    try {
      const url = `https://api.telegram.org/bot${botToken}/sendMessage`;
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          chat_id: chatId,
          text: textHtml,
          parse_mode: 'HTML'
        })
      });
      const data = await res.json();
      return Boolean(data.ok);
    } catch {
      return false;
    }
  },

  /**
   * Tests Slack Webhook connection
   */
  async testSlackConnection(webhookUrl: string): Promise<{ success: boolean; latencyMs: number; message: string }> {
    const startTime = Date.now();
    if (!webhookUrl || !webhookUrl.startsWith('http')) {
      return { success: false, latencyMs: 0, message: 'Lütfen geçerli bir Slack Incoming Webhook URL girin.' };
    }

    try {
      const res = await fetch(webhookUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          text: `🔔 *InstaPlanner AGENTIC v4.0.2* Slack Webhook bağlantısı aktif!`
        }),
        mode: 'no-cors' // Slack incoming webhooks often require no-cors in browser
      });

      const latencyMs = Date.now() - startTime;
      return { success: true, latencyMs, message: 'Slack test sinyali gönderildi!' };
    } catch (err: any) {
      return { success: false, latencyMs: Date.now() - startTime, message: `Slack Hatası: ${err.message}` };
    }
  },

  /**
   * Sends slack webhook payload
   */
  async sendSlackWebhook(webhookUrl: string, payload: any): Promise<boolean> {
    try {
      await fetch(webhookUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        mode: 'no-cors'
      });
      return true;
    } catch {
      return false;
    }
  }
};


