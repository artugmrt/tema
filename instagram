import React, { createContext, useContext, useState, ReactNode } from 'react';
import { NavigationTab, ViewMode, PostType } from '../types';

interface NavigationContextType {
  activeTab: NavigationTab;
  setActiveTab: (tab: NavigationTab) => void;
  viewMode: ViewMode;
  setViewMode: (mode: ViewMode) => void;

  // Post Editor Modal
  isPostModalOpen: boolean;
  editingPostId: string | null;
  defaultPostType: PostType;
  openCreatePost: (type?: PostType) => void;
  openEditPost: (postId: string) => void;
  closePostModal: () => void;

  // Other Modals
  isAddAccountOpen: boolean;
  setIsAddAccountOpen: React.Dispatch<React.SetStateAction<boolean>>;
  isBulkUploadOpen: boolean;
  setIsBulkUploadOpen: React.Dispatch<React.SetStateAction<boolean>>;
  isReportModalOpen: boolean;
  setIsReportModalOpen: React.Dispatch<React.SetStateAction<boolean>>;
  isConstitutionModalOpen: boolean;
  setIsConstitutionModalOpen: React.Dispatch<React.SetStateAction<boolean>>;
  isNotificationOpen: boolean;
  setIsNotificationOpen: React.Dispatch<React.SetStateAction<boolean>>;
  isCommandPaletteOpen: boolean;
  setIsCommandPaletteOpen: React.Dispatch<React.SetStateAction<boolean>>;

  // Magic Link Share Modal
  isShareModalOpen: boolean;
  setIsShareModalOpen: React.Dispatch<React.SetStateAction<boolean>>;
  shareAccountId?: string;
  openShareModal: (accountId?: string) => void;
  closeShareModal: () => void;
}

const NavigationContext = createContext<NavigationContextType | undefined>(undefined);

export const NavigationProvider: React.FC<{ children: ReactNode }> = ({ children }) => {
  const [viewMode, setViewMode] = useState<ViewMode>(() => {
    const params = new URLSearchParams(window.location.search);
    const v = params.get('view');
    if (v === 'popup' || v === 'sidepanel' || v === 'dashboard') {
      return v;
    }
    return 'dashboard';
  });

  const [activeTab, setActiveTab] = useState<NavigationTab>(() => {
    const params = new URLSearchParams(window.location.search);
    if (params.has('reviewToken') || params.get('tab') === 'portal') {
      return 'portal';
    }
    return 'dashboard';
  });

  // Modals
  const [isPostModalOpen, setIsPostModalOpen] = useState<boolean>(false);
  const [editingPostId, setEditingPostId] = useState<string | null>(null);
  const [defaultPostType, setDefaultPostType] = useState<PostType>('feed');

  const [isAddAccountOpen, setIsAddAccountOpen] = useState<boolean>(false);
  const [isBulkUploadOpen, setIsBulkUploadOpen] = useState<boolean>(false);
  const [isReportModalOpen, setIsReportModalOpen] = useState<boolean>(false);
  const [isConstitutionModalOpen, setIsConstitutionModalOpen] = useState<boolean>(false);
  const [isNotificationOpen, setIsNotificationOpen] = useState<boolean>(false);
  const [isCommandPaletteOpen, setIsCommandPaletteOpen] = useState<boolean>(false);

  // Magic Link Share Modal
  const [isShareModalOpen, setIsShareModalOpen] = useState<boolean>(false);
  const [shareAccountId, setShareAccountId] = useState<string | undefined>(undefined);

  const openCreatePost = (type: PostType = 'feed') => {
    setEditingPostId(null);
    setDefaultPostType(type);
    setIsPostModalOpen(true);
  };

  const openEditPost = (postId: string) => {
    setEditingPostId(postId);
    setIsPostModalOpen(true);
  };

  const closePostModal = () => {
    setIsPostModalOpen(false);
    setEditingPostId(null);
  };

  const openShareModal = (accountId?: string) => {
    setShareAccountId(accountId);
    setIsShareModalOpen(true);
  };

  const closeShareModal = () => {
    setIsShareModalOpen(false);
    setShareAccountId(undefined);
  };

  return (
    <NavigationContext.Provider
      value={{
        activeTab,
        setActiveTab,
        viewMode,
        setViewMode,
        isPostModalOpen,
        editingPostId,
        defaultPostType,
        openCreatePost,
        openEditPost,
        closePostModal,
        isAddAccountOpen,
        setIsAddAccountOpen,
        isBulkUploadOpen,
        setIsBulkUploadOpen,
        isReportModalOpen,
        setIsReportModalOpen,
        isConstitutionModalOpen,
        setIsConstitutionModalOpen,
        isNotificationOpen,
        setIsNotificationOpen,
        isCommandPaletteOpen,
        setIsCommandPaletteOpen,
        isShareModalOpen,
        setIsShareModalOpen,
        shareAccountId,
        openShareModal,
        closeShareModal
      }}
    >
      {children}
    </NavigationContext.Provider>
  );
};

export const useNavigation = (): NavigationContextType => {
  const context = useContext(NavigationContext);
  if (!context) {
    throw new Error('useNavigation must be used within a NavigationProvider');
  }
  return context;
};


