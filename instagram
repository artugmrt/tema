                              title={isLockedAdmin ? 'Yönetici kök izni kapatılamaz' : `${ROLE_LABELS[r].title}: ${isGranted ? 'Yetkiyi Kaldır' : 'Yetki Ver'}`}
                            >
                              {isGranted ? (
                                <Check className="w-4 h-4 text-emerald-400" />
                              ) : (
                                <X className="w-4 h-4 text-void-600" />
                              )}
                            </button>
                          </td>
                        );
                      })}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <div className="p-3.5 rounded-2xl bg-void-950 border border-void-800 flex items-start gap-3 text-xs text-void-300">
            <Info className="w-4 h-4 text-teal-400 shrink-0 mt-0.5" />
            <p className="text-[11px] leading-relaxed">
              💡 <strong>İpucu:</strong> Üst menüdeki (TopHeader) <em>Kullanıcı Simülasyonu</em> menüsünden <strong>Selin K. (Üretici)</strong> veya <strong>Kemal B. (Müşteri)</strong> profiline geçiş yaparak yukarıda belirlediğiniz kısıtlamaların arayüzde nasıl davrandığını canlı olarak deneyimleyebilirsiniz.
            </p>
          </div>
        </div>

        {/* Footer */}
        <div className="px-6 py-4 border-t border-void-750 bg-void-950 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
